// The icon in the system tray. Separate from the window: it stays while the window is closed
// and doesn't change with the widget style, so it is compiled once.

export component Tray inherits SystemTrayIcon {
    in property <int> unread;
    // The "Keep running in the tray" setting.
    in property <bool> shown: true;
    // The icon with a dot for unread messages, drawn by Rust: a tray icon is pixels, not items.
    in property <image> unread-icon;

    callback open();
    callback quit();

    icon: root.unread > 0 && root.unread-icon.width > 0 ? root.unread-icon : @image-url("../assets/langis.svg");
    title: "langis";
    visible: root.shown;
    tooltip: unread == 0 ? "langis" : unread == 1 ? "langis — 1 unread message" : "langis — \{unread} unread messages";
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open langis";
            activated => { root.open(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
