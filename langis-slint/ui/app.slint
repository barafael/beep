import { Button, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, Spinner, Switch, TextEdit } from "std-widgets.slint";

export struct ConversationItem {
    id: string,
    title: string,
    initials: string,
    avatar-color: color,
    // Profile or group picture; empty (zero width) if there is none.
    avatar: image,
    preview: string,
    // When the newest message came: "14:05", "Mon", "Oct 2".
    time: string,
    // Under the title in the chat header: a phone number, "4 members", …
    subtitle: string,
    unread: int,
    pinned: bool,
    // Among the pinned ones.
    can-move-up: bool,
    can-move-down: bool,
    muted: bool,
    // Marked unread by hand: a dot, no count.
    marked-unread: bool,
    archived: bool,
    // "Ann is typing…", shown instead of the preview; empty otherwise.
    typing: string,
    // Disappearing messages: seconds, 0 for off; and as said, e.g. "1 hour".
    timer: int,
    timer-label: string,
}

export struct AttachmentItem {
    id: string,
    // Shown as a picture (photos, stickers); otherwise as a row with a label.
    inline: bool,
    // Not shown at all; fetched for its content (the full text of a long message).
    hidden: bool,
    // Ask the backend for it once it is shown.
    fetch: bool,
    // Empty (zero width) until downloaded.
    picture: image,
    // The picture's size in the bubble, known before it is downloaded.
    width: length,
    height: length,
    // E.g. "📎 route-notes.pdf · 240 KB".
    label: string,
    // "Saved to Downloads", an error, or empty.
    status: string,
    // The download failed; clicking the picture's place asks again.
    can-retry: bool,
    can-save: bool,
}

export struct ReactionItem {
    emoji: string,
    count: int,
    // One of them is ours; clicking takes it back.
    mine: bool,
}

export struct MessageItem {
    sender: string,
    // With links made clickable.
    body: styled-text,
    has-body: bool,
    time: string,
    outgoing: bool,
    // Show the sender above the bubble (groups, first of a run).
    show-sender: bool,
    // "Today", "Monday", "Oct 2" on the first message of a day; empty otherwise.
    day: string,
    // Messages by the same person within a few minutes are drawn as a run.
    first: bool,
    last: bool,
    // Incoming group messages leave room for the sender's avatar, shown at the end of a run.
    avatar-column: bool,
    sender-avatar: image,
    sender-initials: string,
    sender-color: color,
    // The message this one replies to; both empty if it isn't a reply.
    quote-author: string,
    quote-text: string,
    attachments: [AttachmentItem],
    reactions: [ReactionItem],
    // Plain text, for copying.
    text: string,
    // Ours: 1 sent, 2 delivered, 3 read; 0 for others' messages.
    delivery: int,
    edited: bool,
    deleted: bool,
    // Time left until it disappears, e.g. "5m"; empty if it doesn't.
    expires: string,
    // Ours and recent enough to edit or delete for everyone.
    can-edit: bool,
    // The first message that came after the chat was last read.
    first-unread: bool,
    can-forward: bool,
    // The search result last shown.
    highlighted: bool,
}

// A row of the media overview's grid.
export struct MediaRow {
    tiles: [AttachmentItem],
}

// A file or link in the media overview, with who sent it when.
export struct SharedItem {
    attachment: AttachmentItem,
    // For links.
    url: string,
    sender: string,
    when: string,
}

// A message found by searching a chat.
export struct SearchResult {
    sender: string,
    // When it was sent, e.g. "Oct 2, 14:05".
    when: string,
    // The text around the match.
    text: string,
}

export enum Screen { connecting, password, link, chats }

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    // Shown instead of the initials when set.
    in property <image> picture;
    width: 40px;
    height: self.width;
    border-radius: self.width / 2;
    clip: true;
    background: tint;
    if root.picture.width == 0: Text {
        text: initials;
        color: white;
        font-size: root.width * 0.4;
        font-weight: 600;
    }
    if root.picture.width > 0: Image {
        width: root.width;
        height: root.height;
        source: root.picture;
        image-fit: cover;
    }
}

// What can be done with a conversation, in its context menu and the chat header's menu.
component ConversationMenu inherits ContextMenuArea {
    in property <ConversationItem> item;
    // With the disappearing-messages timer (the chat header's menu).
    in property <bool> with-timer;
    callback toggle-pin;
    // Among the pinned chats: -1 up, 1 down.
    callback move-pin(int);
    callback mark-read(bool);
    // For this many seconds; -1 for good, 0 to unmute.
    callback mute(int);
    callback archive(bool);
    callback set-timer(int);
    // With `with-timer`: the chat's media, files and links.
    callback show-media;
    property <bool> unread: root.item.unread > 0 || root.item.marked-unread;
    Menu {
        MenuItem {
            title: root.item.pinned ? "Unpin" : "Pin";
            activated => { root.toggle-pin(); }
        }
        if root.item.can-move-up: MenuItem {
            title: "Move up";
            activated => { root.move-pin(-1); }
        }
        if root.item.can-move-down: MenuItem {
            title: "Move down";
            activated => { root.move-pin(1); }
        }
        MenuItem {
            title: root.unread ? "Mark as read" : "Mark as unread";
            activated => { root.mark-read(root.unread); }
        }
        if root.item.muted: MenuItem {
            title: "Unmute";
            activated => { root.mute(0); }
        }
        if !root.item.muted: Menu {
            title: "Mute";
            MenuItem { title: "For 1 hour"; activated => { root.mute(3600); } }
            MenuItem { title: "For 8 hours"; activated => { root.mute(28800); } }
            MenuItem { title: "For 1 week"; activated => { root.mute(604800); } }
            MenuItem { title: "Always"; activated => { root.mute(-1); } }
        }
        if root.with-timer: MenuItem {
            title: "Media, files and links";
            activated => { root.show-media(); }
        }
        if root.with-timer: Menu {
            title: "Disappearing messages";
            for choice in [
                { label: "Off", seconds: 0 },
                { label: "30 seconds", seconds: 30 },
                { label: "5 minutes", seconds: 300 },
                { label: "1 hour", seconds: 3600 },
                { label: "8 hours", seconds: 28800 },
                { label: "1 day", seconds: 86400 },
                { label: "1 week", seconds: 604800 },
                { label: "4 weeks", seconds: 2419200 },
            ]: MenuItem {
                title: (choice.seconds == root.item.timer ? "✓ " : "") + choice.label;
                activated => { root.set-timer(choice.seconds); }
            }
        }
        MenuSeparator {}
        MenuItem {
            title: root.item.archived ? "Unarchive" : "Archive";
            activated => { root.archive(!root.item.archived); }
        }
    }
}

component ConversationRow inherits Rectangle {
    in property <ConversationItem> item;
    in property <bool> selected;
    callback clicked;
    // See `ConversationMenu`.
    callback toggle-pin;
    callback move-pin(int);
    callback mark-read(bool);
    callback mute(int);
    callback archive(bool);

    height: 64px;
    border-radius: 6px;
    background: selected ? Palette.accent-background.with-alpha(0.18)
        : touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Avatar {
            initials: item.initials;
            tint: item.avatar-color;
            picture: item.avatar;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.title;
                    font-weight: item.unread > 0 ? 700 : 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: Palette.foreground;
                }
                if item.muted: Text {
                    text: "🔕";
                    font-size: 0.75rem;
                    vertical-alignment: center;
                    opacity: 0.6;
                }
                if item.pinned: Text {
                    text: "📌";
                    font-size: 0.75rem;
                    vertical-alignment: center;
                    opacity: 0.7;
                }
                Text {
                    text: item.time;
                    font-size: 0.75rem;
                    vertical-alignment: center;
                    color: item.unread > 0 ? Palette.accent-background : Palette.foreground.with-alpha(0.55);
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.typing != "" ? item.typing : item.preview;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: item.typing != "" ? Palette.accent-background : Palette.foreground.with-alpha(0.65);
                    font-size: 0.9rem;
                }
                if item.unread == 0 && item.marked-unread: Rectangle {
                    width: 10px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: Palette.accent-background;
                }
                if item.unread > 0: Rectangle {
                    width: max(18px, badge.preferred-width + 10px);
                    height: 18px;
                    border-radius: 9px;
                    // Muted chats count quietly.
                    background: item.muted ? Palette.foreground.with-alpha(0.35) : Palette.accent-background;
                    badge := Text {
                        text: item.unread;
                        // White on the accent, whatever the style's accent text colour is.
                        color: white;
                        font-size: 0.75rem;
                        font-weight: 700;
                    }
                }
            }
        }
    }
    // On top: it takes only right clicks, so left clicks still reach the row.
    ConversationMenu {
        item: root.item;
        toggle-pin => { root.toggle-pin(); }
        move-pin(by) => { root.move-pin(by); }
        mark-read(read) => { root.mark-read(read); }
        mute(seconds) => { root.mute(seconds); }
        archive(archived) => { root.archive(archived); }
    }
}

component AttachmentView inherits VerticalLayout {
    in property <AttachmentItem> item;
    in property <bool> outgoing;
    callback fetch(string);
    callback save(string);
    callback open(string);

    // Outgoing bubbles use the accent colour, so their text is white for contrast with any.
    property <color> ink: outgoing ? white : Palette.alternate-foreground;
    spacing: 4px;
    // The list only creates rows that are on screen, so this downloads only what is seen.
    init => {
        if root.item.fetch { root.fetch(root.item.id); }
    }

    if root.item.inline: Rectangle {
        width: root.item.width;
        height: root.item.height;
        border-radius: 8px;
        clip: true;
        background: root.ink.with-alpha(0.08);
        if root.item.picture.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.item.picture;
            image-fit: contain;
        }
        // Full size in the desktop's image viewer.
        if root.item.picture.width > 0: TouchArea {
            mouse-cursor: pointer;
            clicked => { root.open(root.item.id); }
        }
        if root.item.picture.width == 0 && root.item.status == "": Spinner {
            indeterminate: true;
            width: 24px;
            height: 24px;
        }
        if root.item.picture.width == 0 && root.item.can-retry: TouchArea {
            mouse-cursor: pointer;
            clicked => { root.fetch(root.item.id); }
        }
        if root.item.picture.width == 0 && root.item.status != "": Text {
            text: root.item.status;
            wrap: word-wrap;
            width: parent.width - 16px;
            horizontal-alignment: center;
            font-size: 0.8rem;
            color: root.ink.with-alpha(0.7);
        }
    }
    if !root.item.inline || root.item.can-save: HorizontalLayout {
        spacing: 8px;
        if !root.item.inline: Text {
            text: root.item.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.ink;
        }
        if !root.item.inline && root.item.can-save: open-touch := TouchArea {
            width: open-label.preferred-width;
            mouse-cursor: pointer;
            clicked => { root.open(root.item.id); }
            open-label := Text {
                text: "Open";
                font-size: 0.85rem;
                font-weight: 600;
                vertical-alignment: center;
                color: open-touch.has-hover ? root.ink : root.ink.with-alpha(0.75);
            }
        }
        if root.item.inline || root.item.status != "": Text {
            text: root.item.inline && root.item.picture.width == 0 ? "" : root.item.status;
            vertical-alignment: center;
            font-size: 0.8rem;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.ink.with-alpha(0.7);
        }
        if root.item.can-save: save-touch := TouchArea {
            width: save-label.preferred-width;
            mouse-cursor: pointer;
            clicked => { root.save(root.item.id); }
            save-label := Text {
                text: "Save";
                font-size: 0.85rem;
                font-weight: 600;
                vertical-alignment: center;
                color: save-touch.has-hover ? root.ink : root.ink.with-alpha(0.75);
            }
        }
    }
}

component HoverButton inherits Rectangle {
    in property <bool> shown;
    in property <string> symbol;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    opacity: root.shown || touch.has-hover ? 1 : 0;
    background: touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Text {
        text: root.symbol;
        font-size: 1.1rem;
        color: Palette.foreground.with-alpha(0.6);
    }
}

// Quick reactions, as in Signal's own apps.
component ReactionPicker inherits PopupWindow {
    callback picked(string);
    Rectangle {
        border-radius: 18px;
        background: Palette.alternate-background;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0003;
        HorizontalLayout {
            padding: 4px;
            spacing: 2px;
            for emoji in ["❤️", "👍", "👎", "😂", "😮", "😢"]: Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(emoji); }
                }
                Text { text: emoji; font-size: 1.2rem; }
            }
        }
    }
}

component HoverButtons inherits HorizontalLayout {
    in property <bool> shown;
    callback react;
    callback reply;
    HoverButton {
        symbol: "☺";
        shown: root.shown;
        clicked => { root.react(); }
    }
    HoverButton {
        symbol: "↩";
        shown: root.shown;
        clicked => { root.reply(); }
    }
}

component Bubble inherits Rectangle {
    in property <MessageItem> item;
    in property <length> max-bubble-width;
    callback fetch-attachment(string);
    callback save-attachment(string);
    callback open-attachment(string);
    callback open-link(string);
    callback reply;
    callback react(string);
    callback edit;
    callback delete(bool);
    callback copy-text(string);
    callback reveal;
    callback forward;

    // Outgoing bubbles use the accent colour: white text reads on any style's accent.
    property <color> ink: item.outgoing ? white : Palette.alternate-foreground;
    // Within a run, the corners facing the neighbouring bubbles are tighter.
    property <length> round: 16px;
    property <length> tight: 5px;

    // Under the content, so buttons inside the bubble still get their clicks.
    hover := TouchArea {}

    picker := ReactionPicker {
        x: item.outgoing ? root.width - 230px : 16px;
        y: -36px;
        picked(emoji) => { root.react(emoji); }
    }

    VerticalLayout {
        if item.first-unread: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            spacing: 8px;
            Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Palette.accent-background.with-alpha(0.5); }
            new-label := Text {
                text: "New messages";
                font-size: 0.8rem;
                font-weight: 600;
                horizontal-stretch: 0;
                color: Palette.accent-background;
            }
            Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Palette.accent-background.with-alpha(0.5); }
        }
        if item.day != "": HorizontalLayout {
            alignment: center;
            padding-top: 14px;
            padding-bottom: 6px;
            Rectangle {
                width: day-label.preferred-width + 20px;
                height: 22px;
                border-radius: 11px;
                background: Palette.alternate-background;
                border-width: 1px;
                border-color: Palette.border;
                day-label := Text {
                    text: item.day;
                    font-size: 0.8rem;
                    font-weight: 600;
                    color: Palette.foreground.with-alpha(0.7);
                }
            }
        }

        HorizontalLayout {
            alignment: item.outgoing ? end : start;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: item.first ? 6px : 1px;
            padding-bottom: 1px;
            spacing: 4px;

            // The sender's picture, at the end of their run.
            if item.avatar-column: VerticalLayout {
                alignment: end;
                width: 28px;
                if item.last: Avatar {
                    width: 28px;
                    initials: item.sender-initials;
                    tint: item.sender-color;
                    picture: item.sender-avatar;
                }
            }
            // Beside the bubble on the side facing the middle, shown on hover.
            if item.outgoing: VerticalLayout {
                alignment: center;
                HoverButtons {
                    visible: !item.deleted;
                    shown: hover.has-hover;
                    react => { picker.show(); }
                    reply => { root.reply(); }
                }
            }
            VerticalLayout {
                spacing: 2px;
                if item.show-sender: Text {
                    text: item.sender;
                    font-size: 0.8rem;
                    font-weight: 600;
                    color: item.sender-color;
                }
                Rectangle {
                    max-width: root.max-bubble-width;
                    border-top-left-radius: !item.outgoing && !item.first ? root.tight : root.round;
                    border-bottom-left-radius: !item.outgoing && !item.last ? root.tight : root.round;
                    border-top-right-radius: item.outgoing && !item.first ? root.tight : root.round;
                    border-bottom-right-radius: item.outgoing && !item.last ? root.tight : root.round;
                    // Darkened, so white text reads even on a light accent (Breeze's dark scheme).
                    background: item.outgoing ? Palette.accent-background.darker(0.35) : Palette.alternate-background;
                    border-width: item.highlighted ? 2px : item.outgoing ? 0 : 1px;
                    border-color: item.highlighted ? Palette.accent-background.brighter(0.4) : Palette.border;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 7px;
                        padding-bottom: 6px;
                        spacing: 2px;
                        if item.quote-author != "" || item.quote-text != "": Rectangle {
                            border-radius: 6px;
                            background: root.ink.with-alpha(0.12);
                            HorizontalLayout {
                                Rectangle {
                                    width: 3px;
                                    border-radius: 1.5px;
                                    background: item.outgoing ? white : Palette.accent-background;
                                }
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 1px;
                                    Text {
                                        text: item.quote-author;
                                        font-size: 0.8rem;
                                        font-weight: 600;
                                        color: root.ink;
                                    }
                                    Text {
                                        text: item.quote-text;
                                        font-size: 0.85rem;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        max-height: 2.6rem;
                                        color: root.ink.with-alpha(0.8);
                                    }
                                }
                            }
                        }
                        for attachment in item.attachments: AttachmentView {
                            // A long message's full text replaces the body; it isn't shown itself.
                            visible: !attachment.hidden;
                            height: attachment.hidden ? 0 : self.preferred-height;
                            item: attachment;
                            outgoing: item.outgoing;
                            fetch(id) => { root.fetch-attachment(id); }
                            save(id) => { root.save-attachment(id); }
                            open(id) => { root.open-attachment(id); }
                        }
                        if item.has-body: StyledText {
                            text: item.body;
                            // For screen readers (and finding messages in the UI tests).
                            accessible-role: text;
                            accessible-label: item.deleted ? "This message was deleted." : item.text;
                            default-color: item.deleted ? root.ink.with-alpha(0.6) : root.ink;
                            link-color: item.outgoing ? white : Palette.accent-background;
                            // Spoilers are links that reveal them.
                            link-clicked(link) => {
                                if link == "spoiler:" {
                                    root.reveal();
                                } else {
                                    root.open-link(link);
                                }
                            }
                        }
                        // Once per run, on its last message; always if it changed or goes away.
                        if item.last || item.edited || item.expires != "": HorizontalLayout {
                            alignment: end;
                            spacing: 4px;
                            property <color> faint: root.ink.with-alpha(0.65);
                            if item.expires != "": Text {
                                text: "⏱ " + item.expires;
                                font-size: 0.72rem;
                                color: parent.faint;
                            }
                            if item.edited: Text {
                                text: "edited";
                                font-size: 0.72rem;
                                font-italic: true;
                                color: parent.faint;
                            }
                            if item.last: Text {
                                text: item.time;
                                font-size: 0.72rem;
                                color: parent.faint;
                            }
                            // ✓ sent, ✓✓ delivered, ✓✓ in full white once read.
                            if item.last && item.delivery > 0: Text {
                                text: item.delivery == 1 ? "✓" : "✓✓";
                                font-size: 0.72rem;
                                font-weight: item.delivery == 3 ? 700 : 400;
                                color: item.delivery == 3 ? root.ink : parent.faint;
                            }
                        }
                    }
                }
                if item.reactions.length > 0: HorizontalLayout {
                    alignment: item.outgoing ? end : start;
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    for reaction in item.reactions: Rectangle {
                        height: 24px;
                        width: chip.preferred-width + 14px;
                        border-radius: 12px;
                        background: reaction.mine ? Palette.accent-background.with-alpha(0.25) : Palette.alternate-background;
                        border-width: 1px;
                        border-color: reaction.mine ? Palette.accent-background : Palette.border;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.react(reaction.emoji); }
                        }
                        chip := Text {
                            text: reaction.count > 1 ? reaction.emoji + " " + reaction.count : reaction.emoji;
                            font-size: 0.85rem;
                            color: Palette.foreground;
                        }
                    }
                }
            }
            if !item.outgoing: VerticalLayout {
                alignment: center;
                HoverButtons {
                    visible: !item.deleted;
                    shown: hover.has-hover;
                    react => { picker.show(); }
                    reply => { root.reply(); }
                }
            }
        }
    }

    // On top: it takes only right clicks.
    ContextMenuArea {
        Menu {
            if !item.deleted: MenuItem {
                title: "Reply";
                activated => { root.reply(); }
            }
            if !item.deleted: MenuItem {
                title: "React…";
                activated => { picker.show(); }
            }
            if item.text != "": MenuItem {
                title: "Copy text";
                activated => { root.copy-text(item.text); }
            }
            if item.can-forward: MenuItem {
                title: "Forward…";
                activated => { root.forward(); }
            }
            if item.can-edit: MenuItem {
                title: "Edit";
                activated => { root.edit(); }
            }
            if !item.deleted: MenuSeparator {}
            MenuItem {
                title: "Delete for me";
                activated => { root.delete(false); }
            }
            if item.can-edit: MenuItem {
                title: "Delete for everyone";
                activated => { root.delete(true); }
            }
        }
    }
}

component PasswordScreen inherits Rectangle {
    // Choosing a password for a new database, rather than unlocking an existing one.
    in property <bool> new;
    in property <string> error;
    property <string> confirmation;
    callback unlock(string, string);

    background: Palette.background;
    forward-focus: password-field;

    function submit() {
        root.unlock(password-field.text, root.confirmation);
        password-field.text = "";
        root.confirmation = "";
        password-field.focus();
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 360px;
                spacing: 12px;
                Text {
                    text: root.new ? "Choose a password" : "Unlock langis";
                    font-size: 1.6rem;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
                Text {
                    text: root.new
                        ? "No system keyring was found, so langis will encrypt your messages with this password. It can't be recovered if you forget it."
                        : "Enter the password that protects your messages on this computer.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    color: Palette.foreground.with-alpha(0.7);
                }
                password-field := LineEdit {
                    input-type: password;
                    placeholder-text: "Password";
                    // When choosing a password, Tab leads on to the confirmation field.
                    accepted => {
                        if !root.new { root.submit(); }
                    }
                }
                if root.new: LineEdit {
                    text <=> root.confirmation;
                    input-type: password;
                    placeholder-text: "Repeat password";
                    accepted => { root.submit(); }
                }
                if root.error != "": Text {
                    text: root.error;
                    color: #c4314b;
                    horizontal-alignment: center;
                }
                Button {
                    text: root.new ? "Continue" : "Unlock";
                    primary: true;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}

component LinkScreen inherits Rectangle {
    in property <image> qr;
    background: Palette.background;
    VerticalLayout {
        alignment: center;
        spacing: 20px;
        Text {
            text: "Link langis to your phone";
            font-size: 1.6rem;
            font-weight: 600;
            horizontal-alignment: center;
            color: Palette.foreground;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 280px;
                height: 280px;
                border-radius: 12px;
                background: white;
                drop-shadow-blur: 12px;
                drop-shadow-color: #0003;
                Image {
                    width: parent.width - 24px;
                    height: self.width;
                    source: qr;
                    image-rendering: pixelated;
                }
            }
        }
        Text {
            text: "On your phone, open Signal → Settings → Linked devices → Link new device,\nthen scan this code.";
            horizontal-alignment: center;
            color: Palette.foreground.with-alpha(0.7);
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.label; color: Palette.foreground; }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 0.85rem;
            wrap: word-wrap;
            color: Palette.foreground.with-alpha(0.6);
        }
    }
    @children
}

component SectionTitle inherits Text {
    font-size: 0.85rem;
    font-weight: 700;
    color: Palette.accent-background;
}

component SettingsPage inherits Rectangle {
    in-out property <int> theme;
    in-out property <int> widget-style;
    in property <string> style-note;
    in-out property <int> text-size;
    in-out property <bool> show-avatars;
    in-out property <bool> notifications;
    in-out property <int> notification-content;
    in-out property <bool> close-to-tray;
    // Whether the desktop shows tray icons; without, closing the window quits.
    in property <bool> tray-available: true;
    in property <bool> autostart-supported;
    in-out property <bool> start-with-system;
    in-out property <bool> read-receipts;
    in-out property <bool> typing-indicators;
    in property <string> account;
    in property <string> device-name;
    callback changed-settings;
    callback changed-start-with-system(bool);
    callback opened;
    callback close;

    // Shown only while open, so this runs each time it opens.
    init => { root.opened(); }

    VerticalLayout {
        Rectangle {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Text {
                    text: "Settings";
                    font-size: 1.1rem;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    color: Palette.foreground;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Back";
                        clicked => { root.close(); }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
        }
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: center;
                padding-left: 24px;
                padding-right: 24px;
                VerticalLayout {
                    preferred-width: 520px;
                    max-width: 520px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 14px;
                    alignment: start;

                    SectionTitle { text: "Appearance"; }
                    SettingRow {
                        label: "Theme";
                        // Qt styles (System, Fusion) take their colours from the desktop.
                        hint: root.widget-style <= 1 ? "The System and Fusion styles follow your desktop's colours." : "";
                        ComboBox {
                            enabled: root.widget-style > 1;
                            width: 200px;
                            model: ["System", "Light", "Dark"];
                            current-index <=> root.theme;
                            selected => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Style";
                        hint: root.style-note;
                        ComboBox {
                            width: 200px;
                            // In the order of `WidgetStyle::ALL`.
                            model: ["System", "Fusion", "Fluent", "Material", "Cupertino", "Cosmic"];
                            current-index <=> root.widget-style;
                            selected => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Text size";
                        ComboBox {
                            width: 200px;
                            model: ["Small", "Default", "Large"];
                            current-index <=> root.text-size;
                            selected => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Profile pictures";
                        hint: "Show contacts' and groups' pictures instead of initials.";
                        Switch {
                            checked <=> root.show-avatars;
                            toggled => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Notifications"; }
                    SettingRow {
                        label: "New messages";
                        hint: "Notify about messages unless their chat is open in front.";
                        Switch {
                            checked <=> root.notifications;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Show";
                        ComboBox {
                            width: 200px;
                            enabled: root.notifications;
                            model: ["Name and message", "Name only", "Nothing"];
                            current-index <=> root.notification-content;
                            selected => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Privacy"; }
                    SettingRow {
                        label: "Read receipts";
                        hint: "Let people know when you've read their messages. Turned off, you don't see theirs either on your phone.";
                        Switch {
                            checked <=> root.read-receipts;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Typing indicators";
                        hint: "Let people see when you're typing.";
                        Switch {
                            checked <=> root.typing-indicators;
                            toggled => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Background"; }
                    SettingRow {
                        label: "Keep running in the tray";
                        hint: root.tray-available
                            ? "Closing the window leaves langis in the tray, still receiving messages."
                            : "Your desktop doesn't show tray icons, so closing the window quits langis.";
                        Switch {
                            enabled: root.tray-available;
                            checked <=> root.close-to-tray;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    if root.autostart-supported: SettingRow {
                        label: "Start with the system";
                        hint: root.close-to-tray && root.tray-available ? "Starts in the tray when you log in." : "Opens langis when you log in.";
                        Switch {
                            checked <=> root.start-with-system;
                            toggled => { root.changed-start-with-system(self.checked); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Account"; }
                    SettingRow {
                        label: "Account";
                        Text {
                            text: root.account;
                            overflow: elide;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                    }
                    SettingRow {
                        label: "Device name";
                        hint: "How this computer appears under Linked devices on your phone.";
                        Text {
                            text: root.device-name;
                            vertical-alignment: center;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // Rust says "MOCK" here when the mock backend runs, since it sends nothing.
    in property <string> window-title: "langis";
    title: root.window-title;
    icon: @image-url("../assets/langis.svg");
    min-width: 360px;
    min-height: 480px;
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Palette.background;

    in property <Screen> screen: Screen.connecting;
    in property <image> link-qr;
    in property <bool> password-new;
    in property <string> password-error;
    in property <string> account;
    in property <string> error;
    in property <bool> synced;
    // Progress of the message history transfer after linking; empty when there is none.
    in property <string> history-status;
    in property <bool> history-skippable;
    in property <[ConversationItem]> conversations;
    in property <[MessageItem]> messages;
    in property <int> selected: -1;
    in property <bool> can-send;
    in-out property <string> draft;

    // Settings: indexes into the choices shown on the settings page.
    in-out property <int> theme;
    in-out property <int> widget-style;
    // Explains a style change that waits for a restart; empty otherwise.
    in property <string> style-note;
    in-out property <int> text-size: 1;
    in-out property <bool> show-avatars: true;
    in-out property <bool> notifications: true;
    in-out property <bool> close-to-tray: true;
    in property <bool> tray-available: true;
    in property <bool> autostart-supported;
    in-out property <bool> start-with-system;
    in-out property <int> notification-content;
    in-out property <bool> read-receipts: true;
    in-out property <bool> typing-indicators: true;
    in property <string> device-name;
    in-out property <bool> settings-open;
    // Factor for the chosen text size, applied to the platform's font size, which is captured
    // before it is changed.
    in property <float> font-scale: 1.0;
    property <length> platform-font-size;

    function apply-settings() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light
            : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        root.default-font-size = root.platform-font-size * root.font-scale;
    }
    init => {
        // `default-font-size` reads 0 while unset; `1rem` resolves it to the platform's size.
        root.platform-font-size = 1rem;
        root.apply-settings();
    }
    changed theme => { root.apply-settings(); }
    changed font-scale => { root.apply-settings(); }

    callback select(string);
    callback draft-edited(string);
    callback send(string);
    callback dismiss-error;
    callback unlock(string, string);
    callback settings-changed;
    callback start-with-system-changed(bool);
    callback settings-opened;
    callback skip-history;
    callback search(string);
    callback open-attachment(string);
    callback open-link(string);
    callback attach;
    // From Rust, once the file picker is done.
    callback stage-files([string]);
    callback unstage(int);
    callback back;
    // Names of files waiting to go out with the next message.
    in property <[string]> staged;
    in-out property <length> sidebar-width: 300px;
    // One pane at a time: the list, or the open chat with a way back. Kept up to date when
    // the width changes rather than bound to it, since the layout depends on it in turn.
    out property <bool> narrow;
    changed width => { root.narrow = root.width < 640px; }
    callback reply(int);
    callback react(int, string);
    callback cancel-reply;
    // The message the composer answers; both empty when not replying.
    in property <string> reply-author;
    in property <string> reply-text;
    in-out property <string> search-text;
    callback fetch-attachment(string);
    callback save-attachment(string);
    // See `ConversationMenu`; each takes the conversation's id first.
    callback toggle-pin(string);
    callback move-pin(string, int);
    callback mark-read(string, bool);
    callback mute(string, int);
    callback archive(string, bool);
    callback set-timer(string, int);
    callback show-archived(bool);
    // Scrolled near the top of the open chat: older messages, if there are any.
    callback load-older;
    callback edit(int);
    callback delete(int, bool);
    callback reveal(int);
    callback cancel-edit;
    // Alt+1…9 (the key's text): opens that pinned chat; whether there is one.
    callback pinned-shortcut(string) -> bool;
    // How many chats are archived, and how many of those have unread messages.
    in property <int> archived-count;
    in property <int> archived-unread;
    in property <bool> showing-archived;
    // Who is typing in the open chat, e.g. "Ann is typing…"; empty if nobody is.
    in property <string> typing;
    // The composer replaces the text of one of our messages.
    in property <bool> editing;
    // The open chat's media, files and links.
    in property <bool> media-open;
    // Gathering them.
    in property <bool> media-busy;
    in property <[MediaRow]> media-rows;
    in property <[SharedItem]> media-files;
    in property <[SharedItem]> media-links;
    in-out property <int> media-tab;
    callback open-media;
    callback close-media;
    // Searching the open chat.
    in property <bool> chat-search-open;
    in-out property <string> chat-search-text;
    // Looking, no results yet.
    in property <bool> chat-search-busy;
    in property <[SearchResult]> search-results;
    callback open-chat-search;
    callback close-chat-search;
    callback chat-search(string);
    callback show-result(int);
    // Scroll the open chat to this row once `jump-serial` changes.
    in property <int> jump-row;
    in property <int> jump-serial;
    // Choosing where to forward a message to.
    in property <bool> forwarding;
    in property <[ConversationItem]> forward-targets;
    in-out property <string> forward-filter;
    callback forward(int);
    callback forward-to(string);
    callback cancel-forward;
    callback forward-filter-edited;
    // Group members matching the "@…" the draft ends with.
    in property <[string]> mention-candidates;
    callback pick-mention(int);

    // Copies through a text input, the way Slint reaches the clipboard.
    clipboard := TextInput { visible: false; width: 0; height: 0; }
    function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }

    VerticalLayout {
        if root.error != "": Rectangle {
            height: 36px;
            background: #c4314b;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                Text {
                    text: root.error;
                    color: white;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                TouchArea {
                    width: 28px;
                    clicked => { root.dismiss-error(); }
                    Text { text: "✕"; color: white; }
                }
            }
        }

        if root.screen == Screen.connecting: Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout { alignment: center; Spinner { indeterminate: true; } }
                Text {
                    text: "Connecting to Signal…";
                    horizontal-alignment: center;
                    color: Palette.foreground.with-alpha(0.7);
                }
            }
        }

        if root.screen == Screen.password: PasswordScreen {
            new: root.password-new;
            error: root.password-error;
            unlock(password, confirmation) => { root.unlock(password, confirmation); }
        }

        if root.screen == Screen.link: LinkScreen { qr: root.link-qr; }

        if root.screen == Screen.chats: HorizontalLayout {
            // Sidebar: the whole window when narrow and nothing is open.
            if !root.narrow || (root.selected < 0 && !root.settings-open): Rectangle {
                // Fixed (but draggable) beside a chat; the whole window when narrow.
                horizontal-stretch: root.narrow ? 1 : 0;
                min-width: root.narrow ? 0px : root.sidebar-width;
                max-width: root.narrow ? 100000px : root.sidebar-width;
                background: Palette.alternate-background;
                VerticalLayout {
                    HorizontalLayout {
                        padding: 16px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        if root.showing-archived: TouchArea {
                            width: 24px;
                            mouse-cursor: pointer;
                            clicked => { root.show-archived(false); }
                            Text {
                                text: "←";
                                font-size: 1.3rem;
                                color: Palette.foreground.with-alpha(0.8);
                            }
                        }
                        Text {
                            text: root.showing-archived ? "Archived" : "Chats";
                            font-size: 1.3rem;
                            font-weight: 700;
                            color: Palette.foreground;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        settings-button := Rectangle {
                            width: 28px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: root.settings-open ? Palette.accent-background.with-alpha(0.18)
                                : settings-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                            settings-touch := TouchArea {
                                clicked => { root.settings-open = !root.settings-open; }
                            }
                            Text {
                                text: "⚙";
                                font-size: 1.2rem;
                                color: Palette.foreground.with-alpha(0.75);
                            }
                        }
                    }
                    if root.history-status != "": HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        Spinner {
                            indeterminate: true;
                            width: 16px;
                            height: 16px;
                        }
                        Text {
                            text: root.history-status;
                            wrap: word-wrap;
                            font-size: 0.85rem;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                        if root.history-skippable: VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Skip";
                                clicked => { root.skip-history(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-bottom: 8px;
                        LineEdit {
                            placeholder-text: "Search or start a chat";
                            text <=> root.search-text;
                            edited(text) => { root.search(text); }
                        }
                    }
                    if root.archived-count > 0 && !root.showing-archived && root.search-text == "": HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: archive-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                            archive-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-archived(true); }
                            }
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 12px;
                                Text {
                                    text: "📦";
                                    width: 40px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.foreground.with-alpha(0.7);
                                }
                                Text {
                                    text: "Archived chats";
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    color: Palette.foreground.with-alpha(0.8);
                                }
                                Text {
                                    text: root.archived-unread > 0 ? root.archived-count + " · " + root.archived-unread + " unread" : root.archived-count;
                                    font-size: 0.8rem;
                                    vertical-alignment: center;
                                    color: Palette.foreground.with-alpha(0.55);
                                }
                            }
                        }
                    }
                    ListView {
                        for item[index] in root.conversations: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            ConversationRow {
                                item: item;
                                selected: index == root.selected;
                                clicked => {
                                    root.settings-open = false;
                                    root.select(item.id);
                                }
                                toggle-pin => { root.toggle-pin(item.id); }
                                move-pin(by) => { root.move-pin(item.id, by); }
                                mark-read(read) => { root.mark-read(item.id, read); }
                                mute(seconds) => { root.mute(item.id, seconds); }
                                archive(archived) => { root.archive(item.id, archived); }
                            }
                        }
                    }
                }
            }
            // The divider; drag it to resize the sidebar.
            if !root.narrow: Rectangle {
                width: 1px;
                background: Palette.border;
                TouchArea {
                    x: -3px;
                    width: 7px;
                    mouse-cursor: col-resize;
                    moved => {
                        root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 220px, 480px);
                    }
                }
            }

            if root.settings-open: SettingsPage {
                horizontal-stretch: 1;
                theme <=> root.theme;
                widget-style <=> root.widget-style;
                style-note: root.style-note;
                text-size <=> root.text-size;
                show-avatars <=> root.show-avatars;
                notifications <=> root.notifications;
                notification-content <=> root.notification-content;
                close-to-tray <=> root.close-to-tray;
                tray-available: root.tray-available;
                autostart-supported: root.autostart-supported;
                start-with-system <=> root.start-with-system;
                read-receipts <=> root.read-receipts;
                typing-indicators <=> root.typing-indicators;
                account: root.account;
                device-name: root.device-name;
                changed-settings => { root.settings-changed(); }
                changed-start-with-system(enabled) => { root.start-with-system-changed(enabled); }
                opened => { root.settings-opened(); }
                close => { root.settings-open = false; }
            }

            // Conversation
            if !root.settings-open && root.selected < 0 && !root.narrow: Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    HorizontalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/langis.svg");
                            width: 88px;
                            height: 88px;
                            opacity: 0.55;
                        }
                    }
                    Text {
                        text: "Pick a chat on the left,\nor search for someone to start a new one.";
                        horizontal-alignment: center;
                        color: Palette.foreground.with-alpha(0.55);
                    }
                }
            }
            if !root.settings-open && root.selected >= 0: VerticalLayout {
                horizontal-stretch: 1;
                Rectangle {
                    height: 60px;
                    HorizontalLayout {
                        padding-left: root.narrow ? 4px : 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        if root.narrow: TouchArea {
                            width: 36px;
                            mouse-cursor: pointer;
                            clicked => { root.back(); }
                            Text {
                                text: "←";
                                font-size: 1.3rem;
                                color: Palette.foreground.with-alpha(0.8);
                            }
                        }
                        Avatar {
                            width: 36px;
                            initials: root.conversations[root.selected].initials;
                            tint: root.conversations[root.selected].avatar-color;
                            picture: root.conversations[root.selected].avatar;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.conversations[root.selected].title;
                                font-size: 1.1rem;
                                font-weight: 600;
                                overflow: elide;
                                color: Palette.foreground;
                            }
                            if root.typing != "": Text {
                                text: root.typing;
                                font-size: 0.8rem;
                                overflow: elide;
                                color: Palette.accent-background;
                            }
                            if root.typing == "" && (root.conversations[root.selected].subtitle != "" || root.conversations[root.selected].timer > 0): Text {
                                text: root.conversations[root.selected].subtitle
                                    + (root.conversations[root.selected].timer > 0
                                        ? (root.conversations[root.selected].subtitle != "" ? " · " : "") + "⏱ " + root.conversations[root.selected].timer-label
                                        : "");
                                font-size: 0.8rem;
                                overflow: elide;
                                color: Palette.foreground.with-alpha(0.6);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HoverButton {
                                symbol: "🔍";
                                shown: true;
                                clicked => {
                                    root.chat-search-text = "";
                                    root.open-chat-search();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            HoverButton {
                                symbol: "⋮";
                                shown: true;
                                clicked => { chat-menu.show({ x: chat-menu.width - 240px, y: chat-menu.height - 8px }); }
                            }
                        }
                    }
                    chat-menu := ConversationMenu {
                        item: root.conversations[root.selected];
                        with-timer: true;
                        property <string> id: root.conversations[root.selected].id;
                        toggle-pin => { root.toggle-pin(self.id); }
                        move-pin(by) => { root.move-pin(self.id, by); }
                        mark-read(read) => { root.mark-read(self.id, read); }
                        mute(seconds) => { root.mute(self.id, seconds); }
                        archive(archived) => { root.archive(self.id, archived); }
                        set-timer(seconds) => { root.set-timer(self.id, seconds); }
                        show-media => { root.open-media(); }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                // While catching up with what arrived meanwhile; sending waits for it.
                if !root.synced: ProgressIndicator {
                    indeterminate: true;
                    height: 3px;
                }

                Rectangle {
                vertical-stretch: 1;
                message-list := ListView {
                    width: parent.width;
                    height: parent.height;
                    // Follow new messages only while the newest one is in view, so reading
                    // older messages isn't interrupted. Opening a chat starts at the bottom.
                    property <bool> follow: true;
                    property <int> conversation: root.selected;
                    changed conversation => { self.follow = true; }
                    // Jumping to a search result: rows have different heights and are only
                    // measured once shown, so the place is estimated from the average and
                    // corrected a few times as they are.
                    property <int> jump-serial: root.jump-serial;
                    property <int> settling;
                    function scroll-to-jump() {
                        if root.messages.length > 0 {
                            self.content-y = max(self.visible-height - self.content-height,
                                min(0px, self.visible-height / 3
                                    - root.jump-row * self.content-height / root.messages.length));
                        }
                    }
                    changed jump-serial => {
                        self.follow = false;
                        self.settling = 6;
                        self.scroll-to-jump();
                    }
                    // Only the user's own scrolling decides; content growing (pictures arriving,
                    // rows being measured) moves the viewport too and must not stop following.
                    scrolled => {
                        self.follow = self.content-y <= self.visible-height - self.content-height + 8px;
                        if self.content-y > -self.visible-height / 2 {
                            root.load-older();
                        }
                    }
                    changed content-height => {
                        // Older messages put in above don't move what is shown: the list
                        // keeps its first visible row in place by itself.
                        if self.follow {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        }
                        // Nothing to scroll yet: there may be more before.
                        if self.content-height < self.visible-height {
                            root.load-older();
                        }
                        if self.settling > 0 {
                            self.settling -= 1;
                            self.scroll-to-jump();
                        }
                    }
                    // E.g. the reply bar opening below.
                    changed visible-height => {
                        if self.follow {
                            self.content-y = min(0px, self.visible-height - self.content-height);
                        }
                    }
                    for item[index] in root.messages: Bubble {
                        item: item;
                        reply => {
                            root.reply(index);
                            composer.focus();
                        }
                        max-bubble-width: message-list.visible-width * 0.7;
                        fetch-attachment(id) => { root.fetch-attachment(id); }
                        save-attachment(id) => { root.save-attachment(id); }
                        open-attachment(id) => { root.open-attachment(id); }
                        open-link(link) => { root.open-link(link); }
                        react(emoji) => { root.react(index, emoji); }
                        edit => {
                            root.edit(index);
                            composer.focus();
                        }
                        delete(everyone) => { root.delete(index, everyone); }
                        copy-text(text) => { root.copy-text(text); }
                        reveal => { root.reveal(index); }
                        forward => {
                            root.forward-filter = "";
                            root.forward(index);
                        }
                    }
                }
                if root.chat-search-open: Rectangle {
                    background: Palette.background;
                    search-timer := Timer {
                        interval: 300ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            root.chat-search(root.chat-search-text);
                        }
                    }
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                placeholder-text: "Search this chat";
                                text <=> root.chat-search-text;
                                init => { self.focus(); }
                                // After a pause in typing.
                                edited => {
                                    search-timer.running = false;
                                    search-timer.running = true;
                                }
                                accepted => { root.chat-search(self.text); }
                            }
                            Button {
                                text: "Close";
                                clicked => {
                                    root.close-chat-search();
                                    composer.focus();
                                }
                            }
                        }
                        if root.chat-search-busy: HorizontalLayout {
                            alignment: center;
                            Spinner {
                                indeterminate: true;
                                width: 20px;
                                height: 20px;
                            }
                        }
                        if !root.chat-search-busy && root.chat-search-text != "" && root.search-results.length == 0: Text {
                            text: "No messages found.";
                            horizontal-alignment: center;
                            color: Palette.foreground.with-alpha(0.6);
                        }
                        ListView {
                            vertical-stretch: 1;
                            for result[index] in root.search-results: Rectangle {
                                height: result-column.preferred-height;
                                border-radius: 6px;
                                background: result-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                result-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.show-result(index); }
                                }
                                result-column := VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        Text {
                                            text: result.sender;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                            color: Palette.foreground;
                                        }
                                        Text {
                                            text: result.when;
                                            font-size: 0.8rem;
                                            color: Palette.foreground.with-alpha(0.55);
                                        }
                                    }
                                    Text {
                                        text: result.text;
                                        wrap: word-wrap;
                                        color: Palette.foreground.with-alpha(0.8);
                                    }
                                }
                            }
                        }
                    }
                }
                if root.media-open: Rectangle {
                    background: Palette.background;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 4px;
                            for tab[index] in ["Media", "Files", "Links"]: Rectangle {
                                width: tab-label.preferred-width + 24px;
                                height: 32px;
                                border-radius: 6px;
                                background: index == root.media-tab ? Palette.accent-background.with-alpha(0.18)
                                    : tab-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                tab-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.media-tab = index; }
                                }
                                tab-label := Text {
                                    text: tab;
                                    font-weight: index == root.media-tab ? 600 : 400;
                                    color: Palette.foreground;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Close";
                                clicked => { root.close-media(); }
                            }
                        }
                        if root.media-busy: HorizontalLayout {
                            alignment: center;
                            Spinner {
                                indeterminate: true;
                                width: 20px;
                                height: 20px;
                            }
                        }
                        property <bool> empty: root.media-tab == 0 ? root.media-rows.length == 0
                            : root.media-tab == 1 ? root.media-files.length == 0 : root.media-links.length == 0;
                        if !root.media-busy && self.empty: Text {
                            text: root.media-tab == 0 ? "No photos or videos yet." : root.media-tab == 1 ? "No files yet." : "No links yet.";
                            horizontal-alignment: center;
                            color: Palette.foreground.with-alpha(0.6);
                        }
                        if root.media-tab == 0: ListView {
                            vertical-stretch: 1;
                            for row in root.media-rows: HorizontalLayout {
                                spacing: 4px;
                                padding-bottom: 4px;
                                alignment: start;
                                for tile in row.tiles: Rectangle {
                                    width: 110px;
                                    height: 110px;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Palette.alternate-background;
                                    init => {
                                        if tile.fetch { root.fetch-attachment(tile.id); }
                                    }
                                    if tile.picture.width > 0: Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: tile.picture;
                                        image-fit: cover;
                                    }
                                    // Videos (not downloaded for this) and pictures on their way.
                                    if tile.picture.width == 0: Text {
                                        text: tile.inline ? "" : "🎞";
                                        font-size: 1.6rem;
                                        color: Palette.foreground.with-alpha(0.6);
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-attachment(tile.id); }
                                    }
                                }
                            }
                        }
                        if root.media-tab == 1: ListView {
                            vertical-stretch: 1;
                            for file in root.media-files: VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                HorizontalLayout {
                                    Text {
                                        text: file.sender;
                                        font-size: 0.8rem;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                        color: Palette.foreground.with-alpha(0.8);
                                    }
                                    Text {
                                        text: file.when;
                                        font-size: 0.8rem;
                                        color: Palette.foreground.with-alpha(0.55);
                                    }
                                }
                                AttachmentView {
                                    item: file.attachment;
                                    outgoing: false;
                                    fetch(id) => { root.fetch-attachment(id); }
                                    save(id) => { root.save-attachment(id); }
                                    open(id) => { root.open-attachment(id); }
                                }
                            }
                        }
                        if root.media-tab == 2: ListView {
                            vertical-stretch: 1;
                            for link in root.media-links: Rectangle {
                                height: link-column.preferred-height;
                                border-radius: 6px;
                                background: link-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                link-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-link(link.url); }
                                }
                                link-column := VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text {
                                        text: link.url;
                                        overflow: elide;
                                        color: Palette.accent-background;
                                    }
                                    Text {
                                        text: link.sender + " · " + link.when;
                                        font-size: 0.8rem;
                                        color: Palette.foreground.with-alpha(0.6);
                                    }
                                }
                            }
                        }
                    }
                }
                }

                if root.mention-candidates.length > 0: Rectangle {
                    background: Palette.alternate-background;
                    VerticalLayout {
                        padding: 6px;
                        padding-left: 12px;
                        padding-right: 12px;
                        for name[index] in root.mention-candidates: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            // The first is what Tab or Enter picks.
                            background: mention-touch.has-hover ? Palette.foreground.with-alpha(0.1)
                                : index == 0 ? Palette.accent-background.with-alpha(0.15) : transparent;
                            mention-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.pick-mention(index);
                                    composer.focus();
                                }
                            }
                            Text {
                                x: 10px;
                                text: "@" + name;
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }
                        }
                    }
                }
                if root.editing: Rectangle {
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        padding-top: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 3px;
                            border-radius: 1.5px;
                            background: Palette.accent-background;
                        }
                        Text {
                            text: "Editing message";
                            font-size: 0.85rem;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: Palette.foreground;
                        }
                        TouchArea {
                            width: 28px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.cancel-edit();
                                root.draft = "";
                            }
                            Text { text: "✕"; color: Palette.foreground.with-alpha(0.6); }
                        }
                    }
                }
                if root.reply-author != "" || root.reply-text != "": Rectangle {
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        padding-top: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 3px;
                            border-radius: 1.5px;
                            background: Palette.accent-background;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: "Replying to " + root.reply-author;
                                font-size: 0.8rem;
                                font-weight: 600;
                                color: Palette.foreground;
                            }
                            Text {
                                text: root.reply-text;
                                font-size: 0.85rem;
                                overflow: elide;
                                color: Palette.foreground.with-alpha(0.7);
                            }
                        }
                        TouchArea {
                            width: 28px;
                            mouse-cursor: pointer;
                            clicked => { root.cancel-reply(); }
                            Text { text: "✕"; color: Palette.foreground.with-alpha(0.6); }
                        }
                    }
                }
                // Files waiting to go out with the next message.
                if root.staged.length > 0: HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    spacing: 6px;
                    alignment: start;
                    for name[index] in root.staged: Rectangle {
                        height: 26px;
                        width: staged-row.preferred-width + 16px;
                        border-radius: 13px;
                        background: Palette.alternate-background;
                        border-width: 1px;
                        border-color: Palette.border;
                        staged-row := HorizontalLayout {
                            x: 8px;
                            width: parent.width - 16px;
                            spacing: 6px;
                            Text {
                                text: "📎 " + name;
                                font-size: 0.85rem;
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }
                            TouchArea {
                                width: 14px;
                                mouse-cursor: pointer;
                                clicked => { root.unstage(index); }
                                Text { text: "✕"; font-size: 0.8rem; color: Palette.foreground.with-alpha(0.6); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding: 12px;
                    spacing: 6px;
                    alignment: stretch;
                    VerticalLayout {
                        alignment: end;
                        HoverButton {
                            symbol: "📎";
                            shown: true;
                            clicked => { root.attach(); }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        HoverButton {
                            symbol: "☺";
                            shown: true;
                            clicked => { emoji-picker.show(); }
                        }
                        emoji-picker := PopupWindow {
                            x: 0;
                            y: -190px;
                            Rectangle {
                                width: 8 * 34px + 12px;
                                height: 4 * 34px + 12px;
                                border-radius: 10px;
                                background: Palette.alternate-background;
                                border-width: 1px;
                                border-color: Palette.border;
                                drop-shadow-blur: 8px;
                                drop-shadow-color: #0003;
                                for emoji[i] in ["😀", "😂", "🥲", "😊", "😍", "😘", "😎", "🤔",
                                                 "😮", "😢", "😭", "😡", "🙄", "😴", "🤯", "🥳",
                                                 "👍", "👎", "👏", "🙏", "💪", "👋", "🤝", "✌️",
                                                 "❤️", "🔥", "🎉", "✨", "💯", "✅", "❌", "👀"]: Rectangle {
                                    x: 6px + mod(i, 8) * 34px;
                                    y: 6px + floor(i / 8) * 34px;
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: emoji-touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
                                    emoji-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.draft = root.draft + emoji;
                                            root.draft-edited(root.draft);
                                            composer.focus();
                                        }
                                    }
                                    Text { text: emoji; font-size: 1.2rem; }
                                }
                            }
                        }
                    }
                    // Grows with the draft, up to a few lines. The draft is measured by an invisible
                    // copy, since the editor's own content height depends on its height.
                    Rectangle {
                        horizontal-stretch: 1;
                        // Room for the style's frame and padding, so no scroll bar shows for a line.
                        height: clamp(measure.preferred-height + 30px, 50px, 150px);
                        measure := Text {
                            visible: false;
                            width: parent.width - 20px;
                            text: root.draft + " ";
                            wrap: word-wrap;
                        }
                        composer := TextEdit {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.draft;
                            placeholder-text: root.editing ? "Edit message" : "Message";
                            wrap: word-wrap;
                            edited(text) => { root.draft-edited(text); }
                            // Enter sends; Shift+Enter starts a new line.
                            key-pressed(event) => {
                                if (event.text == Key.Tab || event.text == Key.Return) && root.mention-candidates.length > 0 {
                                    root.pick-mention(0);
                                    return accept;
                                }
                                if event.text == Key.Return && !event.modifiers.shift {
                                    if root.can-send { root.send(root.draft); }
                                    return accept;
                                }
                                if event.text == Key.Escape && root.editing {
                                    root.cancel-edit();
                                    root.draft = "";
                                    return accept;
                                }
                                if event.modifiers.control && (event.text == "f" || event.text == "F") {
                                    root.chat-search-text = "";
                                    root.open-chat-search();
                                    return accept;
                                }
                                // Alt+1…9 opens the pinned chats.
                                if event.modifiers.alt && root.pinned-shortcut(event.text) {
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        Button {
                            text: root.editing ? "Save" : "Send";
                            primary: true;
                            enabled: root.can-send;
                            clicked => { root.send(root.draft); composer.focus(); }
                        }
                    }
                }
            }
        }
    }

    // Choosing where to forward a message to, over everything else.
    if root.forwarding: Rectangle {
        background: #0008;
        TouchArea {
            clicked => { root.cancel-forward(); }
        }
        Rectangle {
            width: min(420px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            border-radius: 12px;
            background: Palette.background;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            // Clicks inside don't close it.
            TouchArea {}
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Forward to…";
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                LineEdit {
                    placeholder-text: "Search";
                    text <=> root.forward-filter;
                    init => { self.focus(); }
                    edited => { root.forward-filter-edited(); }
                }
                ListView {
                    vertical-stretch: 1;
                    for target in root.forward-targets: Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        background: target-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                        target-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.forward-to(target.id); }
                        }
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 10px;
                            Avatar {
                                width: 36px;
                                initials: target.initials;
                                tint: target.avatar-color;
                                picture: target.avatar;
                            }
                            Text {
                                text: target.title;
                                vertical-alignment: center;
                                overflow: elide;
                                color: Palette.foreground;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.cancel-forward(); }
                    }
                }
            }
        }
    }
}
