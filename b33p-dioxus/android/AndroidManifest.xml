<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup="false": Android's backup would copy the app's files (the database and its key
      material) to Google Drive and restore them on another device, which would put one Signal
      identity on two. Linking a device is how b33p gets onto a new phone.

      The theme: AppCompat's day and night one, not dx's light AppTheme, so that the WebView's
      prefers-color-scheme follows the system and style.css's dark colours apply.

      configChanges: every change the activity can say it handles itself. For any other, Android
      destroys the activity to make it anew, and tao (under Dioxus) can't take that: the event
      loop ends with its only window and the process exits. Dark mode, the font size or the
      language changing would close b33p. Left over: the theme overlays Android applies when the
      wallpaper's colours change, which no manifest can claim (b33p-dioxus/README.md).
    -->
    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false"
        android:label="b33p"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|density|screenSize|smallestScreenSize|layoutDirection|colorMode|grammaticalGender|fontWeightAdjustment"
            android:exported="true"
            android:label="b33p" android:name="dev.dioxus.main.MainActivity"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
