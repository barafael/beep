<?xml version="1.0" encoding="utf-8"?>
<!-- An instrumentation of itself: `am instrument` gives it UiAutomation, which reads and watches
     every app's windows. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:label="testbox agent" />
  <instrumentation
    android:name=".Agent"
    android:label="testbox agent"
    android:targetPackage="org.b33p.testbox.agent" />
</manifest>
