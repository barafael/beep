diff --color -ruN a/pkg/signalmeow/web/box.go b/pkg/signalmeow/web/box.go
--- a/pkg/signalmeow/web/box.go
+++ b/pkg/signalmeow/web/box.go
@@ -0,0 +1,91 @@
+package web
+
+// testbox: points signalmeow at a Signal-Server test box instead of Signal's. When the
+// environment variable SIGNALMEOW_BOX_CONFIG names a file (the box's /keys/desktop-config.json),
+// the hosts, the TLS roots, the zkgroup server public parameters and the unidentified-sender
+// trust roots are the box's. Without it nothing changes.
+
+import (
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"net/url"
+	"os"
+
+	"go.mau.fi/mautrix-signal/pkg/libsignalgo"
+)
+
+type boxConfig struct {
+	ServerURL            string            `json:"serverUrl"`
+	StorageURL           string            `json:"storageUrl"`
+	ResourcesURL         string            `json:"resourcesUrl"`
+	CDN                  map[string]string `json:"cdn"`
+	CertificateAuthority string            `json:"certificateAuthority"`
+	ServerPublicParams   string            `json:"serverPublicParams"`
+	ServerTrustRoots     []string          `json:"serverTrustRoots"`
+}
+
+var box *boxConfig
+
+// ResourcesHostname is the box's HTTP/2 REST port (Signal-Server's, beside the chat's omnibus one).
+var ResourcesHostname = ""
+
+func hostOf(raw string) string {
+	u, err := url.Parse(raw)
+	if err != nil || u.Host == "" {
+		panic("box config: bad URL " + raw)
+	}
+	return u.Host
+}
+
+func init() {
+	path := os.Getenv("SIGNALMEOW_BOX_CONFIG")
+	if path == "" {
+		return
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		panic(err)
+	}
+	box = &boxConfig{}
+	if err = json.Unmarshal(data, box); err != nil {
+		panic(err)
+	}
+	// The chat's websocket is HTTP/1.1 (RFC 6455's upgrade, which coder/websocket does), and the
+	// box's omnibus port, desktop-config.json's serverUrl, answers only HTTP/2 (libsignal-net's
+	// websockets, gRPC): Jetty's HTTP/1.1 port is the one libsignal-service uses, and the pod
+	// names it in SIGNALMEOW_BOX_CHAT_HOST (testbox/signalmeow/pod.yaml). gRPC stays on the
+	// omnibus port.
+	APIHostname = hostOf(box.ServerURL)
+	if chat := os.Getenv("SIGNALMEOW_BOX_CHAT_HOST"); chat != "" {
+		APIHostname = chat
+	}
+	StorageHostname = hostOf(box.StorageURL)
+	ResourcesHostname = hostOf(box.ResourcesURL)
+	CDN1Hostname = hostOf(box.CDN["0"])
+	CDN2Hostname = hostOf(box.CDN["2"])
+	CDN3Hostname = hostOf(box.CDN["3"])
+	CDNHosts = []string{CDN1Hostname, CDN1Hostname, CDN2Hostname, CDN3Hostname}
+	GRPCTarget = "dns:///" + hostOf(box.ServerURL)
+	// Only the box's CA: nothing else is reachable anyway.
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM([]byte(box.CertificateAuthority)) {
+		panic("box config: no certificate in certificateAuthority")
+	}
+	SignalCertPool = pool
+	SignalTLSConfig.RootCAs = pool
+	libsignalgo.ProdTrustRoots = libsignalgo.NewTrustRoots(box.ServerTrustRoots)
+}
+
+// BoxServerPublicParams is the zkgroup server public parameters: the box's when
+// SIGNALMEOW_BOX_CONFIG is set, `prod` otherwise.
+func BoxServerPublicParams(prod []byte) []byte {
+	if box == nil {
+		return prod
+	}
+	params, err := base64.StdEncoding.DecodeString(box.ServerPublicParams)
+	if err != nil {
+		panic(err)
+	}
+	return params
+}
