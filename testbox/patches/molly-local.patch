+      buildConfigField("String", "BACKUP_SERVER_PUBLIC_PARAMS", quoted("backup_server_public_params"))
+      buildConfigField("String", "SIGNAL_CAPTCHA_URL", quoted("captcha_url"))
+      buildConfigField("String", "RECAPTCHA_PROOF_URL", quoted("captcha_url"))
+      buildConfigField("String", "LIBSIGNAL_LOCAL_ROOT_CERT", quoted("root_certificate_der"))
+      buildConfigField("int", "LIBSIGNAL_LOCAL_PORT", local["chat_port"]?.toString() ?: "0")
