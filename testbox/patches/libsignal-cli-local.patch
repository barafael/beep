     this.connectionManager = new ConnectionManager(env, userAgent, remoteConfig, buildVariant);
   }
 
+  private Network(ConnectionManager connectionManager) {
+    this.tokioAsyncContext = new TokioAsyncContext();
+    this.connectionManager = connectionManager;
+  }
+
+  /**
+   * A network for a server on {@code localhost}, trusting {@code rootCertificateDer}: the Java
+   * counterpart of Node's {@code localTestServer} option. Needs the testing library
+   * (signal_jni_testing).
+   *
+   * <p>{@code httpVersion} is 1 or 2.
+   */
+  public static Network localTestServer(
+      String userAgent,
+      int chatPort,
+      int cdsiPort,
+      int svr2Port,
+      int svrBPort,
+      byte[] rootCertificateDer,
+      int httpVersion) {
+    return new Network(
+        new ConnectionManager(
+            NativeTesting.TESTING_ConnectionManager_newLocalOverride(
+                userAgent, chatPort, cdsiPort, svr2Port, svrBPort, rootCertificateDer, httpVersion),
+            // Only key transparency reads it; the local environment has no key transparency.
+            Environment.STAGING));
+  }
+
   /**
    * Get the SVR-B (Secure Value Recovery for Backups) service for this network instance.
    *
