# presage-cli (the primary devices) and testbox/stickers (seeds and installs a sticker pack on
# one): built in a toolchain stage, kept on Debian with what they link against. The
# build context is the repository, for the sticker tool's sources.
FROM docker.io/library/rust:1-trixie@sha256:e259494b14672950a909b4c54527e19d29cae6ebf980672114c8bb85e5594e4a AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang cmake git pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# presage at the revision b33p pins (Cargo.toml). presage itself pins upstream libsignal-service,
# which has no servers of one's own (`SignalServers::Custom`); b33p's Cargo.toml patches it to
# its fork, and so does this build, through `--config` for this build only.
ARG PRESAGE_REV=860ca7262f9fa0733342eb944cc8d911ba01e0f4
ARG LIBSIGNAL_SERVICE_REV=ab23dc470ce48e4d1994552e0050117df66fb584
# b33p's SQLCipher too (Cargo.toml's libsqlite3-sys): presage's own still tears SQLCipher down at
# exit, and presage-cli, exiting while a connection was still in use, crashed in OPENSSL_cleanup.
ARG RUSQLITE_REV=3475a314b4c98bcc006eb8143de5ef7bfeda8cbb
RUN git init -q /opt/presage && cd /opt/presage \
    && git fetch -q --depth 1 https://github.com/barafael/presage "$PRESAGE_REV" \
    && git checkout -q FETCH_HEAD

# Its lock as that patch has it (testbox/presage/presage-cli.lock: presage's own, updated only for
# the patch, `cargo metadata` with the same `--config`), so the build is `--locked` too.
COPY testbox/presage/presage-cli.lock /opt/presage/Cargo.lock
# The target cache is the host's, shared by every worktree's and every box's builds: locked, so
# that one build at a time writes it and copies out what it built.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/opt/presage/target,sharing=locked \
    cd /opt/presage \
    && cargo build --release --locked -p presage-cli \
        --config 'patch."https://github.com/whisperfish/libsignal-service-rs".libsignal-service.git="https://github.com/barafael/libsignal-service-rs"' \
        --config "patch.\"https://github.com/whisperfish/libsignal-service-rs\".libsignal-service.rev=\"$LIBSIGNAL_SERVICE_REV\"" \
        --config 'patch.crates-io.libsqlite3-sys.git="https://github.com/barafael/rusqlite"' \
        --config "patch.crates-io.libsqlite3-sys.rev=\"$RUSQLITE_REV\"" \
    && cp target/release/presage-cli /usr/local/bin/

# On the same presage and libsignal-service as b33p; its own workspace and lock file, built into
# presage-cli's target directory, so that what both compile alike is compiled once.
COPY testbox/tools /src/testbox/tools
COPY testbox/stickers /src/testbox/stickers
# The target cache is the host's, shared by every worktree's and every box's builds: locked, so
# that one build at a time writes it and copies out what it built; the sources touched first, as
# cargo goes by modification times, and another tree's later build would look newer than these.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/opt/presage/target,sharing=locked \
    find /src/testbox/tools /src/testbox/stickers -path '*/target' -prune -o -type f -exec touch {} + \
    && cargo build --release --locked --manifest-path /src/testbox/stickers/Cargo.toml \
        --target-dir /opt/presage/target \
    && cp /opt/presage/target/release/testbox-stickers /usr/local/bin/

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
# libssl for libcrypto (presage's store); curl for the checks' egress probe.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libssl3t64 \
    && rm -rf /var/lib/apt/lists/*
# The sticker tool on its own: it changes more often than presage-cli.
COPY --from=build /usr/local/bin/presage-cli /usr/local/bin/
COPY --from=build /usr/local/bin/testbox-stickers /usr/local/bin/
