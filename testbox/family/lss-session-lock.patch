+/// A session is read, stepped and written back by one decryption or one encryption at a time:
+/// two at once (an envelope arriving as a message goes out) each start from the same state and the
+/// later write takes the earlier step back, so the sender's next message reuses a counter and the
+/// receiver's fails ("Key already requested", "MAC verification failed").
+pub(crate) static SESSION_LOCK: std::sync::LazyLock<futures::lock::Mutex<()>> =
+    std::sync::LazyLock::new(|| futures::lock::Mutex::new(()));
+
+
 /// Decrypts incoming messages and encrypts outgoing messages.
 ///
 /// Equivalent of SignalServiceCipher in Java.
@@ -113,7 +121,11 @@ where
                 .expect("valid protocol address name");
 
         if envelope.content.is_some() {
-            let plaintext = self.decrypt(&envelope, csprng).await?;
+            let plaintext = {
+                // One step on a session at a time (see `SESSION_LOCK`).
+                let _step = SESSION_LOCK.lock().await;
+                self.decrypt(&envelope, csprng).await?
+            };
             let was_plaintext = plaintext.metadata.was_plaintext;
 
