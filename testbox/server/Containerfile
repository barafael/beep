# Signal-Server's test mode (TESTING.md "feature-limited test mode"), run as WhisperServerService
# on the test classpath so that the `type: local` / `type: stub` factories resolve, with the
# secrets bundle generated by testbox/tools `provision` instead of the test bundle LocalWhisperServerService
# hard-codes (LocalWhisperServerService.java:26).

# Signal-Server compiles for Java 26 (pom.xml `<release>26</release>`), which Debian doesn't ship:
# Temurin's, copied from its pinned images onto Debian: the JDK to build, the JRE to run.
FROM docker.io/library/eclipse-temurin:26-jdk@sha256:5fa7cdf9a7dc28f66fc2932a5db067f8c4bbde3916e45ef2ace491f466eff691 AS jdk
FROM docker.io/library/eclipse-temurin:26-jre@sha256:29bf04be41c6657015cf0d772e44a0d2dd5d56da2541ae0ca1de08486ad9ee3f AS jre

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS build
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH
# unzip: without it mvnw fetches the .tar.gz but checks it against the .zip's distributionSha256Sum.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
    && rm -rf /var/lib/apt/lists/*

ARG SIGNAL_SERVER_REV=ccc22f9ac4799b8e5a89587f8ff4e5266e3682ef
WORKDIR /src
RUN git init -q . \
    && git fetch -q --depth 1 https://github.com/signalapp/Signal-Server "$SIGNAL_SERVER_REV" \
    && git checkout -q FETCH_HEAD

# exclude-spam-filter: the spam filter is the server's closed component (.github/workflows/test.yml).
# One reactor run: the parent pom skips `install` (pom.xml maven-install-plugin `<skip>true</skip>`),
# so websocket-resources resolves only from the reactor.
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -q -e --strict-checksums -Pexclude-spam-filter -DskipTests -pl service -am \
        package dependency:copy-dependencies -DincludeScope=test -DoutputDirectory=/out/lib \
    && ./mvnw -B -q -e --strict-checksums -Pexclude-spam-filter -pl service download:wget@install-foundationdb-client-library \
    && cp -r service/target/classes /out/classes \
    && cp -r service/target/test-classes /out/test-classes \
    && cp service/target/jib-extra/usr/lib/libfdb_c.so /out/libfdb_c.x86_64.so

# The entrypoint, from the repository (the build context): protoc for libsignal's protobufs.
FROM docker.io/library/rust:1-trixie@sha256:e259494b14672950a909b4c54527e19d29cae6ebf980672114c8bb85e5594e4a AS tools
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY testbox/tools testbox/tools
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/testbox/tools/target \
    cargo build --release --locked --manifest-path testbox/tools/Cargo.toml \
        --features provision --bin provision --bin with-display \
    && cp testbox/tools/target/release/provision testbox/tools/target/release/with-display \
        /usr/local/bin/

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS runtime
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH

COPY --from=build /out/lib /opt/signal/lib
COPY --from=build /out/classes /opt/signal/classes
COPY --from=build /out/test-classes /opt/signal/test-classes
# Where Signal-Server's CI puts it (.github/workflows/test.yml, "Download and install FoundationDB
# client"), and the name fdb-java loads (`UnsatisfiedLinkError: libfdb_c.so` without it).
COPY --from=build /out/libfdb_c.x86_64.so /usr/lib/libfdb_c.x86_64.so
RUN ln -s libfdb_c.x86_64.so /usr/lib/libfdb_c.so
COPY --from=tools /usr/local/bin/provision /usr/local/bin/provision
# For the Desktop image, whose build context is testbox/desktop: built here, on the same Debian.
COPY --from=tools /usr/local/bin/with-display /usr/local/bin/with-display

ENV SIGNAL_CLASSPATH=/opt/signal/classes:/opt/signal/test-classes:/opt/signal/lib/*

# The box's keys, generated once here: the Android image builds its APK for them, and
# the pod's init container copies them into the keys volume.
FROM runtime AS keys
RUN mkdir /keys && provision keys

FROM runtime
COPY --from=keys /keys /opt/testbox/keys
ENTRYPOINT ["provision"]
