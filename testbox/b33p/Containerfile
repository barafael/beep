# b33p for the box, from the working tree, as b33p's CI and release builds build it (Debian 12,
# glibc 2.36, Qt 6.4: .github/workflows/ci.yml's image, .devcontainer/install-deps.sh), run in
# Debian 13 as the box's other images, whose Qt 6.8 runs what Qt 6.4 built. The build context is
# the repository; .containerignore leaves out build output and .git.

# The server's image, which `cargo testbox` builds first, of its box (`--build-arg SERVER`).
ARG SERVER=localhost/b33p-testbox-server
FROM ${SERVER} AS server

FROM docker.io/library/rust:1-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS build
COPY .devcontainer/install-deps.sh /tmp/
RUN sh /tmp/install-deps.sh && rm -rf /var/lib/apt/lists/* /tmp/install-deps.sh
WORKDIR /src
COPY . .
# The crates with network, then the build without: its build scripts reach nothing, and see
# nothing of the host but this copy of the tree.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo fetch --locked --target x86_64-unknown-linux-gnu
# `dev` as the checks' own builds, or `testbox` (`cargo testbox up --optimized`): optimized as b33p
# ships, with the debug assertions `test-servers` needs (Cargo.toml).
ARG PROFILE=dev
# The target cache is the host's, shared by every worktree's and every box's builds: locked, so
# that one build at a time writes it and copies out what it built; the sources touched first, as
# cargo goes by modification times, and another tree's later build would look newer than these.
RUN --network=none \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=locked \
    find . -path ./target -prune -o -type f -exec touch {} + \
    && cargo build --offline --locked --profile "$PROFILE" -p b33p-slint \
        --features harness,test-servers \
    && cp "target/$([ "$PROFILE" = dev ] && echo debug || echo "$PROFILE")/b33p" /usr/local/bin/b33p

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
# What b33p links against, and Qt's Wayland platform plugin (QT_QPA_PLATFORM); cage, wayvnc and
# wlr-randr for its display (testbox/tools `with-display`). An emoji font, as a desktop has, for
# reactions in screenshots, and a small CJK one for the tour's Chinese text (Noto CJK is twenty
# times its size). The CA certificates a desktop has: without them reqwest's verifier
# (rustls-platform-verifier) finds no roots and no client builds, so b33p's and presage's link
# previews never get as far as the network.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libqt6core6t64 libqt6gui6 libqt6widgets6 libqt6dbus6 qt6-qpa-plugins qt6-wayland \
        libasound2t64 libfontconfig1 libwayland-client0 libxkbcommon0 fonts-dejavu-core \
        fonts-noto-color-emoji fonts-wqy-microhei cage wayvnc wlr-randr \
    && rm -rf /var/lib/apt/lists/* \
    && rm /usr/bin/Xwayland
COPY --from=build /usr/local/bin/b33p /usr/local/bin/b33p
COPY --from=server /usr/local/bin/with-display /usr/local/bin/with-display
ENTRYPOINT ["with-display", "/run/view", "1280x900", "--", "b33p"]
