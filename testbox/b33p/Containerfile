# b33p for the box, from the working tree, as b33p's CI and release builds build it (Debian 12,
# glibc 2.36, Qt 6.4: .github/workflows/ci.yml's image, .devcontainer/install-deps.sh), run in
# Debian 12 with Qt's runtime libraries. The build context is the repository; .containerignore
# leaves out build output and .git.
FROM docker.io/library/rust:1-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS build
COPY .devcontainer/install-deps.sh /tmp/
RUN sh /tmp/install-deps.sh && rm -rf /var/lib/apt/lists/* /tmp/install-deps.sh
WORKDIR /src
COPY . .
# The crates with network, then the build without: its build scripts reach nothing, and see
# nothing of the host but this copy of the tree.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo fetch --locked --target x86_64-unknown-linux-gnu \
    && cargo fetch --locked --manifest-path testbox/tools/Cargo.toml
# `dev` as the checks' own builds, or `release` (`cargo testbox up --release`) as b33p ships.
ARG PROFILE=dev
RUN --network=none \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --offline --locked --profile "$PROFILE" -p b33p-slint \
        --features harness,test-servers \
    && cp "target/$([ "$PROFILE" = dev ] && echo debug || echo "$PROFILE")/b33p" /usr/local/bin/b33p
# `with-display` built here, on the Debian it runs on: the other images' is trixie's.
RUN --network=none \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/testbox/tools/target \
    cargo build --offline --locked --release --manifest-path testbox/tools/Cargo.toml \
        --bin with-display \
    && cp testbox/tools/target/release/with-display /usr/local/bin/with-display

FROM docker.io/library/debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
# What b33p links against, and the Qt platform plugins (xcb in the box: QT_QPA_PLATFORM); Xvnc
# and vncconfig for its display. An emoji font, as a desktop has, for reactions in screenshots.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libqt6core6 libqt6gui6 libqt6widgets6 libqt6dbus6 qt6-qpa-plugins \
        libasound2 libfontconfig1 libwayland-client0 libxkbcommon0 fonts-dejavu-core \
        fonts-noto-color-emoji \
        tigervnc-standalone-server tigervnc-tools \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/b33p /usr/local/bin/b33p
COPY --from=build /usr/local/bin/with-display /usr/local/bin/with-display
ENTRYPOINT ["with-display", "/run/view/vnc", "1280x900", "--", "b33p"]
