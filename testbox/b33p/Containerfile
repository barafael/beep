# b33p for the box, from the working tree, as b33p's CI and release builds build it (Debian 12,
# glibc 2.36: .github/workflows/ci.yml's image, .devcontainer/install-deps.sh), run in Debian 13
# as the box's other images. The build context is the repository; .containerignore leaves out
# build output and .git.
#
# `--build-arg UI=gpui` (`cargo testbox --ui gpui`) builds b33p-gpui, the window drawn with GPUI,
# in place of b33p-slint: either way the binary is /usr/local/bin/b33p, which the box runs.

# The server's image, which `cargo testbox` builds first, of its box (`--build-arg SERVER`).
ARG SERVER=localhost/b33p-testbox-server
FROM ${SERVER} AS server

FROM docker.io/library/rust:1-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS build
COPY .devcontainer/install-deps.sh /tmp/
RUN sh /tmp/install-deps.sh && rm -rf /var/lib/apt/lists/* /tmp/install-deps.sh
WORKDIR /src
COPY . .
# The crates with network, then the build without: its build scripts reach nothing, and see
# nothing of the host but this copy of the tree.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    cargo fetch --locked --target x86_64-unknown-linux-gnu
# Slint's Skia renderer: skia-bindings' build script downloads Skia's prebuilt binaries, which the
# build below can't. They come with the crates instead, for the skia-bindings Cargo.lock names and
# the features b33p builds it with (the key), and the build reads them from the file. A new
# version or feature set fails here, or in the build with the key it wants in its URL.
ARG SKIA_TAG=0.157.0
ARG SKIA_KEY=30669978c3f39a73e8a7-x86_64-unknown-linux-gnu-ganesh-gl-jpegd-jpege-pdf-vulkan
ARG SKIA_SHA256=6e3dbc01dd725d31598513f24a3eb4cdd161eaf7530d355839f4447f01f94fbc
RUN if ! grep -A1 '^name = "skia-bindings"' Cargo.lock | grep -qx "version = \"$SKIA_TAG\""; then \
        echo "Cargo.lock's skia-bindings isn't $SKIA_TAG: update SKIA_TAG, SKIA_KEY and SKIA_SHA256"; \
        exit 1; \
    fi \
    && mkdir -p "/opt/skia-binaries/$SKIA_TAG" \
    && curl -fsSL -o "/opt/skia-binaries/$SKIA_TAG/skia-binaries-$SKIA_KEY.tar.gz" \
        "https://github.com/rust-skia/skia-binaries/releases/download/$SKIA_TAG/skia-binaries-$SKIA_KEY.tar.gz" \
    && echo "$SKIA_SHA256  /opt/skia-binaries/$SKIA_TAG/skia-binaries-$SKIA_KEY.tar.gz" | sha256sum -c -
ENV SKIA_BINARIES_URL=file:///opt/skia-binaries/{tag}/skia-binaries-{key}.tar.gz
# `dev` as the checks' own builds, or `testbox` (`cargo testbox up --optimized`): optimized as b33p
# ships, with the debug assertions `test-servers` needs (Cargo.toml).
ARG PROFILE=dev
# `slint` or `gpui`: which window b33p is.
ARG UI=slint
# The target cache is the host's, shared by every worktree's and every box's builds: locked, so
# that one build at a time writes it and copies out what it built; the sources touched first, as
# cargo goes by modification times, and another tree's later build would look newer than these.
RUN --network=none \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=locked \
    find . -path ./target -prune -o -type f -exec touch {} + \
    && cargo build --offline --locked --profile "$PROFILE" -p "b33p-$UI" \
        --features harness,test-servers \
    && cp "target/$([ "$PROFILE" = dev ] && echo debug || echo "$PROFILE")/$([ "$UI" = gpui ] && echo b33p-gpui || echo b33p)" /usr/local/bin/b33p

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
# What b33p links against; cage, wayvnc and wlr-randr for its display (testbox/tools
# `with-display`). An emoji font, as a desktop has, for
# reactions in screenshots, and a small CJK one for the tour's Chinese text (Noto CJK is twenty
# times its size). The CA certificates a desktop has: without them reqwest's verifier
# (rustls-platform-verifier) finds no roots and no client builds, so b33p's and presage's link
# previews never get as far as the network.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libasound2t64 libfontconfig1 libwayland-client0 libxkbcommon0 fonts-dejavu-core \
        fonts-noto-color-emoji fonts-wqy-microhei cage wayvnc wlr-randr \
    && rm -rf /var/lib/apt/lists/* \
    && rm /usr/bin/Xwayland
# Both windows draw with Vulkan (b33p-slint with Skia, which falls back to OpenGL if there is no
# Vulkan driver; GPUI), and the box has no GPU: Mesa's software one (lavapipe).
RUN apt-get update && apt-get install -y --no-install-recommends \
        mesa-vulkan-drivers libvulkan1 \
    && rm -rf /var/lib/apt/lists/*
# GPUI's X11 backend loads the X11 libraries even where Wayland is what runs.
ARG UI=slint
RUN if [ "$UI" = gpui ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            libxkbcommon-x11-0 libxcb1 libxcb-xkb1 libx11-6 \
            fonts-noto-core \
        && rm -rf /var/lib/apt/lists/*; \
    fi
COPY --from=build /usr/local/bin/b33p /usr/local/bin/b33p
COPY --from=server /usr/local/bin/with-display /usr/local/bin/with-display
ENTRYPOINT ["with-display", "/run/view", "1280x900", "--", "b33p"]
