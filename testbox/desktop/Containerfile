# Signal-Desktop from source at the pin, run the way its mock-server tests run it
# (.github/workflows/ci.yml "Run mock server tests"): `pnpm install --frozen-lockfile`,
# `pnpm run generate`, then Electron with ci.js and SIGNAL_CI_CONFIG on a display of its own,
# which `cargo testbox vnc` can show. The image keeps
# what runs: the built app with its production dependencies, and Electron and Playwright for the
# driver at the versions Desktop's package.json names. Node and pnpm at the versions its
# `devEngines` names.
# Electron's runtime libraries (libpulse0 as ci.yml's `xvfb libpulse0`): the build stage runs
# Electron too (`generate`'s `build:db-schema`).
ARG ELECTRON_LIBS="libpulse0 libgtk-3-0t64 libnss3 libasound2t64 libgbm1 libxss1 libxkbcommon0 \
    libdrm2 libatk-bridge2.0-0t64 libcups2t64 libxcomposite1 libxdamage1 libxrandr2 libxshmfence1"
FROM docker.io/library/node:24.21.0-trixie-slim@sha256:c83040f7e24bacea68e58a0b96a484ba430bf24abb2973eab7ba4701144b7b63 AS build
# Build tools for the native modules Electron's app-deps step rebuilds.
ARG ELECTRON_LIBS
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ \
        $ELECTRON_LIBS \
    && rm -rf /var/lib/apt/lists/*
# pnpm as its package names it, by checksum (npm's published integrity for 11.24.0 is this
# tarball's).
ADD --checksum=sha256:d1eab2433172661cc36a18ec85fce93f771db1962717329cc01ec9c2824ca24f \
    https://registry.npmjs.org/pnpm/-/pnpm-11.24.0.tgz /tmp/pnpm.tgz
RUN npm install -g --no-fund --no-audit /tmp/pnpm.tgz && rm /tmp/pnpm.tgz
ARG SIGNAL_DESKTOP_REV=f3040f3e13b6dca5021c3db149320e0f7a771f0a
WORKDIR /opt/signal-desktop
RUN git init -q . \
    && git fetch -q --depth 1 https://github.com/signalapp/Signal-Desktop "$SIGNAL_DESKTOP_REV" \
    && git checkout -q FETCH_HEAD
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/root/.cache \
    pnpm install --frozen-lockfile
# The Electron binary, a step of its own as in .github/actions/setup/action.yml "Install electron".
RUN --mount=type=cache,target=/root/.cache ./node_modules/.bin/install-electron
RUN pnpm run generate
# Desktop's dev dependencies that its CI entry point and app load at run time: `config` (ci.js) and
# `@napi-rs/canvas` (rolldown.config.ts `external`, with Desktop's patch), each with what it
# depends on, from Desktop's own tree as its lockfile has them: pnpm's link to a package leads to
# the directory that holds it and its dependencies side by side.
RUN mkdir -p /opt/runtime/node_modules \
    && for package in config @napi-rs/canvas; do \
        holder="$(realpath "node_modules/$package")" \
        && case "$package" in */*) holder="$(dirname "$holder")" ;; esac \
        && cp -rL "$(dirname "$holder")"/. /opt/runtime/node_modules/ \
        && test -d "/opt/runtime/node_modules/$package" || exit 1; \
    done
# What ci.js runs from: the bundles and the production dependencies (the native modules, built by
# the install above); the sources and the history stay here. Without scripts: the workspace
# packages' would rebuild with the tools the prune removes.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm prune --prod --ignore-scripts --config.confirmModulesPurge=false \
    && rm -rf .git ts sticker-creator
# The driver's Electron and Playwright are Desktop's dev dependencies too: deno.json names them at
# Desktop's versions, which this checks (after the prune, which keeps package.json: a deno.json
# change doesn't redo it).
COPY deno.json /tmp/deno.json
RUN node -e ' \
    const desktop = require("./package.json").devDependencies; \
    const imports = require("/tmp/deno.json").imports; \
    for (const [name, wanted] of [["electron", "electron"], ["playwright-core", "playwright"]]) { \
      const ours = imports[name], theirs = `npm:${name}@${desktop[wanted]}`; \
      if (ours !== theirs) throw new Error(`deno.json has ${ours}, Desktop ${theirs}`); \
    }'

# The driver's packages from deno.lock, the Electron binary a step of its own as in
# Desktop's setup (`install-electron`). A stage apart from the driver, which changes more often.
FROM docker.io/denoland/deno:bin-2.9.8@sha256:87522ebf680b22dc868397ca9d66f21e8de39a73e7fe918c43cd775dad5c92ae AS deno
FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS packages
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=deno /deno /usr/local/bin/deno
ENV DENO_DIR=/opt/testbox/deno
WORKDIR /opt/testbox
COPY deno.json deno.lock ./
RUN --mount=type=cache,target=/root/.cache \
    deno install --frozen \
    && deno run --frozen --allow-all node_modules/electron/install.js \
    && test -x node_modules/.deno/electron@44.7.2/node_modules/electron/dist/electron

# The driver formatted, linted and type-checked, or no image.
FROM packages AS driver
COPY driver.ts ./
RUN deno fmt --check driver.ts && deno lint driver.ts && deno check --frozen driver.ts

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG ELECTRON_LIBS
# Electron's runtime libraries (ci.yml's `libpulse0`); cage, wayvnc and wlr-randr for its
# display (testbox/tools `with-display`).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates cage wayvnc wlr-randr $ELECTRON_LIBS \
    && rm -rf /var/lib/apt/lists/* \
    && rm /usr/bin/Xwayland
COPY --from=localhost/b33p-testbox-server /usr/local/bin/with-display /usr/local/bin/with-display
COPY --from=build /opt/signal-desktop /opt/signal-desktop
COPY --from=build /opt/runtime/node_modules /opt/signal-desktop/node_modules
COPY --from=deno /deno /usr/local/bin/deno
COPY --from=packages /opt/testbox /opt/testbox
COPY --from=driver /opt/testbox/driver.ts /opt/testbox/driver.ts
ENV NODE_ENV=production DENO_DIR=/opt/testbox/deno
WORKDIR /opt/testbox
# On its own display. What the driver may do: run Electron (the binary Deno resolves, checked
# above), write where Desktop and Playwright write and its socket is, and connect to localhost
# (Playwright to Electron) and its own socket. That narrows the driver, not Electron: a process it
# runs is outside Deno's checks, and the container is the boundary.
ENTRYPOINT ["with-display", "/run/view", "1280x1024", "--", \
    "deno", "run", "--frozen", "--cached-only", "--allow-env", "--allow-sys", "--allow-read", \
    "--allow-write=/tmp,/home/desktop,/run/b33p", \
    "--allow-run=/opt/testbox/node_modules/.deno/electron@44.7.2/node_modules/electron/dist/electron", \
    "--allow-net=127.0.0.1,localhost,unix:/run/b33p/desktop.sock", \
    "/opt/testbox/driver.ts"]
