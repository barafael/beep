# storage-service and the Bigtable emulator its tests run (google-cloud-bigtable-emulator,
# `BigtableEmulatorExtension`), started in order by testbox/tools `storage`, which creates the
# tables in between. Java 25 as storage-service's `.java-version`
# names, Temurin's, copied onto Debian: the JDK to build, the JRE to run. The build
# context is the repository, for the tools' sources.
FROM docker.io/library/eclipse-temurin:25-jdk@sha256:2d5d5e9b533342a565907c84f47a2ec298c40cde7b13a3ca85d4950fa456a641 AS jdk
FROM docker.io/library/eclipse-temurin:25-jre@sha256:171ffcf2a9ca207dfbc77b825cd3aaf8ab08d6113c086ee11514b965269fde28 AS jre

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f AS build
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
    && rm -rf /var/lib/apt/lists/*
ARG STORAGE_SERVICE_REV=8f37147d5a361b86728bd6b0a63df00cb86483ab
WORKDIR /src
RUN git init -q . \
    && git fetch -q --depth 1 https://github.com/signalapp/storage-service "$STORAGE_SERVICE_REV" \
    && git checkout -q FETCH_HEAD
# The runtime classpath, and of the test classpath only the emulator's jar, at the version the
# tests resolve, for the native binary the box runs as they do (Linux x86_64's).
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -q -e --strict-checksums -DskipTests package dependency:copy-dependencies -DincludeScope=runtime \
        -DoutputDirectory=/out/lib \
    && ./mvnw -B -q -e --strict-checksums dependency:copy-dependencies -DincludeScope=test \
        -DincludeArtifactIds=google-cloud-bigtable-emulator-core -DoutputDirectory=/out/emulator-jar \
    && cp -r target/classes /out/classes \
    && unzip -q -o /out/emulator-jar/google-cloud-bigtable-emulator-core-*.jar \
        'gcloud/bigtable-linux-x86_64/*' -d /out/emulator

FROM docker.io/library/rust:1-trixie@sha256:e259494b14672950a909b4c54527e19d29cae6ebf980672114c8bb85e5594e4a AS tools
WORKDIR /src
COPY testbox/tools testbox/tools
# The target cache is the host's, shared by every worktree's and every box's builds: locked, so
# that one build at a time writes it and copies out what it built; the sources touched first, as
# cargo goes by modification times, and another tree's later build would look newer than these.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/testbox/tools/target,sharing=locked \
    find testbox/tools -path testbox/tools/target -prune -o -type f -exec touch {} + \
    && cargo build --release --locked --manifest-path testbox/tools/Cargo.toml \
        --features storage --bin storage \
    && cp testbox/tools/target/release/storage /usr/local/bin/

FROM docker.io/library/debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH
COPY --from=build /out/classes /opt/storage-service/classes
COPY --from=build /out/lib /opt/storage-service/lib
# The jar keeps no file modes.
COPY --chmod=755 --from=build /out/emulator/gcloud/bigtable-linux-x86_64/platform/bigtable-emulator/cbtemulator /opt/bigtable/cbtemulator
COPY --from=tools /usr/local/bin/storage /usr/local/bin/storage
ENTRYPOINT ["storage"]
