import { Button, ComboBox, LineEdit, ListView, Palette, ScrollView, Spinner } from "std-widgets.slint";
import { Motion, Theme } from "theme.slint";
import { EmojiPicker } from "emoji.slint";
import { ActivityItem, AttachmentItem, CalendarYear, CandidateItem, ConversationItem, MemberItem, MessageItem, RequestAnswer, RingItem, Screen, SearchResult, SharedItem, StickerRow, StoryItem, Confirm } from "types.slint";
import { MuteChoices, TextSelection, TimerChoices } from "globals.slint";
import { Avatar, Banner, Busy, Caption, Chip, ConfirmDialog, Dialog, DialogButtons, DialogLayout, Display, EmptyState, FadeIn, Heading, Hint, Icon, IconButton, PanelHeader, Popover, Pressable, SectionTitle, SendButton, SettingRow, Small, Tab, Title } from "widgets.slint";
import { ConversationMenu, ConversationRow } from "conversation-row.slint";
import { AttachmentView } from "attachment.slint";
import { Bubble } from "bubble.slint";
import { ActivityCalendar, ActivityStrip } from "activity.slint";
import { FailedScreen, LinkScreen, PasswordScreen, SyncingScreen } from "screens.slint";
import { SettingsPage } from "settings.slint";
import { ChatListPane } from "chat-list.slint";
import { StoriesOverlay, GroupDraftDialog, ConfirmPrompt, JoinDialog, ForwardDialog } from "overlays.slint";
import { Account, Prefs, ChatList, OpenChat, Composer, Groups, Panels } from "state.slint";

// What Rust reaches: the window, its data types and the globals it sets.
export * from "types.slint";
export { Motion } from "theme.slint";
export { Playback } from "globals.slint";
export { Account, Prefs, ChatList, OpenChat, Composer, Groups, Panels } from "state.slint";
export { Emojis, EmojiGroup } from "emoji.slint";

export component AppWindow inherits Window {
    // Rust says "MOCK" here when the mock backend runs, since it sends nothing.
    in property <string> window-title: "b33p";
    title: root.window-title;
    icon: @image-url("../assets/b33p.svg");
    min-width: 360px;
    min-height: 480px;
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Theme.surface;

    property <string> confirm-message;

    // By id: the open chat's place in the list changes as chats move. (A global's own
    // changes can't be watched here, so these follow them.)
    property <string> open-chat: ChatList.selected-id;
    changed open-chat => { OpenChat.calendar-open = false; }
    property <length> platform-font-size;
    property <int> chosen-theme: Prefs.theme;
    property <bool> qt: Prefs.qt;
    property <float> font-scale: Prefs.font-scale;

    function apply-settings() {
        Palette.color-scheme = Prefs.qt ? ColorScheme.unknown
            : Prefs.theme == 1 ? ColorScheme.light
            : Prefs.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        root.default-font-size = root.platform-font-size * Prefs.font-scale;
    }
    init => {
        // `default-font-size` reads 0 while unset; `1rem` resolves it to the platform's size.
        root.platform-font-size = 1rem;
        root.apply-settings();
    }
    changed chosen-theme => { root.apply-settings(); }
    changed qt => { root.apply-settings(); }
    changed font-scale => { root.apply-settings(); }

    callback back;
    in-out property <length> sidebar-width: 300px;
    // One pane at a time: the list, or the open chat with a way back. Kept up to date when
    // the width changes rather than bound to it, since the layout depends on it in turn.
    out property <bool> narrow;
    changed width => { root.narrow = root.width < 640px; }
    // Ctrl is held: a click on a message picks it.
    property <bool> pick-held;
    // A key pressed anywhere (its text, and whether Control, Alt and Shift were held): whether
    // it was a shortcut, which Rust then carried out.
    callback shortcut(string, bool, bool, bool) -> bool;
    // The style's accent color, for text Rust formats, e.g. what a search found.
    out property <color> accent: Theme.accent;

    // Copies through a text input, the way Slint reaches the clipboard.
    clipboard := TextInput { visible: false; width: 0; height: 0; }
    function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }

    // Bumped when Esc closed something: what had the focus may be gone with it, and keys would
    // then go nowhere until a click.
    in-out property <int> escaped;
    changed escaped => { keys.focus(); }

    // Shortcuts that work wherever the focus is; see `shortcut`.
    keys := FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;
    capture-key-pressed(event) => {
        if event.text == Key.Control {
            root.pick-held = true;
        }
        // Text selected in a message: Ctrl+C copies it, Esc drops it. (Writing in the composer
        // drops it too, so Ctrl+C there copies the composer's own selection.)
        if TextSelection.owner != -1 {
            if event.modifiers.control && (event.text == "c" || event.text == "C") {
                TextSelection.copy();
                return accept;
            }
            if event.text == Key.Escape {
                TextSelection.clear();
                return accept;
            }
        }
        if root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) {
            return accept;
        }
        return reject;
    }
    capture-key-released(event) => {
        if event.text == Key.Control {
            root.pick-held = false;
        }
        return reject;
    }
    VerticalLayout {
        // Slides down from the top and back: always there, its height following whether there is
        // an error, which it keeps showing while it closes.
        error-banner := Rectangle {
            property <string> error: Account.error;
            property <string> shown: Account.error;
            changed error => {
                if self.error != "" {
                    self.shown = self.error;
                }
            }
            // Long messages wrap, up to a few lines.
            height: Account.error != "" ? min(banner-layout.preferred-height, 96px) : 0px;
            animate height { duration: Motion.normal; easing: ease-out; }
            clip: true;
            visible: self.height > 0px;
            background: Theme.danger;
            banner-layout := HorizontalLayout {
                y: 0;
                height: max(self.preferred-height, 36px);
                padding-left: Theme.space-l;
                padding-right: Theme.space-s;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Theme.space-s;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("@lucide/circle-alert.svg");
                        tint: Theme.on-accent;
                    }
                }
                Text {
                    text: error-banner.shown;
                    color: Theme.on-accent;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                    horizontal-stretch: 1;
                    accessible-role: text;
                    accessible-label: self.text;
                }
                if Account.can-retry-error: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("@lucide/rotate-cw.svg");
                        label: "Try again";
                        tint: Theme.on-accent;
                        clicked => { Account.retry-error(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("@lucide/x.svg");
                        label: "Dismiss";
                        tint: Theme.on-accent;
                        clicked => { Account.dismiss-error(); }
                    }
                }
            }
        }

        if Account.screen == Screen.syncing: SyncingScreen {
            status: Account.sync-status;
            skippable: Account.history-skippable;
            can-start: Account.can-start;
            skip => { Account.skip-history(); }
            start => { Account.start-chats(); }
        }

        if Account.screen == Screen.password: PasswordScreen {
            // Ready to type into.
            init => { self.focus(); }
            new: Account.password-new;
            error: Account.password-error;
            unlock(password, confirmation) => { Account.unlock(password, confirmation); }
            forgot => { Account.confirm = Confirm.start-over; }
        }

        if Account.screen == Screen.failed: FailedScreen {
            message: Account.failed-message;
            can-retry: Account.can-retry;
            can-start-over: Account.can-start-over;
            can-use-password: Account.can-use-password;
            retrying: Account.failed-retrying;
            retry => { Account.retry(); }
            start-over => { Account.confirm = Confirm.start-over; }
            use-password => { Account.use-password(); }
            open-data-folder => { Account.open-data-folder(); }
        }

        if Account.screen == Screen.link: LinkScreen {
            qr: Account.link-qr;
            device-name <=> Account.device-name;
            rename-device(name) => { Account.rename-device(name); }
        }

        if Account.screen == Screen.chats: FadeIn {
            HorizontalLayout {
                // Sidebar: the whole window when narrow and nothing is open.
                if !root.narrow || (ChatList.selected-id == "" && !Prefs.settings-open): ChatListPane {
                    narrow: root.narrow;
                    sidebar-width: root.sidebar-width;
                }
                // The divider; drag it to resize the sidebar.
                if !root.narrow: Rectangle {
                    width: 1px;
                    background: Theme.divider;
                    TouchArea {
                        x: -3px;
                        width: 7px;
                        mouse-cursor: col-resize;
                        moved => {
                            root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 220px, 480px);
                        }
                    }
                }

                if Prefs.settings-open: SettingsPage {
                    horizontal-stretch: 1;
                    qt: Prefs.qt;
                    theme <=> Prefs.theme;
                    widget-style <=> Prefs.widget-style;
                    style-note: Prefs.style-note;
                    text-size <=> Prefs.text-size;
                    animations <=> Prefs.animations;
                    show-avatars <=> Prefs.show-avatars;
                    notifications <=> Prefs.notifications;
                    notification-content <=> Prefs.notification-content;
                    show-activity <=> Prefs.show-activity;
                    show-calendar <=> Prefs.show-calendar;
                    close-to-tray <=> Prefs.close-to-tray;
                    tray-available: Prefs.tray-available;
                    autostart-supported: Prefs.autostart-supported;
                    notifications-supported: Prefs.notifications-supported;
                    macos: Prefs.macos;
                    start-with-system <=> Prefs.start-with-system;
                    read-receipts <=> Prefs.read-receipts;
                    typing-indicators <=> Prefs.typing-indicators;
                    link-previews <=> Prefs.link-previews;
                    sync-to-phone <=> Prefs.sync-to-phone;
                    account: Account.account;
                    device-name <=> Account.device-name;
                    rename-device(name) => { Account.rename-device(name); }
                    version: Account.version;
                    open-url(url) => { Account.open-url(url); }
                    open-log-folder => { Account.open-log-folder(); }
                    changed-settings => { Prefs.settings-changed(); }
                    changed-start-with-system(enabled) => { Prefs.start-with-system-changed(enabled); }
                    opened => { Prefs.settings-opened(); }
                    close => { Prefs.settings-open = false; }
                    unlink => { Account.confirm = Confirm.unlink; }
                }

                // Conversation
                if !Prefs.settings-open && ChatList.selected-id == "" && !root.narrow: Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        spacing: Theme.space-m;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/b33p.svg");
                                width: 88px;
                                height: 88px;
                                opacity: Theme.tertiary;
                                accessible-role: none;
                            }
                        }
                        Text {
                            text: "Pick a chat on the left,\nor search for someone to start a new one.";
                            horizontal-alignment: center;
                            color: Theme.text-tertiary;
                        }
                        Caption {
                            text: Prefs.macos ? "⌘K searches, ⌥↑ and ⌥↓ go through the chats." : "Ctrl+K searches, Alt+↑ and Alt+↓ go through the chats.";
                            horizontal-alignment: center;
                            color: Theme.text-faint;
                        }
                    }
                }
                if !Prefs.settings-open && ChatList.selected-id != "": VerticalLayout {
                    horizontal-stretch: 1;
                    Rectangle {
                        height: Theme.header;
                        // The chat's picture and name open its details; the buttons, above, don't.
                        TouchArea {
                            accessible-role: button;
                            accessible-label: "Details of " + ChatList.current.title;
                            accessible-action-default => { self.clicked(); }
                            mouse-cursor: pointer;
                            clicked => { Groups.open-details(); }
                        }
                        HorizontalLayout {
                            padding-left: root.narrow ? Theme.space-xs : Theme.space-l;
                            padding-right: Theme.space-m;
                            spacing: Theme.space-m;
                            if root.narrow: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("@lucide/arrow-left.svg");
                                    label: "Back";
                                    clicked => { root.back(); }
                                }
                            }
                            Avatar {
                                width: 36px;
                                initials: ChatList.current.initials;
                                tint: ChatList.current.avatar-color;
                                picture: ChatList.current.avatar;
                                y: (parent.height - self.height) / 2;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Title {
                                    text: ChatList.current.title;
                                    overflow: elide;
                                }
                                // Who is typing, or else the subtitle: they cross-fade.
                                if OpenChat.typing != "" || ChatList.current.subtitle != "" || ChatList.current.timer > 0: Rectangle {
                                    height: subtitle-row.preferred-height;
                                    // The last one, so it doesn't go blank while fading out.
                                    property <string> typing: OpenChat.typing;
                                    property <string> shown-typing: OpenChat.typing;
                                    changed typing => {
                                        if self.typing != "" {
                                            self.shown-typing = self.typing;
                                        }
                                    }
                                    Rectangle {
                                        width: parent.width;
                                        opacity: OpenChat.typing == "" ? 1 : 0;
                                        animate opacity { duration: Motion.normal; easing: ease-out; }
                                        subtitle-row := HorizontalLayout {
                                            spacing: Theme.space-xs;
                                            alignment: start;
                                            if ChatList.current.subtitle != "": Small {
                                                text: ChatList.current.subtitle;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                                max-width: self.preferred-width;
                                            }
                                            if ChatList.current.subtitle != "" && ChatList.current.timer > 0: Small { text: "·"; }
                                            if ChatList.current.timer > 0: HorizontalLayout {
                                                spacing: 2px;
                                                accessible-role: text;
                                                accessible-label: "Disappearing messages: " + ChatList.current.timer-label;
                                                VerticalLayout {
                                                    alignment: center;
                                                    Icon {
                                                        source: @image-url("@lucide/timer.svg");
                                                        width: 12px;
                                                        tint: Theme.text-tertiary;
                                                    }
                                                }
                                                Small { text: ChatList.current.timer-label; }
                                            }
                                        }
                                    }
                                    Small {
                                        width: parent.width;
                                        text: parent.shown-typing;
                                        overflow: elide;
                                        color: Theme.accent;
                                        opacity: OpenChat.typing != "" ? 1 : 0;
                                        animate opacity { duration: Motion.normal; easing: ease-out; }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: Theme.space-xs;
                                    if Prefs.show-calendar: IconButton {
                                        icon: @image-url("@lucide/calendar.svg");
                                        label: "Activity calendar";
                                        active: OpenChat.calendar-open;
                                        clicked => {
                                            if OpenChat.calendar-open {
                                                OpenChat.calendar-open = false;
                                            } else {
                                                OpenChat.open-calendar();
                                            }
                                        }
                                    }
                                    IconButton {
                                        icon: @image-url("@lucide/search.svg");
                                        label: "Search this chat";
                                        clicked => {
                                            Panels.chat-search-text = "";
                                            Panels.open-chat-search();
                                        }
                                    }
                                    IconButton {
                                        icon: @image-url("@lucide/ellipsis-vertical.svg");
                                        label: "More";
                                        clicked => { chat-menu.show({ x: chat-menu.width - 240px, y: chat-menu.height - 8px }); }
                                    }
                                }
                            }
                        }
                        chat-menu := ConversationMenu {
                            item: ChatList.current;
                            in-header: true;
                            property <string> id: ChatList.current.id;
                            toggle-pin => { ChatList.toggle-pin(self.id); }
                            move-pin(by) => { ChatList.move-pin(self.id, by); }
                            mark-read(read) => { ChatList.mark-read(self.id, read); }
                            mute(seconds) => { ChatList.mute(self.id, seconds); }
                            archive(archived) => { ChatList.archive(self.id, archived); }
                            block(blocked) => { ChatList.block(self.id, blocked); }
                            show-media => { Panels.open-media(); }
                            show-details => { Groups.open-details(); }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.divider; }
                    }
                    chat-area := Rectangle {
                        vertical-stretch: 1;
                        // A panel covers the messages (search, details, media, the calendar): once it
                        // has faded in, the list under it isn't drawn any more. It keeps its place,
                        // and shows again at once when the panel closes.
                        property <bool> covered: OpenChat.calendar-open || Panels.chat-search-open
                            || Groups.details-open || Panels.media-open;
                        property <bool> list-hidden;
                        changed covered => {
                            if !self.covered { self.list-hidden = false; }
                        }
                        Timer {
                            interval: max(1ms, Motion.normal);
                            running: chat-area.covered && !chat-area.list-hidden;
                            triggered => { chat-area.list-hidden = true; }
                        }
                        // By position in the list: rows differ in height, so it lands near, not on.
                        function jump(index: int) {
                            message-list.content-y = max(message-list.visible-height - message-list.content-height,
                                -index * message-list.content-height / max(1, OpenChat.messages.length));
                            message-list.follow = message-list.content-y <= message-list.visible-height - message-list.content-height + 8px;
                        }
                        HorizontalLayout {
                            // A wheel turn animates the list's scroll, and its `scrolled` comes at
                            // the start, where the position is still the old one: look again once
                            // it has settled, or the end reached by the wheel wouldn't count.
                            settle-timer := Timer {
                                interval: 250ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    message-list.follow = message-list.at-end();
                                }
                            }
                            // The list moves rows itself after they are measured (keeping its first
                            // visible row in place), after `changed content-height` ran: once that
                            // settles, still following means still at the end.
                            end-timer := Timer {
                                interval: 120ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    if message-list.follow {
                                        message-list.content-y = min(0px, message-list.visible-height - message-list.content-height);
                                    }
                                }
                            }
                            jump-timer := Timer {
                                interval: 1ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    message-list.follow = false;
                                    message-list.settling = 6;
                                    message-list.scroll-to-jump();
                                }
                            }
                            load-older-timer := Timer {
                                interval: 1ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    OpenChat.load-older();
                                }
                            }
                            message-list := ListView {
                                visible: !chat-area.list-hidden;
                                // Follow new messages only while the newest one is in view, so reading
                                // older messages isn't interrupted. Opening a chat starts at the bottom.
                                property <bool> follow: true;
                                // By id: the open chat's place in the list changes as chats move.
                                property <string> conversation: ChatList.selected-id;
                                // Back to the left too: a wide row once scrolled sideways would
                                // leave the next chat's rows out of view.
                                changed conversation => {
                                    self.follow = true;
                                    self.content-x = 0;
                                }
                                property <int> scroll-to-end-serial: OpenChat.scroll-to-end-serial;
                                changed scroll-to-end-serial => {
                                    self.follow = true;
                                    self.content-y = min(0px, self.visible-height - self.content-height);
                                }
                                function at-end() -> bool {
                                    self.content-y <= self.visible-height - self.content-height + 8px
                                }
                                // Jumping to a search result: rows have different heights and are only
                                // measured once shown, so the place is estimated from the average and
                                // corrected a few times as they are.
                                property <int> jump-serial: OpenChat.jump-serial;
                                property <int> settling;
                                function scroll-to-jump() {
                                    if OpenChat.messages.length > 0 {
                                        self.content-y = max(self.visible-height - self.content-height,
                                            min(0px, self.visible-height / 3
                                                - OpenChat.jump-row * self.content-height / OpenChat.messages.length));
                                    }
                                }
                                // After the other change handlers: opening a chat (which goes to
                                // its end) can come in the same turn as a jump into it.
                                changed jump-serial => { jump-timer.running = true; }
                                // Messages that came while scrolled away from the end, for the
                                // button that goes there.
                                property <int> appended: OpenChat.appended-total;
                                property <int> seen: OpenChat.appended-total;
                                changed appended => {
                                    if self.follow { self.seen = self.appended; }
                                }
                                changed follow => {
                                    if self.follow { self.seen = self.appended; }
                                }
                                function go-to-end() {
                                    self.follow = true;
                                    self.content-y = min(0px, self.visible-height - self.content-height);
                                    end-timer.running = true;
                                }
                                // Only the user's own scrolling decides; content growing (pictures arriving,
                                // rows being measured) moves the viewport too and must not stop following.
                                scrolled => {
                                    self.follow = self.at-end();
                                    settle-timer.running = true;
                                    if OpenChat.can-load-older && self.content-y > -self.visible-height / 2 {
                                        OpenChat.load-older();
                                    }
                                }
                                changed content-height => {
                                    // Older messages put in above don't move what is shown: the list
                                    // keeps its first visible row in place by itself.
                                    if self.follow {
                                        self.content-y = min(0px, self.visible-height - self.content-height);
                                        end-timer.running = true;
                                    }
                                    // Nothing to scroll yet: there may be more before. Asked for once
                                    // the change handlers ran: Rust changes the rows, which mustn't
                                    // happen while Slint is still running them.
                                    if self.content-height < self.visible-height {
                                        load-older-timer.running = true;
                                    }
                                    if self.settling > 0 {
                                        self.settling -= 1;
                                        self.scroll-to-jump();
                                    }
                                }
                                // E.g. the reply bar opening below.
                                changed visible-height => {
                                    if self.follow {
                                        self.content-y = min(0px, self.visible-height - self.content-height);
                                    }
                                }
                                for item[index] in OpenChat.messages: Bubble {
                                    item: item;
                                    index: index;
                                    reply => {
                                        OpenChat.reply(item.key);
                                        focus-composer-timer.running = true;
                                    }
                                    // Room beside it for the sender's picture and the message's buttons.
                                    max-bubble-width: min(message-list.visible-width * 0.7, message-list.visible-width - 130px);
                                    fetch-attachment(id) => { OpenChat.fetch-attachment(id); }
                                    save-attachment(id) => { OpenChat.save-attachment(id); }
                                    open-attachment(id) => { OpenChat.open-attachment(id); }
                                    open-link(link) => { OpenChat.open-link(link); }
                                    react(emoji) => { OpenChat.react(item.key, emoji); }
                                    retry => { OpenChat.retry-send(item.key); }
                                    edit => {
                                        OpenChat.edit(item.key);
                                        focus-composer-timer.running = true;
                                    }
                                    // For everyone can't be undone: asked first.
                                    delete(everyone) => {
                                        if everyone {
                                            root.confirm-message = item.key;
                                            Account.confirm = Confirm.delete-for-everyone;
                                        } else {
                                            OpenChat.delete(item.key, false);
                                        }
                                    }
                                    copy-text(text) => { root.copy-text(text); }
                                    reveal => { OpenChat.reveal(item.key); }
                                    forward => {
                                        Panels.forward-filter = "";
                                        Panels.forward(item.key);
                                    }
                                    selecting: OpenChat.selected-count > 0;
                                    pick-held: root.pick-held;
                                    toggle-select => { OpenChat.toggle-select(item.key); }
                                    select-through => { OpenChat.select-through(item.key); }
                                }
                            }
                            strip := ActivityStrip {
                                visible: OpenChat.activity.length > 1;
                                width: self.visible ? self.preferred-width : 0px;
                                items: OpenChat.activity;
                                // The average row: the list knows only its estimated total height.
                                property <length> row-height: max(1px, message-list.content-height / max(1, OpenChat.messages.length));
                                top: floor(-message-list.content-y / self.row-height);
                                bottom: floor((message-list.visible-height - message-list.content-y) / self.row-height);
                                jump(index) => { chat-area.jump(index); }
                            }
                        }
                        // Scrolled up: a way back to the newest message, with how many came since.
                        if !message-list.follow && OpenChat.messages.length > 0 && !chat-area.covered: to-end := Popover {
                            property <int> unseen: message-list.appended - message-list.seen;
                            x: parent.width - self.width - strip.width - Theme.space-l;
                            y: parent.height - self.height - Theme.space-l;
                            width: 40px;
                            height: 40px;
                            border-radius: self.height / 2;
                            IconButton {
                                width: parent.width;
                                height: parent.height;
                                icon: @image-url("@lucide/arrow-down.svg");
                                label: parent.unseen > 0 ? "Newest messages, " + parent.unseen + " new" : "Newest messages";
                                clicked => { message-list.go-to-end(); }
                            }
                            if self.unseen > 0: Rectangle {
                                x: parent.width - self.width + 4px;
                                y: -4px;
                                height: 18px;
                                width: max(18px, count.preferred-width + 10px);
                                border-radius: self.height / 2;
                                background: Theme.accent;
                                count := Text {
                                    text: to-end.unseen;
                                    color: Theme.on-accent;
                                    font-size: 1rem * Theme.caption;
                                    font-weight: 700;
                                }
                            }
                        }
                        if OpenChat.calendar-open: ActivityCalendar {
                            years: OpenChat.calendar;
                            summary: OpenChat.calendar-summary;
                            close => { OpenChat.calendar-open = false; }
                            jump(index) => {
                                OpenChat.calendar-open = false;
                                chat-area.jump(index);
                            }
                        }
                    if Panels.chat-search-open: FadeIn {
                        background: Theme.surface;
                        search-timer := Timer {
                            interval: 300ms;
                            running: false;
                            triggered => {
                                self.running = false;
                                Panels.chat-search(Panels.chat-search-text);
                            }
                        }
                        VerticalLayout {
                            PanelHeader {
                                back-label: "Close search";
                                back => {
                                    Panels.close-chat-search();
                                    composer.focus();
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    LineEdit {
                                        placeholder-text: "Search this chat";
                                        text <=> Panels.chat-search-text;
                                        init => { self.focus(); }
                                        // After a pause in typing.
                                        edited => {
                                            search-timer.running = false;
                                            search-timer.running = true;
                                        }
                                        accepted => { Panels.chat-search(self.text); }
                                    }
                                }
                            }
                            if Panels.chat-search-busy: Busy {}
                            if !Panels.chat-search-busy && Panels.chat-search-text != "" && Panels.search-results.length == 0: EmptyState {
                                icon: @image-url("@lucide/search.svg");
                                text: "No messages found.";
                            }
                            if Panels.chat-search-text == "": EmptyState {
                                icon: @image-url("@lucide/search.svg");
                                text: "Search what was written in this chat.";
                            }
                            ListView {
                                vertical-stretch: 1;
                                for result[index] in Panels.search-results: HorizontalLayout {
                                    padding-left: Theme.space-s;
                                    padding-right: Theme.space-s;
                                    Rectangle {
                                        height: result-column.preferred-height;
                                        border-radius: Theme.radius-s;
                                        background: result-touch.pressed ? Theme.pressed
                                            : result-touch.has-hover ? Theme.hover : transparent;
                                        animate background { duration: Motion.fast; easing: ease-out; }
                                        result-column := VerticalLayout {
                                            padding: Theme.space-s;
                                            spacing: 2px;
                                            HorizontalLayout {
                                                spacing: Theme.space-s;
                                                Text {
                                                    text: result.sender;
                                                    font-weight: 600;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                    color: Theme.text;
                                                }
                                                Small { text: result.when; }
                                            }
                                            StyledText {
                                                text: result.snippet;
                                                accessible-role: text;
                                                accessible-label: result.text;
                                                default-color: Theme.text-secondary;
                                            }
                                        }
                                        // Over the text, which would take the clicks for links otherwise.
                                        result-touch := TouchArea {
                                            accessible-role: list-item;
                                            accessible-label: result.sender + ", " + result.when + ": " + result.text;
                                            accessible-action-default => { self.clicked(); }
                                            mouse-cursor: pointer;
                                            clicked => { Panels.show-result(index); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if Groups.details-open: FadeIn {
                        background: Theme.surface;
                        VerticalLayout {
                            PanelHeader {
                                title: ChatList.current.group ? "Group details" : "Details";
                                back => { Groups.close-details(); }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                // A readable column, also in a wide window.
                                HorizontalLayout {
                                alignment: center;
                                padding-left: Theme.space-l;
                                padding-right: Theme.space-l;
                                VerticalLayout {
                                    preferred-width: 520px;
                                    max-width: 520px;
                                    alignment: start;
                                    spacing: Theme.space-m;
                                    padding-top: Theme.space-l;
                                    padding-bottom: Theme.space-xl;
                                    HorizontalLayout {
                                        alignment: center;
                                        Avatar {
                                            width: 96px;
                                            initials: ChatList.current.initials;
                                            tint: ChatList.current.avatar-color;
                                            picture: ChatList.current.avatar;
                                        }
                                    }
                                    Display { text: ChatList.current.title; }
                                    if Groups.details-about != "": Text {
                                        text: Groups.details-about;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        color: Theme.text-secondary;
                                    }
                                    Text {
                                        text: Groups.details-phone != "" ? Groups.details-phone : ChatList.current.subtitle;
                                        horizontal-alignment: center;
                                        color: Theme.text-tertiary;
                                    }
                                    if Groups.details-busy: Busy {}
                                    HorizontalLayout {
                                        alignment: center;
                                        Button {
                                            icon: @image-url("@lucide/image.svg");
                                            colorize-icon: true;
                                            text: "Media, files and links";
                                            clicked => {
                                                Groups.close-details();
                                                Panels.open-media();
                                            }
                                        }
                                    }
                                    // Muting for a while and the timer, here rather than in the
                                    // header's menu (see `ConversationMenu`).
                                    VerticalLayout {
                                        spacing: Theme.space-s;
                                        property <ConversationItem> chat: ChatList.current;
                                        SectionTitle { text: "Chat"; }
                                        SettingRow {
                                            label: "Notifications";
                                            hint: chat.muted ? "Muted" : "";
                                            if chat.muted: Button {
                                                text: "Unmute";
                                                clicked => { ChatList.mute(chat.id, 0); }
                                            }
                                            // In the order of `MuteChoices`, after "On".
                                            if !chat.muted: ComboBox {
                                                width: 200px;
                                                model: ["On", "Off for 1 hour", "Off for 8 hours", "Off for 1 week", "Off"];
                                                current-index: 0;
                                                selected => {
                                                    if self.current-index > 0 {
                                                        ChatList.mute(chat.id, MuteChoices.choices[self.current-index - 1].seconds);
                                                    }
                                                }
                                            }
                                        }
                                        // Only where we can still write: the timer is a message to them.
                                        if !chat.request && !chat.blocked && !chat.left: SettingRow {
                                            label: "Disappearing messages";
                                            hint: chat.timer > 0 && TimerChoices.index-of(chat.timer) < 0 ? "Set to " + chat.timer-label : "";
                                            timer-box := ComboBox {
                                                width: 200px;
                                                model: TimerChoices.labels;
                                                current-index: TimerChoices.index-of(chat.timer);
                                                // Each change is a message to every member: only the one
                                                // stopped at goes, not each passed with the arrows or wheel.
                                                property <int> pending: -1;
                                                property <duration> picked-at;
                                                selected => {
                                                    self.pending = self.current-index;
                                                    self.picked-at = animation-tick();
                                                }
                                            }
                                            Timer {
                                                interval: 100ms;
                                                running: timer-box.pending >= 0;
                                                triggered => {
                                                    if animation-tick() - timer-box.picked-at >= 500ms {
                                                        ChatList.set-timer(chat.id, TimerChoices.seconds[timer-box.pending]);
                                                        timer-box.pending = -1;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if Groups.details-description != "": VerticalLayout {
                                        spacing: Theme.space-xs;
                                        SectionTitle { text: "Description"; }
                                        Text {
                                            text: Groups.details-description;
                                            wrap: word-wrap;
                                            color: Theme.text;
                                        }
                                    }
                                    if Groups.details-safety-number != "": VerticalLayout {
                                        spacing: Theme.space-s;
                                        SectionTitle { text: "Safety number"; }
                                        Hint {
                                            text: "Compare it with the one on their phone, in person or another way you trust. If both match, nobody is in between: your messages are end-to-end encrypted with them.";
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                border-radius: Theme.radius-m;
                                                background: Theme.surface-raised;
                                                border-width: 1px;
                                                border-color: Theme.divider;
                                                HorizontalLayout {
                                                    padding: Theme.space-m;
                                                    Text {
                                                        text: Groups.details-safety-number;
                                                        font-family: "monospace";
                                                        font-size: 1rem * Theme.title;
                                                        color: Theme.text;
                                                    }
                                                }
                                            }
                                        }
                                        if Groups.details-safety-changed: HorizontalLayout {
                                            spacing: Theme.space-s;
                                            VerticalLayout {
                                                alignment: start;
                                                Icon {
                                                    source: @image-url("@lucide/shield-alert.svg");
                                                    tint: Theme.danger-text;
                                                }
                                            }
                                            Text {
                                                text: "Changed since you verified it. This is the new one: compare it with theirs again.";
                                                wrap: word-wrap;
                                                horizontal-stretch: 1;
                                                font-size: 1rem * Theme.body-small;
                                                font-weight: 600;
                                                color: Theme.text;
                                            }
                                        }
                                        if Groups.details-verified: HorizontalLayout {
                                            spacing: Theme.space-s;
                                            alignment: start;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    source: @image-url("@lucide/shield-check.svg");
                                                    tint: Theme.accent;
                                                }
                                            }
                                            Text {
                                                text: "Verified: you compared it with theirs.";
                                                font-size: 1rem * Theme.body-small;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                                color: Theme.accent;
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: Theme.space-s;
                                            Button {
                                                text: "Copy";
                                                clicked => { root.copy-text(Groups.details-safety-number); }
                                            }
                                            Button {
                                                text: Groups.details-verified ? "Clear verification" : "Mark as verified";
                                                clicked => { Groups.set-verified(!Groups.details-verified); }
                                            }
                                        }
                                    }
                                    if ChatList.current.group && !ChatList.current.left: VerticalLayout {
                                        spacing: Theme.space-s;
                                        SectionTitle { text: "Group"; }
                                        HorizontalLayout {
                                            spacing: Theme.space-s;
                                            name-field := LineEdit {
                                                placeholder-text: "Name";
                                                text: ChatList.current.title;
                                                accepted => { Groups.rename-group(self.text); }
                                            }
                                            Button {
                                                text: "Rename";
                                                clicked => { Groups.rename-group(name-field.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.space-s;
                                            description-field := LineEdit {
                                                placeholder-text: "Description";
                                                text: Groups.details-description;
                                                accepted => { Groups.describe-group(self.text); }
                                            }
                                            Button {
                                                text: "Save";
                                                clicked => { Groups.describe-group(description-field.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Change picture…";
                                                clicked => { Groups.change-group-picture(); }
                                            }
                                            if ChatList.current.avatar.width > 0: Button {
                                                text: "Remove picture";
                                                clicked => { Groups.remove-group-picture(); }
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Add members…";
                                                clicked => {
                                                    Groups.group-draft-filter = "";
                                                    Groups.open-add-members();
                                                }
                                            }
                                            Button {
                                                text: "Leave group…";
                                                clicked => { Account.confirm = Confirm.leave-group; }
                                            }
                                        }
                                    }
                                    if ChatList.current.group && !ChatList.current.left: VerticalLayout {
                                        spacing: Theme.space-s;
                                        SectionTitle { text: "Invite link"; }
                                        Hint {
                                            text: "Anyone with the link can join the group, or ask to.";
                                        }
                                        // Who the link lets in, one of three.
                                        if ChatList.current.admin: HorizontalLayout {
                                            alignment: start;
                                            spacing: Theme.space-xs;
                                            for choice[index] in ["Off", "Anyone", "Admins approve"]: Tab {
                                                text: choice;
                                                accessible-role: AccessibleRole.radio-button;
                                                accessible-checked: self.selected;
                                                selected: Groups.details-invite-access == index;
                                                clicked => { Groups.set-invite-link(index); }
                                            }
                                        }
                                        if Groups.details-invite-link != "": HorizontalLayout {
                                            spacing: Theme.space-s;
                                            Rectangle {
                                                border-radius: Theme.radius-m;
                                                background: Theme.surface-raised;
                                                border-width: 1px;
                                                border-color: Theme.divider;
                                                horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    padding: 10px;
                                                    Text {
                                                        text: Groups.details-invite-link;
                                                        overflow: elide;
                                                        font-size: 1rem * Theme.body-small;
                                                        vertical-alignment: center;
                                                        color: Theme.text;
                                                    }
                                                }
                                            }
                                            Button {
                                                text: "Copy";
                                                clicked => { root.copy-text(Groups.details-invite-link); }
                                            }
                                            if ChatList.current.admin: Button {
                                                text: "Reset";
                                                clicked => { Groups.reset-invite-link(); }
                                            }
                                        }
                                    }
                                    if ChatList.current.admin && Groups.details-requests.length > 0: VerticalLayout {
                                        spacing: Theme.space-xs;
                                        SectionTitle { text: Groups.details-requests.length == 1 ? "1 request to join" : Groups.details-requests.length + " requests to join"; }
                                        for person in Groups.details-requests: HorizontalLayout {
                                            spacing: 10px;
                                            padding-top: 2px;
                                            padding-bottom: 2px;
                                            Avatar {
                                                width: 32px;
                                                initials: person.initials;
                                                tint: person.color;
                                            }
                                            Text {
                                                text: person.name;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                color: Theme.text;
                                            }
                                            Button {
                                                text: "Turn down";
                                                clicked => { Groups.answer-join-request(person.id, false); }
                                            }
                                            Button {
                                                text: "Let in";
                                                primary: true;
                                                clicked => { Groups.answer-join-request(person.id, true); }
                                            }
                                        }
                                    }
                                    if Groups.details-members.length > 0: VerticalLayout {
                                        spacing: Theme.space-xs;
                                        SectionTitle { text: Groups.details-members.length + " members"; }
                                        for member in Groups.details-members: HorizontalLayout {
                                            spacing: 10px;
                                            padding-top: 2px;
                                            padding-bottom: 2px;
                                            Avatar {
                                                width: 32px;
                                                initials: member.initials;
                                                tint: member.color;
                                            }
                                            Text {
                                                text: member.name;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                color: Theme.text;
                                            }
                                            if member.admin: Small {
                                                text: "Admin";
                                                vertical-alignment: center;
                                            }
                                            // Not for ourselves, nor where we're no longer in the group.
                                            if member.name != "You" && !ChatList.current.left: VerticalLayout {
                                                alignment: center;
                                                IconButton {
                                                    icon: @image-url("@lucide/ellipsis-vertical.svg");
                                                    label: "Manage " + member.name;
                                                    // Below the button, in the menu area's coordinates
                                                    // (it sits in the layout too, below the button).
                                                    clicked => {
                                                        member-menu.show({
                                                            x: self.x - member-menu.x - 160px,
                                                            y: self.y + self.height - member-menu.y,
                                                        });
                                                    }
                                                }
                                                member-menu := ContextMenuArea {
                                                    enabled: false;
                                                    Menu {
                                                        MenuItem {
                                                            title: member.admin ? "Take admin rights" : "Make admin";
                                                            activated => { Groups.set-member-admin(member.id, !member.admin); }
                                                        }
                                                        MenuItem {
                                                            title: "Remove from group";
                                                            activated => { Groups.remove-member(member.id); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                }
                            }
                        }
                    }
                    if Panels.media-open: FadeIn {
                        background: Theme.surface;
                        VerticalLayout {
                            PanelHeader {
                                title: "Media, files and links";
                                back => { Panels.close-media(); }
                            }
                            HorizontalLayout {
                                padding: Theme.space-m;
                                padding-bottom: Theme.space-s;
                                spacing: Theme.space-xs;
                                alignment: start;
                                for tab[index] in ["Media", "Files", "Links"]: Tab {
                                    text: tab;
                                    selected: index == Panels.media-tab;
                                    clicked => { Panels.media-tab = index; }
                                }
                            }
                            if Panels.media-busy: Busy {}
                            property <bool> empty: Panels.media-tab == 0 ? Panels.media-tiles.length == 0
                                : Panels.media-tab == 1 ? Panels.media-files.length == 0 : Panels.media-links.length == 0;
                            if !Panels.media-busy && self.empty: EmptyState {
                                icon: Panels.media-tab == 0 ? @image-url("@lucide/image.svg") : Panels.media-tab == 1 ? @image-url("@lucide/file.svg") : @image-url("@lucide/link.svg");
                                text: Panels.media-tab == 0 ? "No photos or videos yet." : Panels.media-tab == 1 ? "No files yet." : "No links yet.";
                            }
                            if Panels.media-tab == 0: HorizontalLayout {
                                vertical-stretch: 1;
                                padding-left: Theme.space-m;
                                padding-right: Theme.space-xs;
                              media-list := ListView {
                                // As many tiles across as fit at 110px, stretched to fill the width.
                                property <length> gap: 4px;
                                property <int> columns: max(1, floor((self.visible-width + self.gap) / (110px + self.gap)));
                                property <length> tile: (self.visible-width - (self.columns - 1) * self.gap) / self.columns;
                                for row in floor((Panels.media-tiles.length + media-list.columns - 1) / media-list.columns): HorizontalLayout {
                                    spacing: media-list.gap;
                                    padding-bottom: media-list.gap;
                                    alignment: start;
                                    for column in media-list.columns: Rectangle {
                                        property <int> at: row * media-list.columns + column;
                                        property <AttachmentItem> tile: Panels.media-tiles[self.at];
                                        // The grid's last row may not be full.
                                        visible: self.at < Panels.media-tiles.length;
                                        width: media-list.tile;
                                        height: media-list.tile;
                                        border-radius: Theme.radius-s;
                                        clip: true;
                                        background: Theme.surface-raised;
                                        init => {
                                            if tile.fetch { OpenChat.fetch-attachment(tile.id); }
                                        }
                                        // Pictures on their way, and videos (not downloaded for this); they
                                        // give way to the picture as it fades in (see `AttachmentView`).
                                        if tile.placeholder.width > 0: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: tile.placeholder;
                                            image-fit: cover;
                                            opacity: 1 - tile-picture.opacity;
                                        }
                                        tile-picture := Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: tile.picture;
                                            image-fit: cover;
                                            opacity: tile.picture.width > 0 ? 1 : 0;
                                            animate opacity { duration: Motion.slow; easing: ease-out; }
                                        }
                                        if tile.video: Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: self.height / 2;
                                            background: Theme.scrim;
                                            if tile.gif: Caption {
                                                text: "GIF";
                                                font-weight: 700;
                                                color: Theme.on-stage;
                                            }
                                            if !tile.gif: Icon {
                                                source: @image-url("@lucide/play.svg");
                                                width: 16px;
                                                tint: Theme.on-stage;
                                                x: (parent.width - self.width) / 2 + 1px;
                                            }
                                        }
                                        TouchArea {
                                            accessible-role: button;
                                            accessible-label: tile.video ? "Play video" : "Open picture";
                                            accessible-action-default => { self.clicked(); }
                                            mouse-cursor: pointer;
                                            clicked => { OpenChat.open-attachment(tile.id); }
                                        }
                                    }
                                }
                              }
                            }
                            if Panels.media-tab == 1: ListView {
                                vertical-stretch: 1;
                                for file in Panels.media-files: VerticalLayout {
                                    padding-left: Theme.space-l;
                                    padding-right: Theme.space-l;
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: Theme.space-s;
                                        Small {
                                            text: file.sender;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                            color: Theme.text-secondary;
                                        }
                                        Small { text: file.when; }
                                    }
                                    AttachmentView {
                                        item: file.attachment;
                                        outgoing: false;
                                        fetch(id) => { OpenChat.fetch-attachment(id); }
                                        save(id) => { OpenChat.save-attachment(id); }
                                        open(id) => { OpenChat.open-attachment(id); }
                                    }
                                }
                            }
                            if Panels.media-tab == 2: ListView {
                                vertical-stretch: 1;
                                for link in Panels.media-links: HorizontalLayout {
                                    padding-left: Theme.space-s;
                                    padding-right: Theme.space-s;
                                    Pressable {
                                        height: link-column.preferred-height;
                                        accessible-label: "Open link " + link.url;
                                        clicked => { OpenChat.open-link(link.url); }
                                        link-column := HorizontalLayout {
                                            padding: Theme.space-s;
                                            spacing: Theme.space-m;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon { source: @image-url("@lucide/link.svg"); }
                                            }
                                            VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: link.url;
                                                    overflow: elide;
                                                    color: Theme.accent;
                                                }
                                                Small { text: link.sender + " · " + link.when; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }

                    if Composer.mention-candidates.length > 0: Rectangle {
                        background: Theme.surface-raised;
                        VerticalLayout {
                            padding: 6px;
                            padding-left: 12px;
                            padding-right: 12px;
                            for name[index] in Composer.mention-candidates: Rectangle {
                                height: 30px;
                                border-radius: Theme.radius-s;
                                // The first is what Tab or Enter picks.
                                background: mention-touch.has-hover ? Theme.pressed
                                    : index == 0 ? Theme.selected : transparent;
                                animate background { duration: Motion.fast; easing: ease-out; }
                                mention-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Mention " + name;
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Composer.pick-mention(index);
                                        // Back to writing, after the name.
                                        focus-composer-timer.running = true;
                                    }
                                }
                                Text {
                                    x: 10px;
                                    text: "@" + name;
                                    vertical-alignment: center;
                                    color: Theme.text;
                                }
                            }
                        }
                    }
                    // Slides open and closed: always there, its height following whether it is open.
                    Rectangle {
                        property <bool> open: Composer.editing;
                        height: self.open ? editing-bar.preferred-height : 0px;
                        animate height { duration: Motion.normal; easing: ease-out; }
                        clip: true;
                        visible: self.height > 0px;
                        background: Theme.surface-raised;
                        // At the bottom, so it rises out of the composer.
                        editing-bar := HorizontalLayout {
                            y: parent.height - self.height;
                            height: self.preferred-height;
                            padding-left: Theme.space-l;
                            padding-right: Theme.space-s;
                            padding-top: 6px;
                            spacing: Theme.space-s;
                            Rectangle {
                                width: 3px;
                                border-radius: self.width / 2;
                                background: Theme.accent;
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("@lucide/square-pen.svg");
                                    width: Theme.icon-small;
                                    tint: Theme.accent;
                                }
                            }
                            Text {
                                text: "Editing message";
                                font-size: 1rem * Theme.body-small;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: Theme.text;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("@lucide/x.svg");
                                    label: "Stop editing";
                                    tint: Theme.text-tertiary;
                                    clicked => { Composer.cancel-edit(); }
                                }
                            }
                        }
                    }
                    // Slides open and closed: always there, its height following whether it is open.
                    reply-slot := Rectangle {
                        property <bool> open: Composer.reply-author != "" || Composer.reply-text != "";
                        // What it showed, kept while it closes.
                        property <string> author: Composer.reply-author;
                        property <string> text: Composer.reply-text;
                        property <string> shown-author: Composer.reply-author;
                        property <string> shown-text: Composer.reply-text;
                        changed author => { if self.open { self.shown-author = self.author; } }
                        changed text => { if self.open { self.shown-text = self.text; } }
                        height: self.open ? reply-bar.preferred-height : 0px;
                        animate height { duration: Motion.normal; easing: ease-out; }
                        clip: true;
                        visible: self.height > 0px;
                        background: Theme.surface-raised;
                        // At the bottom, so it rises out of the composer.
                        reply-bar := HorizontalLayout {
                            y: parent.height - self.height;
                            height: self.preferred-height;
                            padding-left: Theme.space-l;
                            padding-right: Theme.space-s;
                            padding-top: 6px;
                            spacing: Theme.space-s;
                            Rectangle {
                                width: 3px;
                                border-radius: self.width / 2;
                                background: Theme.accent;
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("@lucide/reply.svg");
                                    width: Theme.icon-small;
                                    tint: Theme.accent;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: "Replying to " + reply-slot.shown-author;
                                    font-size: 1rem * Theme.small;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                                Text {
                                    text: reply-slot.shown-text;
                                    font-size: 1rem * Theme.body-small;
                                    overflow: elide;
                                    color: Theme.text-secondary;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("@lucide/x.svg");
                                    label: "Stop replying";
                                    tint: Theme.text-tertiary;
                                    clicked => { Composer.cancel-reply(); }
                                }
                            }
                        }
                    }
                    // Files waiting to go out with the next message.
                    if Composer.staged.length > 0: HorizontalLayout {
                        padding-left: Theme.space-m;
                        padding-right: Theme.space-m;
                        padding-top: Theme.space-s;
                        spacing: 6px;
                        alignment: start;
                        for name[index] in Composer.staged: Chip {
                            // Fades in as it appears.
                            opacity: 0;
                            init => { self.opacity = 1; }
                            animate opacity { duration: Motion.normal; easing: ease-out; }
                            height: 28px;
                            width: staged-row.preferred-width + Theme.space-m;
                            staged-row := HorizontalLayout {
                                x: 10px;
                                width: parent.width - 12px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: @image-url("@lucide/paperclip.svg");
                                        width: Theme.icon-small;
                                    }
                                }
                                Text {
                                    text: name;
                                    font-size: 1rem * Theme.body-small;
                                    vertical-alignment: center;
                                    color: Theme.text;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: @image-url("@lucide/x.svg");
                                        label: "Remove " + name;
                                        tint: Theme.text-tertiary;
                                        width: 24px;
                                        height: 24px;
                                        icon-size: 14px;
                                        clicked => { Composer.unstage(index); }
                                    }
                                }
                            }
                        }
                    }
                    if ChatList.current.request: Banner {
                        icon: @image-url("@lucide/message-circle-question-mark.svg");
                        text: ChatList.current.title + " wants to message you. They won't know you've seen their messages until you accept.";
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Theme.space-s;
                                Button {
                                    text: "Block…";
                                    clicked => { Account.confirm = Confirm.block-request; }
                                }
                                Button {
                                    text: "Delete…";
                                    clicked => { Account.confirm = Confirm.delete-request; }
                                }
                                Button {
                                    text: "Accept";
                                    primary: true;
                                    clicked => { OpenChat.respond(RequestAnswer.accept); }
                                }
                            }
                        }
                    }
                    if ChatList.current.invited: Banner {
                        icon: @image-url("@lucide/users.svg");
                        text: "You're invited to join this group. Its members see you once you join.";
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Theme.space-s;
                                Button {
                                    text: "Decline";
                                    clicked => { Groups.answer-invitation(ChatList.current.id, false); }
                                }
                                Button {
                                    text: "Accept";
                                    primary: true;
                                    clicked => { Groups.answer-invitation(ChatList.current.id, true); }
                                }
                            }
                        }
                    }
                    if ChatList.current.requested: Banner {
                        icon: @image-url("@lucide/hourglass.svg");
                        text: "You asked to join this group. An admin has to let you in.";
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Take request back";
                                clicked => { Groups.cancel-join-request(); }
                            }
                        }
                    }
                    if ChatList.current.left && !ChatList.current.invited && !ChatList.current.requested: Banner {
                        icon: @image-url("@lucide/log-out.svg");
                        text: ChatList.current.subtitle;
                    }
                    if ChatList.current.safety-changed: Banner {
                        icon: @image-url("@lucide/shield-alert.svg");
                        text: "Your safety number with " + ChatList.current.title + " changed since you verified it. Compare it again, or continue without.";
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: Theme.space-s;
                                Button {
                                    text: "Show safety number";
                                    clicked => { Groups.open-details(); }
                                }
                                Button {
                                    text: "Continue";
                                    clicked => { Groups.confirm-safety-number(ChatList.current.id); }
                                }
                            }
                        }
                    }
                    if ChatList.current.blocked: Banner {
                        icon: @image-url("@lucide/ban.svg");
                        text: "You blocked this chat. You won't see new messages from it.";
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Unblock";
                                clicked => { ChatList.block(ChatList.current.id, false); }
                            }
                        }
                    }
                    // Not for requests, blocked chats, groups left or a changed safety number: they get
                    // their bar above instead.
                    Rectangle {
                        property <bool> hidden: ChatList.current.request || ChatList.current.blocked || ChatList.current.left || ChatList.current.safety-changed;
                        height: self.hidden ? 0px : composer-row.preferred-height;
                        clip: true;
                        // A chat opens ready to write in, wherever it was opened from (the search
                        // field would otherwise keep the focus, and typing there hides the chat).
                        property <string> chat: ChatList.selected-id;
                        function focus-if-writable() {
                            if !self.hidden {
                                focus-composer-timer.running = true;
                            }
                        }
                        init => { self.focus-if-writable(); }
                        changed chat => { self.focus-if-writable(); }
                        // Back to writing once a message was forwarded, or not.
                        property <bool> forwarding: Panels.forwarding;
                        changed forwarding => {
                            if !self.forwarding { self.focus-if-writable(); }
                        }
                        // And once Esc closed what was in front (which may have had the focus).
                        property <int> escaped: root.escaped;
                        changed escaped => { self.focus-if-writable(); }
                    composer-row := HorizontalLayout {
                        property <length> line: one-line-measure.preferred-height;
                        // The field's height for one line: the send button's, unless the text is
                        // set larger.
                        property <length> one-line-height: max(send-button.height, self.line + 8px);
                        // What is beside the field lines up with its last line, wherever that is.
                        function last-line-padding(height: length) -> length {
                            max(0px, (self.one-line-height - height) / 2)
                        }
                        width: parent.width;
                        padding: 12px;
                        spacing: 6px;
                        alignment: stretch;
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(32px);
                            IconButton {
                                label: "Attach files";
                                icon: @image-url("@lucide/paperclip.svg");
                                clicked => { Composer.attach(); }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(32px);
                            IconButton {
                                label: "Stickers";
                                icon: @image-url("@lucide/sticker.svg");
                                clicked => {
                                    Composer.open-stickers();
                                    sticker-picker.show();
                                }
                            }
                            sticker-picker := PopupWindow {
                                x: 0;
                                y: -self.height - Theme.space-s;
                                // A popup's size is its own, not its content's: without one it opens
                                // as a sliver, or not at all.
                                width: 6 * 72px + 2 * Theme.space-s + 14px;
                                height: 340px;
                                close-policy: close-on-click-outside;
                                Popover {
                                    VerticalLayout {
                                        padding: Theme.space-s;
                                        spacing: Theme.space-s;
                                        HorizontalLayout {
                                            spacing: Theme.space-xs;
                                            alignment: start;
                                            for title[index] in Composer.sticker-packs: Tab {
                                                text: title;
                                                selected: index == Composer.sticker-pack;
                                                clicked => {
                                                    Composer.sticker-pack = index;
                                                    Composer.sticker-pack-chosen();
                                                }
                                            }
                                        }
                                        if Composer.stickers-busy: Busy {}
                                        if !Composer.stickers-busy && Composer.sticker-packs.length == 0: EmptyState {
                                            icon: @image-url("@lucide/sticker.svg");
                                            text: "No sticker packs yet. Install some on your phone; they show up here.";
                                        }
                                        sticker-list := ListView {
                                            vertical-stretch: 1;
                                            for row in Composer.sticker-rows: HorizontalLayout {
                                                alignment: start;
                                                for tile in row.tiles: Pressable {
                                                    // Six to a row, beside the style's scroll bar.
                                                    width: min(72px, sticker-list.visible-width / 6);
                                                    height: self.width;
                                                    border-radius: Theme.radius-m;
                                                    accessible-label: "Send sticker " + tile.emoji;
                                                    clicked => {
                                                        Composer.send-sticker(tile.pack, tile.id);
                                                        sticker-picker.close();
                                                    }
                                                    Image {
                                                        width: parent.width - 12px;
                                                        height: self.width;
                                                        source: tile.picture;
                                                        image-fit: contain;
                                                        accessible-role: none;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(32px);
                            IconButton {
                                label: "Emoji";
                                icon: @image-url("@lucide/face-slightly-smiling.svg");
                                clicked => { emoji-picker.show(); }
                            }
                            // Stays open for more than one; a click outside or Esc closes it.
                            emoji-picker := PopupWindow {
                                x: 0;
                                y: -self.height - Theme.space-s;
                                // A popup's size is its own, not its content's.
                                width: emoji-grid.width;
                                height: emoji-grid.height;
                                close-policy: close-on-click-outside;
                                emoji-grid := EmojiPicker {
                                    picked(emoji) => { composer-field.insert(emoji); }
                                }
                            }
                        }
                        // Grows with the draft, up to a few lines, then scrolls. A plain text input
                        // in a field of our own: the native TextEdit keeps room below its text for a
                        // scroll bar, so a line of it sat at the top of a box two lines high. The
                        // draft is measured by an invisible copy, which wraps like the input.
                        composer-field := Rectangle {
                            horizontal-stretch: 1;
                            // A word too long for a line would otherwise make this as wide as the
                            // word, pushing the chat past the window; the input breaks it instead.
                            min-width: 0px;
                            property <length> pad-x: 10px;
                            property <length> pad-y: (composer-row.one-line-height - composer-row.line) / 2;
                            height: clamp(measure.preferred-height, composer-row.line, 150px - 2 * self.pad-y) + 2 * self.pad-y;
                            border-radius: Theme.radius-m;
                            border-width: 1px;
                            border-color: composer.has-focus ? Theme.accent : Theme.divider;
                            animate border-color { duration: Motion.fast; easing: ease-out; }
                            background: Theme.field;
                            measure := Text {
                                visible: false;
                                width: composer.width;
                                text: Composer.draft + " ";
                                wrap: word-wrap;
                            }
                            one-line-measure := Text {
                                visible: false;
                                text: " ";
                            }
                            // Focuses the input, with the caret at the end, once the menu an action
                            // was picked from has closed: closing it gives the focus back to wherever
                            // it was before.
                            focus-composer-timer := Timer {
                                interval: 1ms;
                                running: false;
                                // Or where the caret was, e.g. after the field's own menu.
                                in-out property <bool> to-end: true;
                                // Or here (a byte offset), e.g. after an emoji put in.
                                in-out property <int> caret: -1;
                                triggered => {
                                    self.running = false;
                                    composer.focus();
                                    if self.caret >= 0 {
                                        composer.set-selection-offsets(self.caret, self.caret);
                                    } else if self.to-end {
                                        composer.set-selection-offsets(2147483647, 2147483647);
                                    }
                                    self.to-end = true;
                                    self.caret = -1;
                                }
                            }
                            // Puts `text` where the caret is, in place of what is selected, and
                            // the caret after it.
                            function insert(text: string) {
                                focus-composer-timer.caret = Composer.splice-draft(text,
                                    min(composer.anchor-position-byte-offset, composer.cursor-position-byte-offset),
                                    max(composer.anchor-position-byte-offset, composer.cursor-position-byte-offset));
                                focus-composer-timer.running = true;
                            }
                            // Text from the clipboard, once Rust found it holds nothing to attach.
                            property <int> paste-text: Composer.paste-text;
                            changed paste-text => { composer.paste(); }
                            // After the field's menu, which may have been opened from elsewhere.
                            function focus-in-place() {
                                focus-composer-timer.to-end = false;
                                focus-composer-timer.running = true;
                            }
                            // Clicks beside the text, in the field's margins, start writing too.
                            TouchArea {
                                mouse-cursor: text;
                                clicked => { composer.focus(); }
                            }
                            Text {
                                x: parent.pad-x;
                                y: parent.pad-y;
                                width: composer-scroll.width;
                                text: Composer.draft == "" && composer.preedit-text == "" ? (Composer.editing ? "Edit message" : "Message") : "";
                                color: Theme.text-tertiary;
                                overflow: elide;
                                accessible-role: none;
                            }
                            ContextMenuArea {
                                x: parent.pad-x;
                                y: parent.pad-y;
                                width: parent.width - 2 * parent.pad-x;
                                height: parent.height - 2 * parent.pad-y;
                                Menu {
                                    MenuItem {
                                        title: "Cut";
                                        enabled: Composer.draft != "";
                                        activated => { composer.cut(); composer-field.focus-in-place(); }
                                    }
                                    MenuItem {
                                        title: "Copy";
                                        enabled: Composer.draft != "";
                                        activated => { composer.copy(); composer-field.focus-in-place(); }
                                    }
                                    MenuItem {
                                        title: "Paste";
                                        activated => {
                                            Composer.paste();
                                            composer-field.focus-in-place();
                                        }
                                    }
                                    MenuItem {
                                        title: "Select all";
                                        enabled: Composer.draft != "";
                                        activated => { composer.select-all(); composer-field.focus-in-place(); }
                                    }
                                }
                                // Scrolled by the wheel or by moving the caret; dragging selects.
                                composer-scroll := Flickable {
                                    interactive: false;
                                    content-height: composer.height;
                                    // Shorter text leaves no gap below it.
                                    changed content-height => {
                                        self.content-y = max(self.content-y, self.height - self.content-height);
                                    }
                                    composer := TextInput {
                                        width: composer-scroll.width;
                                        height: max(composer-scroll.height, measure.preferred-height);
                                        text <=> Composer.draft;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                        selection-background-color: Theme.selection;
                                        selection-foreground-color: Theme.selection-text;
                                        accessible-placeholder-text: Composer.editing ? "Edit message" : "Message";
                                        edited => { Composer.draft-edited(self.text); }
                                        // Where the caret is, for which line it is on.
                                        property <length> caret-y;
                                        // The caret stays in view.
                                        cursor-position-changed(at) => {
                                            self.caret-y = at.y;
                                            TextSelection.clear();
                                            if at.y + composer-scroll.content-y < 0px {
                                                composer-scroll.content-y = -at.y;
                                            } else if at.y + composer-row.line + composer-scroll.content-y > composer-scroll.height {
                                                composer-scroll.content-y = composer-scroll.height - at.y - composer-row.line;
                                            }
                                        }
                                        // Enter sends; Shift+Enter starts a new line.
                                        key-pressed(event) => {
                                            if (event.text == Key.Tab || event.text == Key.Return) && Composer.mention-candidates.length > 0 {
                                                Composer.pick-mention(0);
                                                // The name ends the draft: on after it.
                                                self.set-selection-offsets(2147483647, 2147483647);
                                                return accept;
                                            }
                                            if event.text == Key.Return && !event.modifiers.shift {
                                                if Composer.can-send { Composer.send(Composer.draft); }
                                                return accept;
                                            }
                                            if event.modifiers.control && (event.text == "v" || event.text == "V") {
                                                Composer.paste();
                                                return accept;
                                            }
                                            if event.text == Key.UpArrow && Composer.draft == "" {
                                                Composer.edit-last();
                                                // Ready to add to the end, as when typing it.
                                                self.set-selection-offsets(2147483647, 2147483647);
                                                return accept;
                                            }
                                            // ↓ on the last line goes to the end, ↑ on the first to the
                                            // start, as in editors (the input alone stays put); with
                                            // Shift, selecting up to there. `measure` is as tall as the
                                            // draft's lines.
                                            if event.text == Key.DownArrow && !event.modifiers.control && !event.modifiers.alt
                                                && self.caret-y + 1.5 * composer-row.line > measure.preferred-height {
                                                self.set-selection-offsets(event.modifiers.shift ? self.anchor-position-byte-offset : 2147483647, 2147483647);
                                                return accept;
                                            }
                                            if event.text == Key.UpArrow && !event.modifiers.control && !event.modifiers.alt
                                                && self.caret-y < 0.5 * composer-row.line {
                                                self.set-selection-offsets(event.modifiers.shift ? self.anchor-position-byte-offset : 0, 0);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(send-button.height);
                            send-button := SendButton {
                                saving: Composer.editing;
                                enabled: Composer.can-send;
                                clicked => { Composer.send(Composer.draft); composer.focus(); }
                            }
                        }
                    }
                    // Over the composer while messages are picked: what to do with them.
                    selection-bar := Rectangle {
                        opacity: OpenChat.selected-count > 0 ? 1 : 0;
                        visible: self.opacity > 0;
                        animate opacity { duration: Motion.fast; easing: ease-out; }
                        background: Theme.surface-raised;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text {
                                text: OpenChat.selected-count == 1 ? "1 message selected" : OpenChat.selected-count + " messages selected";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                font-weight: 600;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    label: "Copy selected";
                                    icon: @image-url("@lucide/copy.svg");
                                    clicked => {
                                        root.copy-text(OpenChat.selection-text());
                                        OpenChat.clear-selection();
                                    }
                                }
                            }
                            if OpenChat.can-forward-selection: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    label: "Forward selected";
                                    icon: @image-url("@lucide/forward.svg");
                                    clicked => { OpenChat.forward-selection(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                delete-menu := ContextMenuArea {
                                    width: 32px;
                                    height: 32px;
                                    Menu {
                                        MenuItem {
                                            title: "Delete for me";
                                            activated => { OpenChat.delete-selection(false); }
                                        }
                                        if OpenChat.can-delete-selection-for-everyone: MenuItem {
                                            title: "Delete for everyone…";
                                            activated => { Account.confirm = Confirm.delete-selection-for-everyone; }
                                        }
                                    }
                                    IconButton {
                                        label: "Delete selected";
                                        icon: @image-url("@lucide/trash.svg");
                                        clicked => { delete-menu.show({ x: 0px, y: self.height }); }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    label: "Clear selection";
                                    icon: @image-url("@lucide/x.svg");
                                    clicked => { OpenChat.clear-selection(); }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }

    // Files dragged from elsewhere onto the open chat are attached.
    if Account.screen == Screen.chats && ChatList.selected-id != "" && !Prefs.settings-open: DropArea {
        can-drop(event) => { return DragAction.copy; }
        dropped(event) => {
            Composer.files-dropped(event);
            return DragAction.copy;
        }
        if self.has-drag: FadeIn {
            background: Theme.veil;
            border-width: 2px;
            border-color: Theme.accent;
            border-radius: Theme.radius-l;
            Text {
                text: "Drop to attach";
                font-size: 1rem * Theme.heading;
                font-weight: 600;
                color: Theme.accent;
            }
        }
    }

    if Panels.stories-open: StoriesOverlay {
        narrow: root.narrow;
    }

    if Groups.group-draft-open: GroupDraftDialog {
    }

    if Account.confirm != Confirm.none: ConfirmPrompt {
        confirm-message: root.confirm-message;
    }

    if Groups.join-open: JoinDialog {
    }

    if Panels.forwarding: ForwardDialog {
    }
    }
}
