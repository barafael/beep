import { Button, ComboBox, LineEdit, ListView, Palette, ProgressIndicator, ScrollView, Spinner, Switch, TextEdit } from "std-widgets.slint";

export struct ConversationItem {
    id: string,
    title: string,
    initials: string,
    avatar-color: color,
    // Profile or group picture; empty (zero width) if there is none.
    avatar: image,
    preview: string,
    // When the newest message came: "14:05", "Mon", "Oct 2".
    time: string,
    // Under the title in the chat header: a phone number, "4 members", …
    subtitle: string,
    unread: int,
    pinned: bool,
    // A message request, waiting for Accept, Delete or Block.
    request: bool,
    blocked: bool,
    // A group we're no longer in.
    left: bool,
    // A group we're invited to (and not in yet): Accept or Decline.
    invited: bool,
    // A group we asked to join through its link, waiting for an admin.
    requested: bool,
    // A group we're an admin of: we may change its invite link and answer requests to join.
    admin: bool,
    // A contact whose safety number changed since we verified it: nothing is sent until that
    // is confirmed.
    safety-changed: bool,
    // A group: we may manage it (name, members).
    group: bool,
    // Among the pinned ones.
    can-move-up: bool,
    can-move-down: bool,
    muted: bool,
    // Marked unread by hand: a dot, no count.
    marked-unread: bool,
    archived: bool,
    // "Ann is typing…", shown instead of the preview; empty otherwise.
    typing: string,
    // Disappearing messages: seconds, 0 for off; and as said, e.g. "1 hour".
    timer: int,
    timer-label: string,
}

// What plays, for the audio rows: set by Rust, read by every row.
export global Playback {
    // The attachment playing (or paused); empty if none.
    in property <string> id;
    in property <bool> paused;
    // 0 to 1.
    in property <float> progress;
    // E.g. "0:07 / 0:42".
    in property <string> time;
    // Play this one (from the start), or pause or carry on if it is the one playing.
    callback toggle(string);
}

export struct AttachmentItem {
    id: string,
    // Shown as a picture (photos, stickers); otherwise as a row with a label.
    inline: bool,
    // Not shown at all; fetched for its content (the full text of a long message).
    hidden: bool,
    // Ask the backend for it once it is shown.
    fetch: bool,
    // Empty (zero width) until downloaded.
    picture: image,
    // The picture's size in the bubble, known before it is downloaded.
    width: length,
    height: length,
    // E.g. "📎 route-notes.pdf · 240 KB".
    label: string,
    // "Saved to Downloads", an error, or empty.
    status: string,
    // The download failed; clicking the picture's place asks again.
    can-retry: bool,
    can-save: bool,
    // Blurred, shown until the picture is there (and for videos, which aren't downloaded to
    // be shown); empty if the sender made none.
    placeholder: image,
    caption: string,
    // A video, opened in the desktop's player; `gif` for one meant to loop like a GIF.
    video: bool,
    // Audio or a voice message, played here.
    audio: bool,
    gif: bool,
}

export struct ReactionItem {
    emoji: string,
    count: int,
    // One of them is ours; clicking takes it back.
    mine: bool,
}

// How far one of our messages got; `incoming` for others' messages.
export enum DeliveryState { incoming, sending, failed, sent, delivered, read }

// An answer to a message request.
export enum RequestAnswer { accept, delete, block }

export struct MessageItem {
    sender: string,
    // With links made clickable.
    body: styled-text,
    has-body: bool,
    time: string,
    outgoing: bool,
    // Show the sender above the bubble (groups, first of a run).
    show-sender: bool,
    // "Today", "Monday", "Oct 2" on the first message of a day; empty otherwise.
    day: string,
    // Messages by the same person within a few minutes are drawn as a run.
    first: bool,
    last: bool,
    // Incoming group messages leave room for the sender's avatar, shown at the end of a run.
    avatar-column: bool,
    sender-avatar: image,
    sender-initials: string,
    sender-color: color,
    // The message this one replies to; both empty if it isn't a reply.
    quote-author: string,
    quote-text: string,
    attachments: [AttachmentItem],
    reactions: [ReactionItem],
    // Plain text, for copying.
    text: string,
    delivery: DeliveryState,
    edited: bool,
    deleted: bool,
    // A line about the conversation that nobody wrote (e.g. a new safety number): drawn as
    // centred text, with nothing to reply, react to or delete.
    notice: bool,
    // Time left until it disappears, e.g. "5m"; empty if it doesn't.
    expires: string,
    // Ours and recent enough to edit or delete for everyone.
    can-edit: bool,
    // The first message that came after the chat was last read.
    first-unread: bool,
    // Just arrived or sent: it fades in as it is shown. Cleared again soon after, so it
    // doesn't when scrolled back to.
    fresh: bool,
    can-forward: bool,
    // The search result last shown.
    highlighted: bool,
    // Picked, with others, for an action on all of them; see `toggle-select`.
    selected: bool,
    // A preview of the link in it; `preview-url` is empty if there is none.
    preview-url: string,
    preview-title: string,
    preview-description: string,
    // The site, e.g. "www.rust-lang.org".
    preview-site: string,
    preview-image: AttachmentItem,
    has-preview-image: bool,
}

// Someone (or a group) with stories.
export struct RingItem {
    id: string,
    title: string,
    initials: string,
    color: color,
    avatar: image,
    unviewed: bool,
    // When the newest was posted.
    time: string,
}

// The story shown.
export struct StoryItem {
    shown: bool,
    author: string,
    time: string,
    // E.g. "1 / 3".
    position: string,
    text-story: bool,
    text: string,
    foreground: color,
    background: color,
    picture: AttachmentItem,
}

// Someone to choose for a group.
export struct CandidateItem {
    id: string,
    title: string,
    initials: string,
    color: color,
    avatar: image,
    chosen: bool,
}

// A group member on the details page.
export struct MemberItem {
    // Their service ID.
    id: string,
    name: string,
    initials: string,
    color: color,
    admin: bool,
}

// A sticker in the picker.
export struct StickerTile {
    pack: string,
    id: int,
    picture: image,
    emoji: string,
}

// A row of the sticker picker's grid.
export struct StickerRow {
    tiles: [StickerTile],
}

// A file or link in the media overview, with who sent it when.
export struct SharedItem {
    attachment: AttachmentItem,
    // For links.
    url: string,
    sender: string,
    when: string,
}

// A message found by searching a chat.
export struct SearchResult {
    sender: string,
    // When it was sent, e.g. "Oct 2, 14:05".
    when: string,
    // The text around the match.
    text: string,
    // The same, with the match in bold.
    snippet: styled-text,
}

export enum Screen { connecting, password, link, chats }

// How much the UI moves: 1 normally, 0 for reduced motion (the user's setting, or their
// desktop's). Every animation's duration is multiplied by it, so 0 makes changes instant.
export global Motion {
    in property <float> scale: 1;
}

// A Lucide icon (`@image-url("@lucide/<name>.svg")`, see `build.rs`). They are all drawn on
// the same square grid, so icons of the same size placed side by side share their center.
component Icon inherits Image {
    in property <color> tint: Palette.foreground.with-alpha(0.7);
    width: 18px;
    height: self.width;
    image-fit: contain;
    colorize: root.tint;
    accessible-role: none;
}

// A button that is only an icon. Every icon button looks and lines up the same: a fixed square
// with the icon in its middle.
component IconButton inherits Rectangle {
    in property <image> icon;
    // What it does, for screen readers and as its tooltip.
    in property <string> label;
    // Hidden until hovered when false, e.g. a message's actions.
    in property <bool> shown: true;
    // Highlighted, e.g. while the panel it opens is open.
    in property <bool> active;
    // A dot in the corner, e.g. for something new behind it.
    in property <bool> badge;
    in property <length> icon-size: 18px;
    in property <color> tint: Palette.foreground.with-alpha(0.7);
    callback clicked;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    opacity: root.shown || root.active || touch.has-hover ? 1 : 0;
    animate opacity { duration: 120ms * Motion.scale; easing: ease-out; }
    background: root.active ? Palette.accent-background.with-alpha(0.18)
        : touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        source: root.icon;
        tint: root.tint;
        width: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if root.badge: Rectangle {
        x: parent.width - self.width - 4px;
        y: 4px;
        width: 8px;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.accent-background;
    }
}

// Sends the draft: a paper plane on the accent color, or a check mark while editing a message.
component SendButton inherits Rectangle {
    in property <bool> enabled: true;
    // Saving an edit rather than sending.
    in property <bool> saving;
    callback clicked;
    accessible-role: button;
    accessible-label: root.saving ? "Save" : "Send";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: !root.enabled ? Palette.foreground.with-alpha(0.12)
        : touch.pressed ? Palette.accent-background.darker(0.2)
        : touch.has-hover ? Palette.accent-background.brighter(0.1) : Palette.accent-background;
    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
    // White, as on our own messages: the style's accent foreground can be dark.
    property <color> tint: root.enabled ? white : Palette.foreground.with-alpha(0.4);
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if !root.saving: Path {
        // Nudged right of center, where a plane's weight is.
        x: (parent.width - self.width) / 2 + 1px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 2.01 21 L 23 12 L 2.01 3 L 2 10 L 17 12 L 2 14 Z";
        fill: root.tint;
        accessible-role: none;
    }
    if root.saving: Icon {
        source: @image-url("@lucide/check.svg");
        tint: root.tint;
        width: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <color> tint;
    // Shown instead of the initials when set.
    in property <image> picture;
    width: 40px;
    height: self.width;
    border-radius: self.width / 2;
    clip: true;
    background: tint;
    // The initials give way to the picture as it fades in (see `AttachmentView`).
    Text {
        text: initials;
        color: white;
        font-size: root.width * 0.4;
        font-weight: 600;
        opacity: 1 - photo.opacity;
    }
    photo := Image {
        width: root.width;
        height: root.height;
        source: root.picture;
        image-fit: cover;
        opacity: root.picture.width > 0 ? 1 : 0;
        animate opacity { duration: 200ms * Motion.scale; easing: ease-out; }
    }
}

// The text selected in a message, for copying (Ctrl+C or the message's menu): one message's
// at a time, the one at `owner`; the others drop theirs when it changes. -1 for none. The text
// stays in the `StyledText`, which reaches the clipboard itself; `copy-request` asks the one at
// `owner` to copy it.
global TextSelection {
    in-out property <int> owner: -1;
    // Bumped to ask the message at `owner` to copy its selection.
    in-out property <int> copy-request;
    public function clear() {
        self.owner = -1;
    }
    public function copy() {
        self.copy-request += 1;
    }
}

// How long a chat can be muted for, in seconds (-1 for good).
global MuteChoices {
    out property <[{ label: string, seconds: int }]> choices: [
        { label: "For 1 hour", seconds: 3600 },
        { label: "For 8 hours", seconds: 28800 },
        { label: "For 1 week", seconds: 604800 },
        { label: "Always", seconds: -1 },
    ];
}

// How long messages last in a chat with disappearing messages, in seconds (0 for off).
global TimerChoices {
    out property <[string]> labels: ["Off", "30 seconds", "5 minutes", "1 hour", "8 hours", "1 day", "1 week", "4 weeks"];
    out property <[int]> seconds: [0, 30, 300, 3600, 28800, 86400, 604800, 2419200];
    // The place of `seconds` among the choices; -1 for a time set elsewhere that isn't one.
    public pure function index-of(seconds: int) -> int {
        seconds == 0 ? 0 : seconds == 30 ? 1 : seconds == 300 ? 2 : seconds == 3600 ? 3
            : seconds == 28800 ? 4 : seconds == 86400 ? 5 : seconds == 604800 ? 6
            : seconds == 2419200 ? 7 : -1
    }
}

// What can be done with a conversation, in its context menu and the chat header's menu.
component ConversationMenu inherits ContextMenuArea {
    in property <ConversationItem> item;
    // The chat header's menu. It opens against the window's right edge, where a submenu has no
    // room beside it and would open over the menu itself, so it has none: muting for a while
    // and the disappearing-messages timer are in the chat's details instead.
    in property <bool> in-header;
    callback toggle-pin;
    // Among the pinned chats: -1 up, 1 down.
    callback move-pin(int);
    callback mark-read(bool);
    // For this many seconds; -1 for good, 0 to unmute.
    callback mute(int);
    callback archive(bool);
    callback block(bool);
    // With `in-header`: the chat's media, files and links, and its details.
    callback show-media;
    callback show-details;
    property <bool> unread: root.item.unread > 0 || root.item.marked-unread;
    Menu {
        MenuItem {
            title: root.item.pinned ? "Unpin" : "Pin";
            activated => { root.toggle-pin(); }
        }
        if root.item.can-move-up: MenuItem {
            title: "Move up";
            activated => { root.move-pin(-1); }
        }
        if root.item.can-move-down: MenuItem {
            title: "Move down";
            activated => { root.move-pin(1); }
        }
        MenuItem {
            title: root.unread ? "Mark as read" : "Mark as unread";
            activated => { root.mark-read(root.unread); }
        }
        if root.item.muted: MenuItem {
            title: "Unmute";
            activated => { root.mute(0); }
        }
        if !root.item.muted && !root.in-header: Menu {
            title: "Mute";
            for choice in MuteChoices.choices: MenuItem {
                title: choice.label;
                activated => { root.mute(choice.seconds); }
            }
        }
        if root.in-header: MenuItem {
            title: "Details";
            activated => { root.show-details(); }
        }
        if root.in-header: MenuItem {
            title: "Media, files and links";
            activated => { root.show-media(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.item.blocked ? "Unblock" : "Block";
            activated => { root.block(!root.item.blocked); }
        }
        MenuItem {
            title: root.item.archived ? "Unarchive" : "Archive";
            activated => { root.archive(!root.item.archived); }
        }
    }
}

component ConversationRow inherits Rectangle {
    in property <ConversationItem> item;
    in property <bool> selected;
    callback clicked;
    // See `ConversationMenu`.
    callback toggle-pin;
    callback move-pin(int);
    callback mark-read(bool);
    callback mute(int);
    callback archive(bool);
    callback block(bool);

    height: 64px;
    border-radius: 6px;
    background: selected ? Palette.accent-background.with-alpha(0.18)
        : touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
    animate background { duration: 120ms * Motion.scale; easing: ease-out; }

    accessible-role: list-item;
    accessible-label: item.title
        + (item.unread > 0 ? ", " + item.unread + " unread" : item.marked-unread ? ", unread" : "")
        + (item.request ? ", message request" : "")
        + (item.pinned ? ", pinned" : "") + (item.muted ? ", muted" : "")
        + ", " + (item.typing != "" ? item.typing : item.preview);
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;
        Avatar {
            initials: item.initials;
            tint: item.avatar-color;
            picture: item.avatar;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: item.title;
                    font-weight: item.unread > 0 ? 700 : 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: Palette.foreground;
                }
                // Centered on the time beside them, which the row's text centers on too.
                if item.muted: VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("@lucide/bell-off.svg");
                        width: 14px;
                        tint: Palette.foreground.with-alpha(0.55);
                    }
                }
                if item.pinned: VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("@lucide/pin.svg");
                        width: 14px;
                        tint: Palette.foreground.with-alpha(0.55);
                    }
                }
                Text {
                    text: item.time;
                    font-size: 0.75rem;
                    vertical-alignment: center;
                    color: item.unread > 0 ? Palette.accent-background : Palette.foreground.with-alpha(0.55);
                }
            }
            HorizontalLayout {
                spacing: 6px;
                if item.request: Text {
                    text: "Message request · ";
                    font-size: 0.9rem;
                    font-weight: 600;
                    color: Palette.accent-background;
                }
                Text {
                    text: item.blocked ? "Blocked" : item.typing != "" ? item.typing : item.preview;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: item.typing != "" ? Palette.accent-background : Palette.foreground.with-alpha(0.65);
                    font-size: 0.9rem;
                }
                if item.unread == 0 && item.marked-unread: Rectangle {
                    width: 10px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: Palette.accent-background;
                }
                // Always there: it grows in with the first unread message and shrinks away once
                // read (a row drawn with it is simply there).
                // No `changed` handler here: rows come and go as the list changes, and Slint (1.18)
                // can run one for a row already dropped, which aborts.
                Rectangle {
                    width: item.unread > 0 ? max(18px, badge.preferred-width + 10px) : 0px;
                    animate width { duration: 150ms * Motion.scale; easing: ease-out; }
                    opacity: item.unread > 0 ? 1 : 0;
                    animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
                    clip: true;
                    height: 18px;
                    border-radius: 9px;
                    // Muted chats count quietly.
                    background: item.muted ? Palette.foreground.with-alpha(0.35) : Palette.accent-background;
                    badge := Text {
                        // Nothing while shrinking away, rather than 0.
                        text: item.unread > 0 ? item.unread : "";
                        // White on the accent, whatever the style's accent text colour is.
                        color: white;
                        font-size: 0.75rem;
                        font-weight: 700;
                    }
                }
            }
        }
    }
    // On top: it takes only right clicks, so left clicks still reach the row.
    ConversationMenu {
        item: root.item;
        toggle-pin => { root.toggle-pin(); }
        move-pin(by) => { root.move-pin(by); }
        mark-read(read) => { root.mark-read(read); }
        mute(seconds) => { root.mute(seconds); }
        archive(archived) => { root.archive(archived); }
        block(blocked) => { root.block(blocked); }
    }
}

component AttachmentView inherits VerticalLayout {
    in property <AttachmentItem> item;
    in property <bool> outgoing;
    callback fetch(string);
    callback save(string);
    callback open(string);

    // Outgoing bubbles use the accent colour, so their text is white for contrast with any.
    property <color> ink: outgoing ? white : Palette.alternate-foreground;
    spacing: 4px;
    // The list only creates rows that are on screen, so this downloads only what is seen.
    // (A view kept for another attachment, like the next story, is told by its owner.)
    init => {
        if root.item.fetch { root.fetch(root.item.id); }
    }

    if root.item.inline: Rectangle {
        width: root.item.width;
        height: root.item.height;
        border-radius: 8px;
        clip: true;
        background: root.ink.with-alpha(0.08);
        // The blurred stand-in gives way to the picture as it fades in. Both are always there:
        // a change of opacity animates, a row drawn with its picture loaded doesn't.
        if root.item.placeholder.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.item.placeholder;
            image-fit: cover;
            opacity: 1 - picture.opacity;
        }
        picture := Image {
            width: parent.width;
            height: parent.height;
            source: root.item.picture;
            image-fit: contain;
            opacity: root.item.picture.width > 0 ? 1 : 0;
            animate opacity { duration: 200ms * Motion.scale; easing: ease-out; }
        }
        // Videos play in the desktop's player.
        if root.item.video: Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: #0008;
            Text {
                text: root.item.gif ? "GIF" : "▶";
                font-size: root.item.gif ? 0.9rem : 1.3rem;
                font-weight: 700;
                color: white;
            }
        }
        if root.item.video: TouchArea {
            accessible-role: button;
            accessible-label: "Play video";
            accessible-action-default => { self.clicked(); }
            mouse-cursor: pointer;
            clicked => { root.open(root.item.id); }
        }
        // Full size in the desktop's image viewer.
        if root.item.picture.width > 0: TouchArea {
            accessible-role: button;
            accessible-label: "Open picture";
            accessible-action-default => { self.clicked(); }
            mouse-cursor: pointer;
            clicked => { root.open(root.item.id); }
        }
        if root.item.picture.width == 0 && root.item.status == "" && !root.item.video: Spinner {
            indeterminate: true;
            width: 24px;
            height: 24px;
        }
        if root.item.picture.width == 0 && root.item.can-retry: TouchArea {
            accessible-role: button;
            accessible-label: "Download again";
            accessible-action-default => { self.clicked(); }
            mouse-cursor: pointer;
            clicked => { root.fetch(root.item.id); }
        }
        if root.item.picture.width == 0 && root.item.status != "": Text {
            text: root.item.status;
            wrap: word-wrap;
            width: parent.width - 16px;
            horizontal-alignment: center;
            font-size: 0.8rem;
            color: root.ink.with-alpha(0.7);
        }
    }
    if root.item.audio: audio-row := HorizontalLayout {
        property <bool> current: Playback.id == root.item.id;
        spacing: 8px;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 18px;
            background: root.ink.with-alpha(play-touch.has-hover ? 0.25 : 0.15);
            animate background { duration: 120ms * Motion.scale; easing: ease-out; }
            play-touch := TouchArea {
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: audio-row.current && !Playback.paused ? "Pause" : "Play";
                accessible-action-default => { self.clicked(); }
                clicked => { Playback.toggle(root.item.id); }
            }
            Text {
                text: audio-row.current && !Playback.paused ? "⏸" : "▶";
                color: root.ink;
                font-size: 1rem;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            min-width: 160px;
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: root.ink.with-alpha(0.2);
                Rectangle {
                    x: 0;
                    width: parent.width * (audio-row.current ? Playback.progress : 0);
                    // The progress comes every 200ms: glide between.
                    animate width { duration: 200ms * Motion.scale; easing: linear; }
                    height: parent.height;
                    border-radius: 2px;
                    background: root.ink;
                }
            }
            Text {
                text: audio-row.current ? Playback.time : root.item.label;
                font-size: 0.8rem;
                color: root.ink.with-alpha(0.75);
            }
        }
    }
    if root.item.caption != "": Text {
        text: root.item.caption;
        wrap: word-wrap;
        color: root.ink;
    }
    if (!root.item.inline && !root.item.audio) || root.item.can-save: HorizontalLayout {
        spacing: 8px;
        if !root.item.inline && !root.item.audio: Text {
            text: root.item.label;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.ink;
        }
        if !root.item.inline && root.item.can-save: open-touch := TouchArea {
            accessible-role: button;
            accessible-label: "Open " + root.item.label;
            accessible-action-default => { self.clicked(); }
            width: open-label.preferred-width;
            mouse-cursor: pointer;
            clicked => { root.open(root.item.id); }
            open-label := Text {
                text: "Open";
                font-size: 0.85rem;
                font-weight: 600;
                vertical-alignment: center;
                color: open-touch.has-hover ? root.ink : root.ink.with-alpha(0.75);
            }
        }
        if root.item.inline || root.item.status != "": Text {
            text: root.item.inline && root.item.picture.width == 0 ? "" : root.item.status;
            vertical-alignment: center;
            font-size: 0.8rem;
            overflow: elide;
            horizontal-stretch: 1;
            color: root.ink.with-alpha(0.7);
        }
        if root.item.can-save: save-touch := TouchArea {
            accessible-role: button;
            accessible-label: "Save " + root.item.label;
            accessible-action-default => { self.clicked(); }
            width: save-label.preferred-width;
            mouse-cursor: pointer;
            clicked => { root.save(root.item.id); }
            save-label := Text {
                text: "Save";
                font-size: 0.85rem;
                font-weight: 600;
                vertical-alignment: center;
                color: save-touch.has-hover ? root.ink : root.ink.with-alpha(0.75);
            }
        }
    }
}

// Quick reactions, as in Signal's own apps: a bar over the bubble, there while the pointer
// rests on the message or on the bar itself.
component ReactionPicker inherits Rectangle {
    in property <bool> shown;
    // The pointer came onto it, or left it. Told at once as it comes (the message underneath
    // loses the pointer in the same event, and must not take the bar away meanwhile), so a
    // callback rather than a property watched for changes.
    callback hovered(bool);
    callback picked(string);
    width: 210px;
    height: 40px;
    visible: root.shown;
    // Fades in as it appears.
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 120ms * Motion.scale; easing: ease-out; }
    border-radius: self.height / 2;
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;
    drop-shadow-blur: 8px;
    drop-shadow-color: #0003;
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered(true);
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.hovered(false);
            }
        }
    }
    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for emoji in ["❤️", "👍", "👎", "😂", "😮", "😢"]: Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: emoji-touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
            emoji-touch := TouchArea {
                accessible-role: button;
                accessible-label: "React with " + emoji;
                accessible-action-default => { self.clicked(); }
                mouse-cursor: pointer;
                clicked => { root.picked(emoji); }
                // The buttons take the pointer from the bar's own area.
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.hovered(true);
                    }
                }
            }
            Text { text: emoji; font-size: 1.2rem; }
        }
    }
}

component Bubble inherits Rectangle {
    in property <MessageItem> item;
    in property <length> max-bubble-width;
    // Its row in the list; see `TextSelection`.
    in property <int> index;
    callback fetch-attachment(string);
    callback save-attachment(string);
    callback open-attachment(string);
    callback open-link(string);
    callback reply;
    callback react(string);
    callback edit;
    callback delete(bool);
    callback copy-text(string);
    callback reveal;
    callback forward;
    // Picks this message for an action on all picked ones, or unpicks it; `select-through`
    // picks every message from the one last picked.
    callback toggle-select;
    callback select-through;
    // Messages are picked: a click on the row picks this one too, or unpicks it.
    in property <bool> selecting;
    // Ctrl is held: a click on the row picks this message.
    in property <bool> pick-held;

    // Outgoing bubbles use the accent colour: white text reads on any style's accent.
    property <color> ink: item.outgoing ? white : Palette.alternate-foreground;
    // The row is tinted while the message is picked.
    background: item.selected ? Palette.accent-background.with-alpha(0.12) : transparent;
    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
    // Within a run, the corners facing the neighbouring bubbles are tighter.
    property <length> round: 16px;
    property <length> tight: 5px;

    // A message that just arrived or was just sent fades in; others, e.g. when a chat opens
    // or is scrolled, are simply there. (Only a fade: moving or scaling the row upsets how
    // the list measures it, and a newly opened chat no longer ends at its newest message.)
    property <float> arrived: item.fresh ? 0 : 1;
    animate arrived { duration: 180ms * Motion.scale; easing: ease-out; }
    opacity: self.arrived;
    // A search result jumped to lights up, then settles into its highlight, so the eye finds
    // it. (Jumping draws its row anew; one already in view just gets the highlight.)
    property <float> flash: 1;
    // Reactions it had when drawn: only ones that come later fade in. (Very many until then,
    // so none of those it is drawn with does, whichever is set up first.)
    property <int> reactions-at-start: 1000000;
    init => {
        self.arrived = 1;
        self.flash = 0;
        self.reactions-at-start = item.reactions.length;
    }
    animate flash { duration: 900ms * Motion.scale; easing: ease-out; }

    // The pointer is on the message, or on the reaction bar over it (which reaches past the
    // row, and takes the pointer off `hover`; the bar is in a conditional, so it reports).
    property <bool> picker-hovered;
    property <bool> hovered: hover.has-hover || root.picker-hovered;
    property <bool> can-react: !item.deleted && !item.notice && !root.selecting;
    // The reaction bar comes once the pointer has rested on the message a moment (not while
    // it merely crosses the list), and goes when the pointer leaves it and the bar.
    property <bool> picker-shown;
    changed hovered => {
        if !self.hovered {
            self.picker-shown = false;
        }
    }
    Timer {
        interval: 350ms;
        running: root.hovered && root.can-react && !root.picker-shown;
        triggered => { root.picker-shown = true; }
    }

    // Around the content, not under it: it stays hovered over the text and pictures, which
    // take the pointer themselves (links), so the message's button shows there too.
    hover := TouchArea {
        VerticalLayout {
            if item.first-unread: HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                spacing: 8px;
                Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Palette.accent-background.with-alpha(0.5); }
                new-label := Text {
                    text: "New messages";
                    font-size: 0.8rem;
                    font-weight: 600;
                    horizontal-stretch: 0;
                    color: Palette.accent-background;
                }
                Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Palette.accent-background.with-alpha(0.5); }
            }
            if item.day != "": HorizontalLayout {
                alignment: center;
                padding-top: 14px;
                padding-bottom: 6px;
                Rectangle {
                    width: day-label.preferred-width + 20px;
                    height: 22px;
                    border-radius: 11px;
                    background: Palette.alternate-background;
                    border-width: 1px;
                    border-color: Palette.border;
                    day-label := Text {
                        text: item.day;
                        font-size: 0.8rem;
                        font-weight: 600;
                        color: Palette.foreground.with-alpha(0.7);
                    }
                }
            }

            if item.notice: HorizontalLayout {
                alignment: center;
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 6px;
                padding-bottom: 6px;
                Text {
                    text: item.text;
                    accessible-role: text;
                    accessible-label: item.text;
                    max-width: root.max-bubble-width;
                    wrap: word-wrap;
                    // As for the body below: never wider than the limit, even for one long word.
                    min-width: 0px;
                    horizontal-alignment: center;
                    font-size: 0.8rem;
                    color: Palette.foreground.with-alpha(0.7);
                }
            }
            if !item.notice: HorizontalLayout {
                alignment: item.outgoing ? end : start;
                padding-left: 12px;
                padding-right: 12px;
                padding-top: item.first ? 6px : 1px;
                padding-bottom: 1px;
                spacing: 4px;

                // The sender's picture, at the end of their run.
                if item.avatar-column: VerticalLayout {
                    alignment: end;
                    width: 28px;
                    if item.last: Avatar {
                        width: 28px;
                        initials: item.sender-initials;
                        tint: item.sender-color;
                        picture: item.sender-avatar;
                    }
                }
                // Beside the bubble on the side facing the middle, shown on hover.
                if item.outgoing: VerticalLayout {
                    alignment: center;
                    IconButton {
                        label: "Reply";
                        icon: @image-url("@lucide/reply.svg");
                        visible: !item.deleted;
                        shown: root.hovered;
                        clicked => { root.reply(); }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    if item.show-sender: Text {
                        text: item.sender;
                        font-size: 0.8rem;
                        font-weight: 600;
                        color: item.sender-color;
                    }
                    Rectangle {
                        max-width: root.max-bubble-width;
                        border-top-left-radius: !item.outgoing && !item.first ? root.tight : root.round;
                        border-bottom-left-radius: !item.outgoing && !item.last ? root.tight : root.round;
                        border-top-right-radius: item.outgoing && !item.first ? root.tight : root.round;
                        border-bottom-right-radius: item.outgoing && !item.last ? root.tight : root.round;
                        // Darkened, so white text reads even on a light accent (Breeze's dark scheme).
                        background: (item.outgoing ? Palette.accent-background.darker(0.35) : Palette.alternate-background)
                            .mix(Palette.accent-background.brighter(0.6), item.highlighted ? 1 - 0.5 * root.flash : 1)
                            // A whisper lighter under the pointer: just enough to say which row
                            // the button belongs to, not enough to catch the eye as it passes.
                            .mix(Palette.foreground, root.hovered ? 0.98 : 1);
                        animate background { duration: 160ms * Motion.scale; easing: ease-out; }
                        // Paler until it went out.
                        opacity: item.delivery == DeliveryState.sending ? 0.7 : 1;
                        animate opacity { duration: 250ms * Motion.scale; easing: ease-out; }
                        border-width: item.highlighted ? 2px : item.outgoing ? 0 : 1px;
                        border-color: item.highlighted ? Palette.accent-background.brighter(0.4) : Palette.border;
                        VerticalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 7px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            if item.quote-author != "" || item.quote-text != "": Rectangle {
                                border-radius: 6px;
                                background: root.ink.with-alpha(0.12);
                                HorizontalLayout {
                                    Rectangle {
                                        width: 3px;
                                        border-radius: 1.5px;
                                        background: item.outgoing ? white : Palette.accent-background;
                                    }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;
                                        Text {
                                            text: item.quote-author;
                                            font-size: 0.8rem;
                                            font-weight: 600;
                                            color: root.ink;
                                        }
                                        Text {
                                            text: item.quote-text;
                                            font-size: 0.85rem;
                                            wrap: word-wrap;
                                            overflow: elide;
                                            max-height: 2.6rem;
                                            color: root.ink.with-alpha(0.8);
                                        }
                                    }
                                }
                            }
                            if item.preview-url != "": Rectangle {
                                border-radius: 8px;
                                background: root.ink.with-alpha(0.1);
                                preview-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Open link " + item.preview-url;
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => { root.open-link(item.preview-url); }
                                }
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 3px;
                                    if item.has-preview-image: AttachmentView {
                                        item: item.preview-image;
                                        outgoing: item.outgoing;
                                        fetch(id) => { root.fetch-attachment(id); }
                                        open(id) => { root.open-link(item.preview-url); }
                                    }
                                    if item.preview-title != "": Text {
                                        text: item.preview-title;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                        color: root.ink;
                                    }
                                    if item.preview-description != "": Text {
                                        text: item.preview-description;
                                        font-size: 0.85rem;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        max-height: 3.6rem;
                                        color: root.ink.with-alpha(0.8);
                                    }
                                    Text {
                                        text: item.preview-site;
                                        font-size: 0.75rem;
                                        color: root.ink.with-alpha(0.65);
                                    }
                                }
                            }
                            for attachment in item.attachments: AttachmentView {
                                // A long message's full text replaces the body; it isn't shown itself.
                                visible: !attachment.hidden;
                                height: attachment.hidden ? 0 : self.preferred-height;
                                item: attachment;
                                outgoing: item.outgoing;
                                fetch(id) => { root.fetch-attachment(id); }
                                save(id) => { root.save-attachment(id); }
                                open(id) => { root.open-attachment(id); }
                            }
                            if item.has-body: StyledText {
                                text: item.body;
                                // A long unbreakable word (a URL) must not widen the bubble past
                                // its limit: the list would then measure the row at that width
                                // and give it too little height, so the next rows draw over it.
                                min-width: 0px;
                                // For screen readers (and finding messages in the UI tests).
                                accessible-role: text;
                                accessible-label: item.deleted ? "This message was deleted." : item.text;
                                default-color: item.deleted ? root.ink.with-alpha(0.6) : root.ink;
                                link-color: item.outgoing ? white : Palette.accent-background;
                                // Spoilers are links that reveal them.
                                link-clicked(link) => {
                                    if link == "spoiler:" {
                                        root.reveal();
                                    } else {
                                        root.open-link(link);
                                    }
                                }
                                // Text can be selected and copied; one message's at a time.
                                text-selectable: !item.deleted;
                                selection-background-color: root.ink.with-alpha(0.3);
                                selection-foreground-color: root.ink;
                                property <int> owner: TextSelection.owner;
                                changed owner => {
                                    if self.owner != root.index {
                                        self.clear-selection();
                                    }
                                }
                                changed has-selection => {
                                    if self.has-selection {
                                        TextSelection.owner = root.index;
                                    } else if TextSelection.owner == root.index {
                                        TextSelection.clear();
                                    }
                                }
                                // Ctrl+C or the menu asks the message holding the selection to
                                // copy it; the element itself reaches the clipboard.
                                property <int> copy-request: TextSelection.copy-request;
                                changed copy-request => {
                                    if TextSelection.owner == root.index && self.has-selection {
                                        self.copy();
                                    }
                                }
                            }
                            // Once per run, on its last message; always if it changed, goes away or
                            // failed to go out.
                            if item.last || item.edited || item.expires != "" || item.delivery == DeliveryState.failed: meta := HorizontalLayout {
                                alignment: end;
                                spacing: 4px;
                                property <color> faint: root.ink.with-alpha(0.65);
                                if item.expires != "": Text {
                                    text: "⏱ " + item.expires;
                                    font-size: 0.72rem;
                                    color: parent.faint;
                                }
                                if item.edited: Text {
                                    text: "edited";
                                    font-size: 0.72rem;
                                    font-italic: true;
                                    color: parent.faint;
                                }
                                if item.last: Text {
                                    text: item.time;
                                    font-size: 0.864rem;
                                    color: parent.faint;
                                }
                                // ✓ sent, ✓✓ delivered; read: ✓✓ cut out of a filled pill, so it
                                // tells from delivered at a glance.
                                if item.last && (item.delivery == DeliveryState.sent || item.delivery == DeliveryState.delivered || item.delivery == DeliveryState.read): Rectangle {
                                    width: 18px;
                                    height: 13px;
                                    border-radius: self.height / 2;
                                    background: item.delivery == DeliveryState.read ? root.ink : transparent;
                                    accessible-role: text;
                                    accessible-label: item.delivery == DeliveryState.sent ? "Sent" : item.delivery == DeliveryState.delivered ? "Delivered" : "Read";
                                    Icon {
                                        source: item.delivery == DeliveryState.sent ? @image-url("@lucide/check.svg") : @image-url("@lucide/check-check.svg");
                                        width: 11px;
                                        tint: item.delivery == DeliveryState.read ? Palette.accent-background.darker(0.35) : meta.faint;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                if item.last && item.delivery == DeliveryState.sending: Text {
                                    text: "Sending…";
                                    font-size: 0.72rem;
                                    font-italic: true;
                                    color: parent.faint;
                                }
                                // On every bubble that failed, not only a run's last.
                                if item.delivery == DeliveryState.failed: Rectangle {
                                    background: #c4314b;
                                    border-radius: 4px;
                                    opacity: 0;
                                    init => { self.opacity = 1; }
                                    animate opacity { duration: 200ms * Motion.scale; easing: ease-out; }
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: "Not sent";
                                            font-size: 0.72rem;
                                            font-weight: 700;
                                            color: white;
                                        }
                                    }
                                }
                            }
                        }
                        picker := ReactionPicker {
                            x: item.outgoing ? parent.width - self.width : 0;
                            // Over the bubble's edge by a little, so the pointer can move up onto it
                            // without ever leaving both.
                            y: 6px - self.height;
                            shown: root.picker-shown && root.can-react;
                            hovered(on) => { root.picker-hovered = on; }
                            picked(emoji) => {
                                // Gone with the pointer still on it: it won't say it left.
                                root.picker-hovered = false;
                                root.picker-shown = false;
                                root.react(emoji);
                            }
                        }
                        // Picked: a check at the corner facing the middle.
                        if item.selected: Rectangle {
                            x: item.outgoing ? -8px : parent.width - self.width + 8px;
                            y: -6px;
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: Palette.accent-background;
                            border-width: 2px;
                            border-color: Palette.background;
                            Icon {
                                source: @image-url("@lucide/check.svg");
                                tint: white;
                                width: 12px;
                                x: 4px;
                                y: 4px;
                            }
                        }
                    }
                    if item.reactions.length > 0: HorizontalLayout {
                        alignment: item.outgoing ? end : start;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        for reaction[i] in item.reactions: Rectangle {
                            opacity: i < root.reactions-at-start ? 1 : 0;
                            init => { self.opacity = 1; }
                            animate opacity { duration: 180ms * Motion.scale; easing: ease-out; }
                            height: 24px;
                            width: chip.preferred-width + 14px;
                            border-radius: 12px;
                            background: reaction.mine ? Palette.accent-background.with-alpha(0.25) : Palette.alternate-background;
                            border-width: 1px;
                            border-color: reaction.mine ? Palette.accent-background : Palette.border;
                            TouchArea {
                                accessible-role: button;
                                accessible-label: reaction.emoji + " " + reaction.count + (reaction.mine ? ", yours" : "");
                                accessible-action-default => { self.clicked(); }
                                mouse-cursor: pointer;
                                clicked => { root.react(reaction.emoji); }
                            }
                            chip := Text {
                                text: reaction.count > 1 ? reaction.emoji + " " + reaction.count : reaction.emoji;
                                font-size: 0.85rem;
                                color: Palette.foreground;
                            }
                        }
                    }
                }
                if !item.outgoing: VerticalLayout {
                    alignment: center;
                    IconButton {
                        label: "Reply";
                        icon: @image-url("@lucide/reply.svg");
                        visible: !item.deleted;
                        shown: root.hovered;
                        clicked => { root.reply(); }
                    }
                }
            }
        }
    }

    // While messages are picked, or Ctrl is held, a click anywhere on the row picks this
    // message or unpicks it; with Shift, everything from the one last picked.
    if root.selecting || root.pick-held: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if event.modifiers.shift {
                    root.select-through();
                } else {
                    root.toggle-select();
                }
            }
        }
    }

    // On top: it takes only right clicks.
    ContextMenuArea {
        Menu {
            if !item.notice: MenuItem {
                title: item.selected ? "Unselect" : "Select";
                activated => { root.toggle-select(); }
            }
            if !item.deleted && !item.notice: MenuItem {
                title: "Reply";
                activated => { root.reply(); }
            }
            if !item.deleted && !item.notice: MenuItem {
                title: "React…";
                activated => { root.picker-shown = true; }
            }
            if TextSelection.owner == root.index: MenuItem {
                title: "Copy selection";
                activated => { TextSelection.copy(); }
            }
            if item.text != "": MenuItem {
                title: "Copy text";
                activated => { root.copy-text(item.text); }
            }
            if item.can-forward: MenuItem {
                title: "Forward…";
                activated => { root.forward(); }
            }
            if item.can-edit: MenuItem {
                title: "Edit";
                activated => { root.edit(); }
            }
            if !item.deleted && !item.notice: MenuSeparator {}
            if !item.notice: MenuItem {
                title: "Delete for me";
                activated => { root.delete(false); }
            }
            if item.can-edit: MenuItem {
                title: "Delete for everyone";
                activated => { root.delete(true); }
            }
        }
    }
}

// One entry of the activity strip: a week or a month, or a long silence folded into one.
// Positions are fractions of the strip's height.
export struct ActivityItem {
    y: float,
    height: float,
    // 0–1 each, on a square-root scale so quiet weeks still show next to busy ones.
    mine: float,
    others: float,
    media: bool,
    quiet: bool,
    // Set where a new year begins.
    year: string,
    label: string,
    summary: string,
    // Indexes into the messages: its first, and one past its last.
    first: int,
    end: int,
}

// When a chat was active, from its first message at the top to now at the bottom: others'
// messages left of the centre line, ours right of it, a dot where photos or videos were shared.
component ActivityStrip inherits Rectangle {
    in property <[ActivityItem]> items;
    // The messages in view, marked on the strip.
    in property <int> top;
    in property <int> bottom;
    callback jump(int);
    property <int> hovered: -1;
    property <length> centre: 38px;
    property <length> reach: 11px;
    width: 56px;
    background: Palette.alternate-background;

    for item[i] in root.items: Rectangle {
        y: item.y * root.height;
        height: item.height * root.height;
        // Thin rows touch; thicker ones keep a hairline apart.
        property <length> bar-height: max(1px, self.height - (self.height >= 3px ? 1px : 0px));
        if item.first <= root.bottom && item.end > root.top: Rectangle {
            x: root.centre - root.reach - 3px;
            width: 2 * root.reach + 6px;
            background: Palette.accent-background.with-alpha(0.2);
        }
        if item.quiet: Text {
            x: root.centre - self.width / 2;
            text: "⋯";
            font-size: 0.75rem;
            vertical-alignment: center;
            color: Palette.foreground.with-alpha(0.45);
        }
        if !item.quiet: Rectangle {
            x: root.centre - item.others * root.reach;
            y: 0;
            width: item.others * root.reach;
            height: parent.bar-height;
            background: Palette.foreground.with-alpha(0.45);
        }
        if !item.quiet: Rectangle {
            x: root.centre;
            y: 0;
            width: item.mine * root.reach;
            height: parent.bar-height;
            background: Palette.accent-background;
        }
        if item.media: Rectangle {
            x: root.width - 6px;
            y: (parent.height - self.height) / 2;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Palette.foreground.with-alpha(0.6);
        }
        if item.year != "": Text {
            x: 3px;
            y: 0;
            text: item.year;
            font-size: 0.65rem;
            color: Palette.foreground.with-alpha(0.6);
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.jump(item.first); }
            changed has-hover => {
                if self.has-hover {
                    root.hovered = i;
                } else if root.hovered == i {
                    root.hovered = -1;
                }
            }
        }
    }
    Rectangle { width: 1px; x: 0; background: Palette.border; }

    // What the hovered entry holds, over the messages to the left.
    if root.hovered >= 0 && root.hovered < root.items.length: Rectangle {
        // Fades in as it appears.
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 100ms * Motion.scale; easing: ease-out; }
        x: -self.width - 6px;
        y: clamp(root.items[root.hovered].y * root.height - 6px, 0px, root.height - self.height);
        width: tip.preferred-width;
        height: tip.preferred-height;
        border-radius: 6px;
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0003;
        tip := VerticalLayout {
            padding: 6px;
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: root.items[root.hovered].label;
                font-size: 0.85rem;
                font-weight: 600;
                color: Palette.foreground;
            }
            Text {
                text: root.items[root.hovered].summary;
                font-size: 0.8rem;
                color: Palette.foreground.with-alpha(0.7);
            }
        }
    }
}

// A day of the activity calendar, in a year's grid of weeks (columns) and weekdays (rows).
export struct DayCell {
    column: int,
    row: int,
    // 0 for none, up to 1 for the busiest day of the chat.
    level: float,
    label: string,
    summary: string,
    // Index of its first message; only days with messages can be opened.
    first: int,
    active: bool,
    // Before the chat began, or still to come: drawn fainter than a day without messages.
    outside: bool,
}

export struct CalendarYear {
    year: string,
    summary: string,
    // Without messages: a line instead of a grid.
    quiet: bool,
    days: [DayCell],
    // Each month's first column, January first.
    months: [int],
}

// A chat year by year, a cell per day, coloured by how much was written.
component ActivityCalendar inherits Rectangle {
    in property <[CalendarYear]> years;
    in property <string> summary;
    callback jump(int);
    callback close;
    background: Palette.background;
    property <length> gap: 2px;
    property <length> labels: 30px;
    // As large as fits 53 weeks, within reason.
    property <length> cell: clamp((root.width - 32px - root.labels) / 53 - root.gap, 5px, 13px);
    property <string> tip-label;
    property <string> tip-summary;
    property <length> tip-x;
    property <length> tip-y;

    VerticalLayout {
        HorizontalLayout {
            padding: 16px;
            padding-bottom: 8px;
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: "Activity";
                    font-size: 1.05rem;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                Text {
                    text: root.summary;
                    font-size: 0.85rem;
                    wrap: word-wrap;
                    color: Palette.foreground.with-alpha(0.65);
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Back to chat";
                    clicked => { root.close(); }
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content-width: self.width;
            content := VerticalLayout {
                padding: 16px;
                spacing: 18px;
                alignment: start;
                for year in root.years: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: year.year;
                            font-weight: 700;
                            color: Palette.foreground;
                        }
                        Text {
                            text: year.summary;
                            font-size: 0.85rem;
                            vertical-alignment: center;
                            color: Palette.foreground.with-alpha(0.65);
                        }
                    }
                    if !year.quiet: Rectangle {
                        height: 16px + 7 * (root.cell + root.gap);
                        width: root.labels + 53 * (root.cell + root.gap);
                        for column[m] in year.months: Text {
                            x: root.labels + column * (root.cell + root.gap);
                            y: 0;
                            text: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][m];
                            font-size: 0.7rem;
                            color: Palette.foreground.with-alpha(0.6);
                        }
                        for name[row] in ["Mon", "", "Wed", "", "Fri", "", ""]: Text {
                            x: 0;
                            y: 16px + row * (root.cell + root.gap) + (root.cell - self.height) / 2;
                            text: name;
                            font-size: 0.65rem;
                            color: Palette.foreground.with-alpha(0.6);
                        }
                        for day in year.days: Rectangle {
                            x: root.labels + day.column * (root.cell + root.gap);
                            y: 16px + day.row * (root.cell + root.gap);
                            width: root.cell;
                            height: root.cell;
                            border-radius: 2px;
                            background: day.outside ? Palette.foreground.with-alpha(0.025)
                                : day.level <= 0 ? Palette.foreground.with-alpha(0.07)
                                : Palette.accent-background.with-alpha(0.3 + 0.7 * day.level);
                            border-width: touch.has-hover && day.active ? 1px : 0px;
                            border-color: Palette.foreground;
                            touch := TouchArea {
                                enabled: day.active;
                                mouse-cursor: pointer;
                                clicked => { root.jump(day.first); }
                                changed has-hover => {
                                    if self.has-hover {
                                        root.tip-label = day.label;
                                        root.tip-summary = day.summary;
                                        root.tip-x = parent.absolute-position.x - root.absolute-position.x;
                                        root.tip-y = parent.absolute-position.y - root.absolute-position.y;
                                    } else if root.tip-label == day.label {
                                        root.tip-label = "";
                                    }
                                }
                            }
                        }
                    }
                }
                // Legend.
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: "Less";
                        font-size: 0.75rem;
                        vertical-alignment: center;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                    for level in [0, 0.25, 0.5, 0.75, 1]: Rectangle {
                        width: 11px;
                        height: 11px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 2px;
                        background: level <= 0 ? Palette.foreground.with-alpha(0.07)
                            : Palette.accent-background.with-alpha(0.3 + 0.7 * level);
                    }
                    Text {
                        text: "More";
                        font-size: 0.75rem;
                        vertical-alignment: center;
                        color: Palette.foreground.with-alpha(0.6);
                    }
                }
            }
        }
    }

    if root.tip-label != "": Rectangle {
        // Fades in as it appears.
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 100ms * Motion.scale; easing: ease-out; }
        x: clamp(root.tip-x - self.width / 2, 4px, root.width - self.width - 4px);
        y: root.tip-y - self.height - 6px;
        width: tip.preferred-width;
        height: tip.preferred-height;
        border-radius: 6px;
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0003;
        tip := VerticalLayout {
            padding: 6px;
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: root.tip-label;
                font-size: 0.85rem;
                font-weight: 600;
                color: Palette.foreground;
            }
            Text {
                text: root.tip-summary;
                font-size: 0.8rem;
                color: Palette.foreground.with-alpha(0.7);
            }
        }
    }
}

component PasswordScreen inherits Rectangle {
    // Choosing a password for a new database, rather than unlocking an existing one.
    in property <bool> new;
    in property <string> error;
    property <string> confirmation;
    callback unlock(string, string);

    background: Palette.background;
    forward-focus: password-field;

    function submit() {
        root.unlock(password-field.text, root.confirmation);
        password-field.text = "";
        root.confirmation = "";
        password-field.focus();
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 360px;
                spacing: 12px;
                Text {
                    text: root.new ? "Choose a password" : "Unlock b33p";
                    font-size: 1.6rem;
                    font-weight: 600;
                    horizontal-alignment: center;
                    color: Palette.foreground;
                }
                Text {
                    text: root.new
                        ? "No system keyring was found, so b33p will encrypt your messages with this password. It can't be recovered if you forget it."
                        : "Enter the password that protects your messages on this computer.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    color: Palette.foreground.with-alpha(0.7);
                }
                password-field := LineEdit {
                    input-type: password;
                    placeholder-text: "Password";
                    // When choosing a password, Tab leads on to the confirmation field.
                    accepted => {
                        if !root.new { root.submit(); }
                    }
                }
                if root.new: LineEdit {
                    text <=> root.confirmation;
                    input-type: password;
                    placeholder-text: "Repeat password";
                    accepted => { root.submit(); }
                }
                if root.error != "": Text {
                    text: root.error;
                    color: #c4314b;
                    horizontal-alignment: center;
                }
                Button {
                    text: root.new ? "Continue" : "Unlock";
                    primary: true;
                    clicked => { root.submit(); }
                }
            }
        }
    }
}

component LinkScreen inherits Rectangle {
    in property <image> qr;
    background: Palette.background;
    VerticalLayout {
        alignment: center;
        spacing: 20px;
        Text {
            text: "Link b33p to your phone";
            font-size: 1.6rem;
            font-weight: 600;
            horizontal-alignment: center;
            color: Palette.foreground;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 280px;
                height: 280px;
                border-radius: 12px;
                background: white;
                drop-shadow-blur: 12px;
                drop-shadow-color: #0003;
                Image {
                    width: parent.width - 24px;
                    height: self.width;
                    source: qr;
                    image-rendering: pixelated;
                }
            }
        }
        Text {
            text: "On your phone, open Signal → Settings → Linked devices → Link new device,\nthen scan this code.";
            horizontal-alignment: center;
            color: Palette.foreground.with-alpha(0.7);
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.label; color: Palette.foreground; }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 0.85rem;
            wrap: word-wrap;
            color: Palette.foreground.with-alpha(0.6);
        }
    }
    // The controls' column: each keeps its own height, centered beside the label and hint,
    // and they all end at the same right edge.
    VerticalLayout {
        alignment: center;
        width: 200px;
        HorizontalLayout {
            alignment: end;
            @children
        }
    }
}

component SectionTitle inherits Text {
    font-size: 0.85rem;
    font-weight: 700;
    color: Palette.accent-background;
}

component SettingsPage inherits Rectangle {
    // Qt draws the window (Linux): its style is chosen, its colours are the desktop's. Elsewhere
    // there is no style to choose, but a theme.
    in property <bool> qt;
    in-out property <int> theme;
    in-out property <int> widget-style;
    in property <string> style-note;
    in-out property <int> text-size;
    // In the order of `Animations::ALL`.
    in-out property <int> animations;
    in-out property <bool> show-avatars;
    in-out property <bool> notifications;
    in-out property <int> notification-content;
    in-out property <bool> show-activity;
    in-out property <bool> show-calendar;
    in-out property <bool> close-to-tray;
    // Whether the desktop shows tray icons; without, closing the window quits.
    in property <bool> tray-available: true;
    in property <bool> autostart-supported;
    in-out property <bool> start-with-system;
    in-out property <bool> read-receipts;
    in-out property <bool> typing-indicators;
    in-out property <bool> link-previews;
    in-out property <bool> sync-to-phone;
    in property <string> account;
    in property <string> device-name;
    callback changed-settings;
    callback changed-start-with-system(bool);
    callback opened;
    callback close;

    // Shown only while open, so this runs each time it opens.
    init => { root.opened(); }

    VerticalLayout {
        Rectangle {
            height: 60px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Text {
                    text: "Settings";
                    font-size: 1.1rem;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    color: Palette.foreground;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: "Back";
                        clicked => { root.close(); }
                    }
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
        }
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: center;
                padding-left: 24px;
                padding-right: 24px;
                VerticalLayout {
                    preferred-width: 520px;
                    max-width: 520px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 14px;
                    alignment: start;

                    SectionTitle { text: "Appearance"; }
                    // Qt's styles take their colours from the desktop.
                    if !root.qt: SettingRow {
                        label: "Theme";
                        ComboBox {
                            width: 200px;
                            model: ["System", "Light", "Dark"];
                            current-index <=> root.theme;
                            selected => { root.changed-settings(); }
                        }
                    }
                    if root.qt: SettingRow {
                        label: "Style";
                        hint: root.style-note;
                        ComboBox {
                            width: 200px;
                            // In the order of `WidgetStyle::ALL`.
                            model: ["System", "Fusion"];
                            current-index <=> root.widget-style;
                            selected => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Text size";
                        ComboBox {
                            width: 200px;
                            model: ["Small", "Default", "Large"];
                            current-index <=> root.text-size;
                            selected => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Animations";
                        hint: "System follows your desktop's setting for reduced motion.";
                        ComboBox {
                            width: 200px;
                            model: ["System", "On", "Off"];
                            current-index <=> root.animations;
                            selected => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Profile pictures";
                        hint: "Show contacts' and groups' pictures instead of initials.";
                        Switch {
                            checked <=> root.show-avatars;
                            toggled => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Chats"; }
                    SettingRow {
                        label: "Activity strip";
                        hint: "A bar beside each chat showing when you wrote, and how much. Click it to jump there.";
                        Switch {
                            checked <=> root.show-activity;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Activity calendar";
                        hint: "A button above each chat opens a calendar of it, year by year. Click a day to go there.";
                        Switch {
                            checked <=> root.show-calendar;
                            toggled => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Notifications"; }
                    SettingRow {
                        label: "New messages";
                        hint: "Notify about messages unless their chat is open in front.";
                        Switch {
                            checked <=> root.notifications;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Show";
                        ComboBox {
                            width: 200px;
                            enabled: root.notifications;
                            model: ["Name and message", "Name only", "Nothing"];
                            current-index <=> root.notification-content;
                            selected => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Privacy"; }
                    SettingRow {
                        label: "Read receipts";
                        hint: "Let people know when you've read their messages. Turned off, you don't see theirs either on your phone.";
                        Switch {
                            checked <=> root.read-receipts;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Typing indicators";
                        hint: "Let people see when you're typing.";
                        Switch {
                            checked <=> root.typing-indicators;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Link previews";
                        hint: "Add a preview of the first link to messages you send. b33p fetches the page itself, so the site sees your IP address.";
                        Switch {
                            checked <=> root.link-previews;
                            toggled => { root.changed-settings(); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Background"; }
                    SettingRow {
                        label: "Keep running in the tray";
                        hint: root.tray-available
                            ? "Closing the window leaves b33p in the tray, still receiving messages."
                            : "Your desktop doesn't show tray icons, so closing the window quits b33p.";
                        Switch {
                            enabled: root.tray-available;
                            checked <=> root.close-to-tray;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    if root.autostart-supported: SettingRow {
                        label: "Start with the system";
                        hint: root.close-to-tray && root.tray-available ? "Starts in the tray when you log in." : "Opens b33p when you log in.";
                        Switch {
                            checked <=> root.start-with-system;
                            toggled => { root.changed-start-with-system(self.checked); }
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Keyboard shortcuts"; }
                    for shortcut in [
                        { keys: "Ctrl+K", what: "Search chats" },
                        { keys: "Ctrl+F", what: "Search this chat" },
                        { keys: "Alt+↑ / Alt+↓", what: "Previous / next chat" },
                        { keys: "Alt+Shift+↓", what: "Next unread chat" },
                        { keys: "Alt+1 … Alt+9", what: "Pinned chats" },
                        { keys: "↑", what: "Edit your last message (in an empty composer)" },
                        { keys: "Shift+Enter", what: "New line" },
                        { keys: "Ctrl+V", what: "Paste text, a picture or files" },
                        { keys: "Ctrl+click", what: "Select a message; Shift+click selects up to it, Esc clears" },
                        { keys: "Ctrl+C", what: "Copy the text selected in a message" },
                        { keys: "Esc", what: "Close, stop replying or editing, or clear the search or selection" },
                    ]: HorizontalLayout {
                        spacing: 16px;
                        Text {
                            text: shortcut.keys;
                            min-width: 140px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                        Text {
                            text: shortcut.what;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                    }

                    Rectangle { height: 8px; }
                    SectionTitle { text: "Account"; }
                    SettingRow {
                        label: "Account";
                        Text {
                            text: root.account;
                            overflow: elide;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                    }
                    SettingRow {
                        label: "Sync chat settings to your phone";
                        hint: "Pinned, muted, archived and blocked chats and accepted requests changed here go to your phone too. Off: they stay on this computer, and changes on the phone still come here.";
                        Switch {
                            checked <=> root.sync-to-phone;
                            toggled => { root.changed-settings(); }
                        }
                    }
                    SettingRow {
                        label: "Device name";
                        hint: "How this computer appears under Linked devices on your phone.";
                        Text {
                            text: root.device-name;
                            vertical-alignment: center;
                            color: Palette.foreground.with-alpha(0.7);
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // Rust says "MOCK" here when the mock backend runs, since it sends nothing.
    in property <string> window-title: "b33p";
    title: root.window-title;
    icon: @image-url("../assets/b33p.svg");
    min-width: 360px;
    min-height: 480px;
    preferred-width: 1000px;
    preferred-height: 680px;
    background: Palette.background;

    in property <Screen> screen: Screen.connecting;
    in property <image> link-qr;
    in property <bool> password-new;
    in property <string> password-error;
    in property <string> account;
    in property <string> error;
    in property <bool> synced;
    // Progress of the message history transfer after linking; empty when there is none.
    in property <string> history-status;
    in property <bool> history-skippable;
    in property <[ConversationItem]> conversations;
    in property <[MessageItem]> messages;
    // The open chat's row in `conversations`; -1 if none, or while a search leaves it out.
    in property <int> selected: -1;
    // The open chat's id, empty if none.
    in property <string> selected-id;
    // The open chat, also while a search leaves it out of `conversations`.
    in property <ConversationItem> current;
    in property <bool> can-send;
    in-out property <string> draft;

    // Settings: indexes into the choices shown on the settings page.
    in-out property <int> theme;
    in-out property <int> widget-style;
    // Whether Qt draws the window; see `SettingsPage`.
    in property <bool> qt;
    // Explains a style change that waits for a restart; empty otherwise.
    in property <string> style-note;
    in-out property <int> text-size: 1;
    in-out property <int> animations;
    in-out property <bool> show-avatars: true;
    in-out property <bool> notifications: true;
    in-out property <bool> close-to-tray: true;
    in property <bool> tray-available: true;
    in property <bool> autostart-supported;
    in-out property <bool> start-with-system;
    in-out property <int> notification-content;
    in-out property <bool> read-receipts: true;
    in-out property <bool> typing-indicators: true;
    in-out property <bool> link-previews;
    in-out property <bool> sync-to-phone;
    in-out property <bool> show-activity;
    // The open chat's activity strip; empty while the strip is off.
    in property <[ActivityItem]> activity;
    in-out property <bool> show-calendar;
    // The open chat's calendar, filled when it opens.
    in-out property <bool> calendar-open;
    in property <[CalendarYear]> calendar;
    in property <string> calendar-summary;
    callback open-calendar;
    // By id: the open chat's place in the list changes as chats move.
    changed selected-id => { root.calendar-open = false; }
    in property <string> device-name;
    in-out property <bool> settings-open;
    // Factor for the chosen text size, applied to the platform's font size, which is captured
    // before it is changed.
    in property <float> font-scale: 1.0;
    property <length> platform-font-size;

    function apply-settings() {
        Palette.color-scheme = root.qt ? ColorScheme.unknown
            : root.theme == 1 ? ColorScheme.light
            : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        root.default-font-size = root.platform-font-size * root.font-scale;
    }
    init => {
        // `default-font-size` reads 0 while unset; `1rem` resolves it to the platform's size.
        root.platform-font-size = 1rem;
        root.apply-settings();
    }
    changed theme => { root.apply-settings(); }
    changed qt => { root.apply-settings(); }
    changed font-scale => { root.apply-settings(); }

    callback select(string);
    callback draft-edited(string);
    callback send(string);
    callback dismiss-error;
    callback unlock(string, string);
    callback settings-changed;
    callback start-with-system-changed(bool);
    callback settings-opened;
    callback skip-history;
    callback search(string);
    callback open-attachment(string);
    callback open-link(string);
    callback attach;
    // From Rust, once the file picker is done.
    callback stage-files([string]);
    callback unstage(int);
    callback back;
    // Names of files waiting to go out with the next message.
    in property <[string]> staged;
    in-out property <length> sidebar-width: 300px;
    // One pane at a time: the list, or the open chat with a way back. Kept up to date when
    // the width changes rather than bound to it, since the layout depends on it in turn.
    out property <bool> narrow;
    changed width => { root.narrow = root.width < 640px; }
    callback reply(int);
    callback react(int, string);
    callback cancel-reply;
    // The message the composer answers; both empty when not replying.
    in property <string> reply-author;
    in property <string> reply-text;
    in-out property <string> search-text;
    callback fetch-attachment(string);
    callback save-attachment(string);
    // See `ConversationMenu`; each takes the conversation's id first.
    callback toggle-pin(string);
    callback move-pin(string, int);
    callback mark-read(string, bool);
    callback mute(string, int);
    callback archive(string, bool);
    callback set-timer(string, int);
    callback block(string, bool);
    // Answers the open chat's message request: 0 accept, 1 delete, 2 block.
    callback respond(RequestAnswer);
    callback show-archived(bool);
    // Scrolled near the top of the open chat: older messages, if there are any.
    callback load-older;
    callback edit(int);
    callback delete(int, bool);
    callback reveal(int);
    // Messages picked for an action on all of them (Ctrl+click, or "Select" in a message's
    // menu): how many, what they say (to copy), and what can be done with them. Esc unpicks
    // them (see `shortcut`).
    in property <int> selected-count;
    in property <string> selection-text;
    in property <bool> can-forward-selection;
    in property <bool> can-delete-selection-for-everyone;
    callback toggle-select(int);
    callback select-through(int);
    callback clear-selection;
    callback forward-selection;
    callback delete-selection(bool);
    // Ctrl is held: a click on a message picks it.
    property <bool> pick-held;
    callback cancel-edit;
    // How many chats are archived, and how many of those have unread messages.
    in property <int> archived-count;
    in property <int> archived-unread;
    in property <bool> showing-archived;
    // The phone's chat folders as tabs (with their unread counts); `folder` is the one shown,
    // -1 for all chats.
    in property <[string]> folders;
    in property <[int]> folder-unread;
    in property <int> folder: -1;
    callback show-folder(int);
    // Who is typing in the open chat, e.g. "Ann is typing…"; empty if nobody is.
    in property <string> typing;
    // The composer replaces the text of one of our messages.
    in property <bool> editing;
    // The open chat's details page.
    in property <bool> details-open;
    in property <bool> details-busy;
    in property <string> details-about;
    in property <string> details-phone;
    // In lines of four groups; empty if there is none.
    in property <string> details-safety-number;
    // We (here or on another device) verified that safety number, for the key it is now.
    in property <bool> details-verified;
    // Verified before, but their key changed since.
    in property <bool> details-safety-changed;
    in property <string> details-description;
    in property <[MemberItem]> details-members;
    callback open-details;
    callback close-details;
    // Changing the open group from its details page.
    callback rename-group(string);
    // Marks the safety number verified (true) or clears that.
    callback set-verified(bool);
    // Accepts the changed safety number of the contact with this id, to write to them again.
    callback confirm-safety-number(string);
    // Answers the invitation to the group with this id: join (true) or turn it down.
    callback answer-invitation(string, bool);
    callback describe-group(string);
    // Picks a file for the group's picture (the UI asks), then sets it from that path.
    callback change-group-picture;
    callback group-picture-chosen(string);
    callback remove-group-picture;
    callback set-member-admin(string, bool);
    callback remove-member(string);
    callback leave-group;
    // Choosing people for a new group, or to add to the open one.
    in property <bool> group-draft-open;
    in property <bool> group-draft-new;
    in-out property <string> group-draft-name;
    // Whether text is empty or only spaces, which make no name.
    pure callback is-blank(string) -> bool;
    in-out property <string> group-draft-filter;
    // What is typed in the chat search, or the group dialog's search, is a phone number to look up.
    in property <bool> search-is-number;
    in property <bool> group-filter-is-number;
    // Looks up who a phone number belongs to; then opens their chat (true) or chooses them for
    // the group (false).
    callback find-number(string, bool);
    in property <[CandidateItem]> group-candidates;
    in property <int> group-draft-chosen;
    callback open-new-group;
    // Joining a group through its invite link.
    in property <bool> join-open;
    in-out property <string> join-link;
    // The link is being looked up, or the group joined.
    in property <bool> join-busy;
    // What the link shows of its group, once looked up; the title is empty until then.
    in property <string> join-title;
    in property <int> join-members;
    // An admin has to let us in; we asked already.
    in property <bool> join-approval;
    in property <bool> join-requested;
    callback open-join-group;
    callback close-join-group;
    callback preview-group-link(string);
    callback join-group;
    // The open group's invite link (empty while off), who it lets in (0 off, 1 anyone,
    // 2 after an admin's approval), and who asked to join through it.
    in property <string> details-invite-link;
    in property <int> details-invite-access;
    in property <[MemberItem]> details-requests;
    callback set-invite-link(int);
    callback reset-invite-link;
    // Lets the person with this id in (true), or turns them down.
    callback answer-join-request(string, bool);
    // Takes back our own request to join the open group.
    callback cancel-join-request;
    callback open-add-members;
    callback toggle-candidate(string);
    callback group-draft-edited;
    callback finish-group-draft;
    callback close-group-draft;
    // The open chat's media, files and links.
    in property <bool> media-open;
    // Gathering them.
    in property <bool> media-busy;
    in property <[AttachmentItem]> media-tiles;
    in property <[SharedItem]> media-files;
    in property <[SharedItem]> media-links;
    in-out property <int> media-tab;
    callback open-media;
    callback close-media;
    // Searching the open chat.
    in property <bool> chat-search-open;
    in-out property <string> chat-search-text;
    // Looking, no results yet.
    in property <bool> chat-search-busy;
    in property <[SearchResult]> search-results;
    callback open-chat-search;
    callback close-chat-search;
    callback chat-search(string);
    callback show-result(int);
    // Scroll the open chat to this row once `jump-serial` changes.
    in property <int> jump-row;
    in property <int> jump-serial;
    // Scroll the open chat to its end once this changes, e.g. after the user sent something.
    in property <int> scroll-to-end-serial;
    // A key pressed anywhere (its text, and whether Control, Alt and Shift were held): whether
    // it was a shortcut, which Rust then carried out.
    callback shortcut(string, bool, bool, bool) -> bool;
    // Ctrl+K asks the chat list's search field to take the focus by changing this.
    in property <int> focus-search-request;
    // ↑ in an empty composer: edit our last message.
    callback edit-last;
    // The sticker picker: installed packs' titles, the chosen one's stickers by row.
    in property <[string]> sticker-packs;
    in property <[StickerRow]> sticker-rows;
    in property <bool> stickers-busy;
    in-out property <int> sticker-pack;
    callback open-stickers;
    callback sticker-pack-chosen;
    callback send-sticker(string, int);
    // Stories: the overlay, who has them, the one shown, groups to post to.
    in-out property <bool> stories-open;
    in property <[RingItem]> story-rings;
    in property <StoryItem> story;
    in property <int> unviewed-stories;
    in property <[string]> story-groups;
    // Their ids, in the same order.
    in property <[string]> story-group-ids;
    in-out property <int> story-group;
    in-out property <string> story-text;
    callback open-stories;
    callback open-story(string);
    callback step-story(int);
    callback close-story;
    callback post-story-text;
    callback post-story-photo;
    // From Rust, once the file picker is done.
    callback story-photo-chosen(string);
    // Ctrl+V in the composer: attaches a copied picture or files. Rust looks in the clipboard
    // on a thread of its own (reading it here would hold up the window, which may be what has
    // to hand it over); if it holds neither, it counts `paste-text` up, and the text is pasted.
    callback paste;
    in-out property <int> paste-text;
    // Files dropped onto the open chat, to attach.
    callback files-dropped(DropEvent);
    // Choosing where to forward a message to.
    in property <bool> forwarding;
    in property <[ConversationItem]> forward-targets;
    // What the message says, to confirm where it goes.
    in property <string> forward-preview;
    // The style's accent color, for text Rust formats, e.g. what a search found.
    out property <color> accent: Palette.accent-background;
    in-out property <string> forward-filter;
    callback forward(int);
    callback forward-to(string);
    callback cancel-forward;
    callback forward-filter-edited;
    // Group members matching the "@…" the draft ends with.
    in property <[string]> mention-candidates;
    callback pick-mention(int);

    // Copies through a text input, the way Slint reaches the clipboard.
    clipboard := TextInput { visible: false; width: 0; height: 0; }
    function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
    }

    // Bumped when Esc closed something: what had the focus may be gone with it, and keys would
    // then go nowhere until a click.
    in-out property <int> escaped;
    changed escaped => { keys.focus(); }

    // Shortcuts that work wherever the focus is; see `shortcut`.
    keys := FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;
    capture-key-pressed(event) => {
        if event.text == Key.Control {
            root.pick-held = true;
        }
        // Text selected in a message: Ctrl+C copies it, Esc drops it. (Writing in the composer
        // drops it too, so Ctrl+C there copies the composer's own selection.)
        if TextSelection.owner != -1 {
            if event.modifiers.control && (event.text == "c" || event.text == "C") {
                TextSelection.copy();
                return accept;
            }
            if event.text == Key.Escape {
                TextSelection.clear();
                return accept;
            }
        }
        if root.shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift) {
            return accept;
        }
        return reject;
    }
    capture-key-released(event) => {
        if event.text == Key.Control {
            root.pick-held = false;
        }
        return reject;
    }
    VerticalLayout {
        // Slides down from the top and back: always there, its height following whether there is
        // an error, which it keeps showing while it closes.
        error-banner := Rectangle {
            property <string> error: root.error;
            property <string> shown: root.error;
            changed error => {
                if self.error != "" {
                    self.shown = self.error;
                }
            }
            height: root.error != "" ? 36px : 0px;
            animate height { duration: 150ms * Motion.scale; easing: ease-out; }
            clip: true;
            visible: self.height > 0px;
            background: #c4314b;
            HorizontalLayout {
                y: 0;
                height: 36px;
                padding-left: 16px;
                padding-right: 8px;
                Text {
                    text: error-banner.shown;
                    color: white;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("@lucide/x.svg");
                        label: "Dismiss";
                        tint: white;
                        clicked => { root.dismiss-error(); }
                    }
                }
            }
        }

        if root.screen == Screen.connecting: Rectangle {
            // Fades in, as each screen does.
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                HorizontalLayout { alignment: center; Spinner { indeterminate: true; } }
                Text {
                    text: "Connecting to Signal…";
                    horizontal-alignment: center;
                    color: Palette.foreground.with-alpha(0.7);
                }
            }
        }

        if root.screen == Screen.password: PasswordScreen {
            // Fades in, as each screen does; ready to type into.
            opacity: 0;
            init => {
                self.opacity = 1;
                self.focus();
            }
            animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
            new: root.password-new;
            error: root.password-error;
            unlock(password, confirmation) => { root.unlock(password, confirmation); }
        }

        if root.screen == Screen.link: LinkScreen {
            qr: root.link-qr;
            // Fades in, as each screen does.
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
        }

        if root.screen == Screen.chats: Rectangle {
            // Fades in, as each screen does.
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
            HorizontalLayout {
                // Sidebar: the whole window when narrow and nothing is open.
                if !root.narrow || (root.selected-id == "" && !root.settings-open): Rectangle {
                    // Fixed (but draggable) beside a chat; the whole window when narrow.
                    horizontal-stretch: root.narrow ? 1 : 0;
                    min-width: root.narrow ? 0px : root.sidebar-width;
                    max-width: root.narrow ? 100000px : root.sidebar-width;
                    background: Palette.alternate-background;
                    VerticalLayout {
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 4px;
                            spacing: 4px;
                            height: 32px + self.padding-top + self.padding-bottom;
                            if root.showing-archived: IconButton {
                                icon: @image-url("@lucide/arrow-left.svg");
                                label: "Back to chats";
                                clicked => { root.show-archived(false); }
                            }
                            Text {
                                text: root.showing-archived ? "Archived" : "Chats";
                                font-size: 1.3rem;
                                font-weight: 700;
                                color: Palette.foreground;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                icon: @image-url("@lucide/circle-dashed.svg");
                                label: root.unviewed-stories > 0 ? "Stories, " + root.unviewed-stories + " new" : "Stories";
                                badge: root.unviewed-stories > 0;
                                clicked => {
                                    root.stories-open = true;
                                    root.open-stories();
                                }
                            }
                            IconButton {
                                icon: @image-url("@lucide/plus.svg");
                                label: "New group";
                                clicked => {
                                    root.group-draft-name = "";
                                    root.group-draft-filter = "";
                                    root.open-new-group();
                                }
                            }
                            IconButton {
                                icon: @image-url("@lucide/link.svg");
                                label: "Join a group by link";
                                clicked => {
                                    root.join-link = "";
                                    root.open-join-group();
                                }
                            }
                            IconButton {
                                icon: @image-url("@lucide/settings.svg");
                                label: "Settings";
                                active: root.settings-open;
                                clicked => { root.settings-open = !root.settings-open; }
                            }
                        }
                        if root.history-status != "": HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-bottom: 8px;
                            spacing: 8px;
                            Spinner {
                                indeterminate: true;
                                width: 16px;
                                height: 16px;
                            }
                            Text {
                                text: root.history-status;
                                wrap: word-wrap;
                                font-size: 0.85rem;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                color: Palette.foreground.with-alpha(0.7);
                            }
                            if root.history-skippable: VerticalLayout {
                                alignment: center;
                                Button {
                                    text: "Skip";
                                    clicked => { root.skip-history(); }
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 8px;
                            LineEdit {
                                placeholder-text: "Search or start a chat";
                                text <=> root.search-text;
                                property <int> focus-request: root.focus-search-request;
                                changed focus-request => { self.focus(); }
                                edited(text) => { root.search(text); }
                            }
                        }
                        if root.search-is-number: HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 8px;
                            Button {
                                text: "Message " + root.search-text;
                                clicked => { root.find-number(root.search-text, true); }
                            }
                        }
                        if root.folders.length > 0 && !root.showing-archived && root.search-text == "": HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-bottom: 6px;
                            spacing: 4px;
                            alignment: start;
                            for name[index] in ["All"]: Rectangle {
                                width: all-label.preferred-width + 20px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.folder == -1 ? Palette.accent-background.with-alpha(0.18)
                                    : all-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                all-touch := TouchArea {
                                    accessible-role: AccessibleRole.tab;
                                    accessible-label: "All chats";
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => { root.show-folder(-1); }
                                }
                                all-label := Text {
                                    text: name;
                                    font-size: 0.85rem;
                                    font-weight: root.folder == -1 ? 600 : 400;
                                    color: Palette.foreground;
                                }
                            }
                            for name[index] in root.folders: Rectangle {
                                width: folder-label.preferred-width + 20px;
                                height: 28px;
                                border-radius: 14px;
                                background: root.folder == index ? Palette.accent-background.with-alpha(0.18)
                                    : folder-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                folder-touch := TouchArea {
                                    accessible-role: AccessibleRole.tab;
                                    accessible-label: name;
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => { root.show-folder(index); }
                                }
                                folder-label := Text {
                                    text: root.folder-unread[index] > 0 ? name + " " + root.folder-unread[index] : name;
                                    font-size: 0.85rem;
                                    font-weight: root.folder == index ? 600 : 400;
                                    color: Palette.foreground;
                                }
                            }
                        }
                        if root.archived-count > 0 && !root.showing-archived && root.search-text == "": HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Rectangle {
                                height: 40px;
                                border-radius: 6px;
                                background: archive-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                archive-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Archived chats, " + root.archived-count;
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => { root.show-archived(true); }
                                }
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 12px;
                                    // In the avatars' column.
                                    Rectangle {
                                        width: 40px;
                                        Icon {
                                            source: @image-url("@lucide/archive.svg");
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                    Text {
                                        text: "Archived chats";
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        color: Palette.foreground.with-alpha(0.8);
                                    }
                                    Text {
                                        text: root.archived-unread > 0 ? root.archived-count + " · " + root.archived-unread + " unread" : root.archived-count;
                                        font-size: 0.8rem;
                                        vertical-alignment: center;
                                        color: Palette.foreground.with-alpha(0.55);
                                    }
                                }
                            }
                        }
                        ListView {
                            for item[index] in root.conversations: HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                ConversationRow {
                                    item: item;
                                    selected: index == root.selected;
                                    clicked => {
                                        root.settings-open = false;
                                        root.select(item.id);
                                    }
                                    toggle-pin => { root.toggle-pin(item.id); }
                                    move-pin(by) => { root.move-pin(item.id, by); }
                                    mark-read(read) => { root.mark-read(item.id, read); }
                                    mute(seconds) => { root.mute(item.id, seconds); }
                                    archive(archived) => { root.archive(item.id, archived); }
                                    block(blocked) => { root.block(item.id, blocked); }
                                }
                            }
                        }
                    }
                }
                // The divider; drag it to resize the sidebar.
                if !root.narrow: Rectangle {
                    width: 1px;
                    background: Palette.border;
                    TouchArea {
                        x: -3px;
                        width: 7px;
                        mouse-cursor: col-resize;
                        moved => {
                            root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 220px, 480px);
                        }
                    }
                }

                if root.settings-open: SettingsPage {
                    horizontal-stretch: 1;
                    qt: root.qt;
                    theme <=> root.theme;
                    widget-style <=> root.widget-style;
                    style-note: root.style-note;
                    text-size <=> root.text-size;
                    animations <=> root.animations;
                    show-avatars <=> root.show-avatars;
                    notifications <=> root.notifications;
                    notification-content <=> root.notification-content;
                    show-activity <=> root.show-activity;
                    show-calendar <=> root.show-calendar;
                    close-to-tray <=> root.close-to-tray;
                    tray-available: root.tray-available;
                    autostart-supported: root.autostart-supported;
                    start-with-system <=> root.start-with-system;
                    read-receipts <=> root.read-receipts;
                    typing-indicators <=> root.typing-indicators;
                    link-previews <=> root.link-previews;
                    sync-to-phone <=> root.sync-to-phone;
                    account: root.account;
                    device-name: root.device-name;
                    changed-settings => { root.settings-changed(); }
                    changed-start-with-system(enabled) => { root.start-with-system-changed(enabled); }
                    opened => { root.settings-opened(); }
                    close => { root.settings-open = false; }
                }

                // Conversation
                if !root.settings-open && root.selected-id == "" && !root.narrow: Rectangle {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        spacing: 14px;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/b33p.svg");
                                width: 88px;
                                height: 88px;
                                opacity: 0.55;
                            }
                        }
                        Text {
                            text: "Pick a chat on the left,\nor search for someone to start a new one.";
                            horizontal-alignment: center;
                            color: Palette.foreground.with-alpha(0.55);
                        }
                    }
                }
                if !root.settings-open && root.selected-id != "": VerticalLayout {
                    horizontal-stretch: 1;
                    Rectangle {
                        height: 60px;
                        // The chat's picture and name open its details; the buttons, above, don't.
                        TouchArea {
                            accessible-role: button;
                            accessible-label: "Details of " + root.current.title;
                            accessible-action-default => { self.clicked(); }
                            mouse-cursor: pointer;
                            clicked => { root.open-details(); }
                        }
                        HorizontalLayout {
                            padding-left: root.narrow ? 4px : 16px;
                            padding-right: 12px;
                            spacing: 12px;
                            if root.narrow: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("@lucide/arrow-left.svg");
                                    label: "Back";
                                    clicked => { root.back(); }
                                }
                            }
                            Avatar {
                                width: 36px;
                                initials: root.current.initials;
                                tint: root.current.avatar-color;
                                picture: root.current.avatar;
                                y: (parent.height - self.height) / 2;
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: root.current.title;
                                    font-size: 1.1rem;
                                    font-weight: 600;
                                    overflow: elide;
                                    color: Palette.foreground;
                                }
                                // Who is typing, or else the subtitle: they cross-fade.
                                if root.typing != "" || root.current.subtitle != "" || root.current.timer > 0: Rectangle {
                                    height: subtitle.preferred-height;
                                    // The last one, so it doesn't go blank while fading out.
                                    property <string> typing: root.typing;
                                    property <string> shown-typing: root.typing;
                                    changed typing => {
                                        if self.typing != "" {
                                            self.shown-typing = self.typing;
                                        }
                                    }
                                    subtitle := Text {
                                        width: parent.width;
                                        text: root.current.subtitle
                                            + (root.current.timer > 0
                                                ? (root.current.subtitle != "" ? " · " : "") + "⏱ " + root.current.timer-label
                                                : "");
                                        font-size: 0.8rem;
                                        overflow: elide;
                                        color: Palette.foreground.with-alpha(0.6);
                                        opacity: root.typing == "" ? 1 : 0;
                                        animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
                                    }
                                    Text {
                                        width: parent.width;
                                        text: parent.shown-typing;
                                        font-size: 0.8rem;
                                        overflow: elide;
                                        color: Palette.accent-background;
                                        opacity: root.typing != "" ? 1 : 0;
                                        animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 4px;
                                    if root.show-calendar: IconButton {
                                        icon: @image-url("@lucide/calendar.svg");
                                        label: "Activity calendar";
                                        active: root.calendar-open;
                                        clicked => {
                                            if root.calendar-open {
                                                root.calendar-open = false;
                                            } else {
                                                root.open-calendar();
                                            }
                                        }
                                    }
                                    IconButton {
                                        icon: @image-url("@lucide/search.svg");
                                        label: "Search this chat";
                                        clicked => {
                                            root.chat-search-text = "";
                                            root.open-chat-search();
                                        }
                                    }
                                    IconButton {
                                        icon: @image-url("@lucide/ellipsis-vertical.svg");
                                        label: "More";
                                        clicked => { chat-menu.show({ x: chat-menu.width - 240px, y: chat-menu.height - 8px }); }
                                    }
                                }
                            }
                        }
                        chat-menu := ConversationMenu {
                            item: root.current;
                            in-header: true;
                            property <string> id: root.current.id;
                            toggle-pin => { root.toggle-pin(self.id); }
                            move-pin(by) => { root.move-pin(self.id, by); }
                            mark-read(read) => { root.mark-read(self.id, read); }
                            mute(seconds) => { root.mute(self.id, seconds); }
                            archive(archived) => { root.archive(self.id, archived); }
                            block(blocked) => { root.block(self.id, blocked); }
                            show-media => { root.open-media(); }
                            show-details => { root.open-details(); }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                    }
                    // While catching up with what arrived meanwhile; sending waits for it.
                    if !root.synced: ProgressIndicator {
                        indeterminate: true;
                        height: 3px;
                    }

                    chat-area := Rectangle {
                        vertical-stretch: 1;
                        // By position in the list: rows differ in height, so it lands near, not on.
                        function jump(index: int) {
                            message-list.content-y = max(message-list.visible-height - message-list.content-height,
                                -index * message-list.content-height / max(1, root.messages.length));
                            message-list.follow = message-list.content-y <= message-list.visible-height - message-list.content-height + 8px;
                        }
                        HorizontalLayout {
                            // A wheel turn animates the list's scroll, and its `scrolled` comes at
                            // the start, where the position is still the old one: look again once
                            // it has settled, or the end reached by the wheel wouldn't count.
                            settle-timer := Timer {
                                interval: 250ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    message-list.follow = message-list.at-end();
                                }
                            }
                            // The list moves rows itself after they are measured (keeping its first
                            // visible row in place), after `changed content-height` ran: once that
                            // settles, still following means still at the end.
                            end-timer := Timer {
                                interval: 120ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    if message-list.follow {
                                        message-list.content-y = min(0px, message-list.visible-height - message-list.content-height);
                                    }
                                }
                            }
                            load-older-timer := Timer {
                                interval: 1ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    root.load-older();
                                }
                            }
                            message-list := ListView {
                                // Follow new messages only while the newest one is in view, so reading
                                // older messages isn't interrupted. Opening a chat starts at the bottom.
                                property <bool> follow: true;
                                // By id: the open chat's place in the list changes as chats move.
                                property <string> conversation: root.selected-id;
                                // Back to the left too: a wide row once scrolled sideways would
                                // leave the next chat's rows out of view.
                                changed conversation => {
                                    self.follow = true;
                                    self.content-x = 0;
                                }
                                property <int> scroll-to-end-serial: root.scroll-to-end-serial;
                                changed scroll-to-end-serial => {
                                    self.follow = true;
                                    self.content-y = min(0px, self.visible-height - self.content-height);
                                }
                                function at-end() -> bool {
                                    self.content-y <= self.visible-height - self.content-height + 8px
                                }
                                // Jumping to a search result: rows have different heights and are only
                                // measured once shown, so the place is estimated from the average and
                                // corrected a few times as they are.
                                property <int> jump-serial: root.jump-serial;
                                property <int> settling;
                                function scroll-to-jump() {
                                    if root.messages.length > 0 {
                                        self.content-y = max(self.visible-height - self.content-height,
                                            min(0px, self.visible-height / 3
                                                - root.jump-row * self.content-height / root.messages.length));
                                    }
                                }
                                changed jump-serial => {
                                    self.follow = false;
                                    self.settling = 6;
                                    self.scroll-to-jump();
                                }
                                // Only the user's own scrolling decides; content growing (pictures arriving,
                                // rows being measured) moves the viewport too and must not stop following.
                                scrolled => {
                                    self.follow = self.at-end();
                                    settle-timer.running = true;
                                    if self.content-y > -self.visible-height / 2 {
                                        root.load-older();
                                    }
                                }
                                changed content-height => {
                                    // Older messages put in above don't move what is shown: the list
                                    // keeps its first visible row in place by itself.
                                    if self.follow {
                                        self.content-y = min(0px, self.visible-height - self.content-height);
                                        end-timer.running = true;
                                    }
                                    // Nothing to scroll yet: there may be more before. Asked for once
                                    // the change handlers ran: Rust changes the rows, which mustn't
                                    // happen while Slint is still running them.
                                    if self.content-height < self.visible-height {
                                        load-older-timer.running = true;
                                    }
                                    if self.settling > 0 {
                                        self.settling -= 1;
                                        self.scroll-to-jump();
                                    }
                                }
                                // E.g. the reply bar opening below.
                                changed visible-height => {
                                    if self.follow {
                                        self.content-y = min(0px, self.visible-height - self.content-height);
                                    }
                                }
                                for item[index] in root.messages: Bubble {
                                    item: item;
                                    index: index;
                                    reply => {
                                        root.reply(index);
                                        focus-composer-timer.running = true;
                                    }
                                    max-bubble-width: message-list.visible-width * 0.7;
                                    fetch-attachment(id) => { root.fetch-attachment(id); }
                                    save-attachment(id) => { root.save-attachment(id); }
                                    open-attachment(id) => { root.open-attachment(id); }
                                    open-link(link) => { root.open-link(link); }
                                    react(emoji) => { root.react(index, emoji); }
                                    edit => {
                                        root.edit(index);
                                        focus-composer-timer.running = true;
                                    }
                                    delete(everyone) => { root.delete(index, everyone); }
                                    copy-text(text) => { root.copy-text(text); }
                                    reveal => { root.reveal(index); }
                                    forward => {
                                        root.forward-filter = "";
                                        root.forward(index);
                                    }
                                    selecting: root.selected-count > 0;
                                    pick-held: root.pick-held;
                                    toggle-select => { root.toggle-select(index); }
                                    select-through => { root.select-through(index); }
                                }
                            }
                            if root.activity.length > 1: ActivityStrip {
                                items: root.activity;
                                // The average row: the list knows only its estimated total height.
                                property <length> row-height: max(1px, message-list.content-height / max(1, root.messages.length));
                                top: floor(-message-list.content-y / self.row-height);
                                bottom: floor((message-list.visible-height - message-list.content-y) / self.row-height);
                                jump(index) => { chat-area.jump(index); }
                            }
                        }
                        if root.calendar-open: ActivityCalendar {
                            // Fades in as it opens.
                            opacity: 0;
                            init => { self.opacity = 1; }
                            animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
                            years: root.calendar;
                            summary: root.calendar-summary;
                            close => { root.calendar-open = false; }
                            jump(index) => {
                                root.calendar-open = false;
                                chat-area.jump(index);
                            }
                        }
                    if root.chat-search-open: Rectangle {
                        // Fades in as it opens.
                        opacity: 0;
                        init => { self.opacity = 1; }
                        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
                        background: Palette.background;
                        search-timer := Timer {
                            interval: 300ms;
                            running: false;
                            triggered => {
                                self.running = false;
                                root.chat-search(root.chat-search-text);
                            }
                        }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    placeholder-text: "Search this chat";
                                    text <=> root.chat-search-text;
                                    init => { self.focus(); }
                                    // After a pause in typing.
                                    edited => {
                                        search-timer.running = false;
                                        search-timer.running = true;
                                    }
                                    accepted => { root.chat-search(self.text); }
                                }
                                Button {
                                    text: "Close";
                                    clicked => {
                                        root.close-chat-search();
                                        composer.focus();
                                    }
                                }
                            }
                            if root.chat-search-busy: HorizontalLayout {
                                alignment: center;
                                Spinner {
                                    indeterminate: true;
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                            if !root.chat-search-busy && root.chat-search-text != "" && root.search-results.length == 0: Text {
                                text: "No messages found.";
                                horizontal-alignment: center;
                                color: Palette.foreground.with-alpha(0.6);
                            }
                            ListView {
                                vertical-stretch: 1;
                                for result[index] in root.search-results: Rectangle {
                                    height: result-column.preferred-height;
                                    border-radius: 6px;
                                    background: result-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                    result-column := VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            Text {
                                                text: result.sender;
                                                font-weight: 600;
                                                horizontal-stretch: 1;
                                                color: Palette.foreground;
                                            }
                                            Text {
                                                text: result.when;
                                                font-size: 0.8rem;
                                                color: Palette.foreground.with-alpha(0.55);
                                            }
                                        }
                                        StyledText {
                                            text: result.snippet;
                                            accessible-role: text;
                                            accessible-label: result.text;
                                            default-color: Palette.foreground.with-alpha(0.8);
                                        }
                                    }
                                    // Over the text, which would take the clicks for links otherwise.
                                    result-touch := TouchArea {
                                        accessible-role: list-item;
                                        accessible-label: result.sender + ", " + result.when + ": " + result.text;
                                        accessible-action-default => { self.clicked(); }
                                        mouse-cursor: pointer;
                                        clicked => { root.show-result(index); }
                                    }
                                }
                            }
                        }
                    }
                    if root.details-open: Rectangle {
                        // Fades in as it opens.
                        opacity: 0;
                        init => { self.opacity = 1; }
                        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
                        background: Palette.background;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "Close";
                                    clicked => { root.close-details(); }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 10px;
                                    padding-bottom: 16px;
                                    HorizontalLayout {
                                        alignment: center;
                                        Avatar {
                                            width: 96px;
                                            initials: root.current.initials;
                                            tint: root.current.avatar-color;
                                            picture: root.current.avatar;
                                        }
                                    }
                                    Text {
                                        text: root.current.title;
                                        font-size: 1.4rem;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        color: Palette.foreground;
                                    }
                                    if root.details-about != "": Text {
                                        text: root.details-about;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                        color: Palette.foreground.with-alpha(0.75);
                                    }
                                    Text {
                                        text: root.details-phone != "" ? root.details-phone : root.current.subtitle;
                                        horizontal-alignment: center;
                                        color: Palette.foreground.with-alpha(0.6);
                                    }
                                    if root.details-busy: HorizontalLayout {
                                        alignment: center;
                                        Spinner {
                                            indeterminate: true;
                                            width: 20px;
                                            height: 20px;
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Button {
                                            text: "Media, files and links";
                                            clicked => {
                                                root.close-details();
                                                root.open-media();
                                            }
                                        }
                                    }
                                    // Muting for a while and the timer, here rather than in the
                                    // header's menu (see `ConversationMenu`).
                                    VerticalLayout {
                                        spacing: 6px;
                                        property <ConversationItem> chat: root.current;
                                        SectionTitle { text: "Chat"; }
                                        SettingRow {
                                            label: "Notifications";
                                            hint: chat.muted ? "Muted" : "";
                                            if chat.muted: Button {
                                                text: "Unmute";
                                                clicked => { root.mute(chat.id, 0); }
                                            }
                                            // In the order of `MuteChoices`, after "On".
                                            if !chat.muted: ComboBox {
                                                width: 200px;
                                                model: ["On", "Off for 1 hour", "Off for 8 hours", "Off for 1 week", "Off"];
                                                current-index: 0;
                                                selected => {
                                                    if self.current-index > 0 {
                                                        root.mute(chat.id, MuteChoices.choices[self.current-index - 1].seconds);
                                                    }
                                                }
                                            }
                                        }
                                        // Only where we can still write: the timer is a message to them.
                                        if !chat.request && !chat.blocked && !chat.left: SettingRow {
                                            label: "Disappearing messages";
                                            hint: chat.timer > 0 && TimerChoices.index-of(chat.timer) < 0 ? "Set to " + chat.timer-label : "";
                                            timer-box := ComboBox {
                                                width: 200px;
                                                model: TimerChoices.labels;
                                                current-index: TimerChoices.index-of(chat.timer);
                                                // Each change is a message to every member: only the one
                                                // stopped at goes, not each passed with the arrows or wheel.
                                                property <int> pending: -1;
                                                property <duration> picked-at;
                                                selected => {
                                                    self.pending = self.current-index;
                                                    self.picked-at = animation-tick();
                                                }
                                            }
                                            Timer {
                                                interval: 100ms;
                                                running: timer-box.pending >= 0;
                                                triggered => {
                                                    if animation-tick() - timer-box.picked-at >= 500ms {
                                                        root.set-timer(chat.id, TimerChoices.seconds[timer-box.pending]);
                                                        timer-box.pending = -1;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.details-description != "": VerticalLayout {
                                        spacing: 4px;
                                        SectionTitle { text: "Description"; }
                                        Text {
                                            text: root.details-description;
                                            wrap: word-wrap;
                                            color: Palette.foreground;
                                        }
                                    }
                                    if root.details-safety-number != "": VerticalLayout {
                                        spacing: 6px;
                                        SectionTitle { text: "Safety number"; }
                                        Text {
                                            text: "Compare it with the one on their phone, in person or another way you trust. If both match, nobody is in between: your messages are end-to-end encrypted with them.";
                                            wrap: word-wrap;
                                            font-size: 0.85rem;
                                            color: Palette.foreground.with-alpha(0.7);
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            Rectangle {
                                                border-radius: 8px;
                                                background: Palette.alternate-background;
                                                HorizontalLayout {
                                                    padding: 12px;
                                                    Text {
                                                        text: root.details-safety-number;
                                                        font-family: "monospace";
                                                        font-size: 1.05rem;
                                                        color: Palette.foreground;
                                                    }
                                                }
                                            }
                                        }
                                        if root.details-safety-changed: Text {
                                            text: "Changed since you verified it. This is the new one: compare it with theirs again.";
                                            wrap: word-wrap;
                                            font-size: 0.85rem;
                                            font-weight: 600;
                                            color: Palette.foreground;
                                        }
                                        if root.details-verified: Text {
                                            text: "✓ Verified: you compared it with theirs.";
                                            font-size: 0.85rem;
                                            font-weight: 600;
                                            color: Palette.accent-background;
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Copy";
                                                clicked => { root.copy-text(root.details-safety-number); }
                                            }
                                            Button {
                                                text: root.details-verified ? "Clear verification" : "Mark as verified";
                                                clicked => { root.set-verified(!root.details-verified); }
                                            }
                                        }
                                    }
                                    if root.current.group && !root.current.left: VerticalLayout {
                                        spacing: 6px;
                                        SectionTitle { text: "Group"; }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            name-field := LineEdit {
                                                placeholder-text: "Name";
                                                text: root.current.title;
                                                accepted => { root.rename-group(self.text); }
                                            }
                                            Button {
                                                text: "Rename";
                                                clicked => { root.rename-group(name-field.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 8px;
                                            description-field := LineEdit {
                                                placeholder-text: "Description";
                                                text: root.details-description;
                                                accepted => { root.describe-group(self.text); }
                                            }
                                            Button {
                                                text: "Save";
                                                clicked => { root.describe-group(description-field.text); }
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Change picture…";
                                                clicked => { root.change-group-picture(); }
                                            }
                                            if root.current.avatar.width > 0: Button {
                                                text: "Remove picture";
                                                clicked => { root.remove-group-picture(); }
                                            }
                                        }
                                        HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Add members…";
                                                clicked => {
                                                    root.group-draft-filter = "";
                                                    root.open-add-members();
                                                }
                                            }
                                            leave-button := Button {
                                                property <bool> sure;
                                                text: self.sure ? "Really leave?" : "Leave group";
                                                clicked => {
                                                    if self.sure {
                                                        root.leave-group();
                                                    }
                                                    self.sure = !self.sure;
                                                }
                                            }
                                        }
                                    }
                                    if root.current.group && !root.current.left: VerticalLayout {
                                        spacing: 6px;
                                        SectionTitle { text: "Invite link"; }
                                        Text {
                                            text: "Anyone with the link can join the group, or ask to.";
                                            wrap: word-wrap;
                                            font-size: 0.85rem;
                                            color: Palette.foreground.with-alpha(0.7);
                                        }
                                        if root.current.admin: HorizontalLayout {
                                            alignment: start;
                                            spacing: 8px;
                                            Button {
                                                text: "Off";
                                                primary: root.details-invite-access == 0;
                                                clicked => { root.set-invite-link(0); }
                                            }
                                            Button {
                                                text: "Anyone";
                                                primary: root.details-invite-access == 1;
                                                clicked => { root.set-invite-link(1); }
                                            }
                                            Button {
                                                text: "Admins approve";
                                                primary: root.details-invite-access == 2;
                                                clicked => { root.set-invite-link(2); }
                                            }
                                        }
                                        if root.details-invite-link != "": HorizontalLayout {
                                            spacing: 8px;
                                            Rectangle {
                                                border-radius: 8px;
                                                background: Palette.alternate-background;
                                                horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    padding: 10px;
                                                    Text {
                                                        text: root.details-invite-link;
                                                        overflow: elide;
                                                        font-size: 0.85rem;
                                                        vertical-alignment: center;
                                                        color: Palette.foreground;
                                                    }
                                                }
                                            }
                                            Button {
                                                text: "Copy";
                                                clicked => { root.copy-text(root.details-invite-link); }
                                            }
                                            if root.current.admin: Button {
                                                text: "Reset";
                                                clicked => { root.reset-invite-link(); }
                                            }
                                        }
                                    }
                                    if root.current.admin && root.details-requests.length > 0: VerticalLayout {
                                        spacing: 4px;
                                        SectionTitle { text: root.details-requests.length == 1 ? "1 request to join" : root.details-requests.length + " requests to join"; }
                                        for person in root.details-requests: HorizontalLayout {
                                            spacing: 10px;
                                            padding-top: 2px;
                                            padding-bottom: 2px;
                                            Avatar {
                                                width: 32px;
                                                initials: person.initials;
                                                tint: person.color;
                                            }
                                            Text {
                                                text: person.name;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                color: Palette.foreground;
                                            }
                                            Button {
                                                text: "Turn down";
                                                clicked => { root.answer-join-request(person.id, false); }
                                            }
                                            Button {
                                                text: "Let in";
                                                primary: true;
                                                clicked => { root.answer-join-request(person.id, true); }
                                            }
                                        }
                                    }
                                    if root.details-members.length > 0: VerticalLayout {
                                        spacing: 4px;
                                        SectionTitle { text: root.details-members.length + " members"; }
                                        for member in root.details-members: HorizontalLayout {
                                            spacing: 10px;
                                            padding-top: 2px;
                                            padding-bottom: 2px;
                                            Avatar {
                                                width: 32px;
                                                initials: member.initials;
                                                tint: member.color;
                                            }
                                            Text {
                                                text: member.name;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                color: Palette.foreground;
                                            }
                                            if member.admin: Text {
                                                text: "Admin";
                                                font-size: 0.8rem;
                                                vertical-alignment: center;
                                                color: Palette.foreground.with-alpha(0.6);
                                            }
                                            // Not for ourselves, nor where we're no longer in the group.
                                            if member.name != "You" && !root.current.left: VerticalLayout {
                                                alignment: center;
                                                IconButton {
                                                    icon: @image-url("@lucide/ellipsis-vertical.svg");
                                                    label: "Manage " + member.name;
                                                    // Below the button, in the menu area's coordinates
                                                    // (it sits in the layout too, below the button).
                                                    clicked => {
                                                        member-menu.show({
                                                            x: self.x - member-menu.x - 160px,
                                                            y: self.y + self.height - member-menu.y,
                                                        });
                                                    }
                                                }
                                                member-menu := ContextMenuArea {
                                                    enabled: false;
                                                    Menu {
                                                        MenuItem {
                                                            title: member.admin ? "Take admin rights" : "Make admin";
                                                            activated => { root.set-member-admin(member.id, !member.admin); }
                                                        }
                                                        MenuItem {
                                                            title: "Remove from group";
                                                            activated => { root.remove-member(member.id); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.media-open: Rectangle {
                        // Fades in as it opens.
                        opacity: 0;
                        init => { self.opacity = 1; }
                        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
                        background: Palette.background;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 4px;
                                for tab[index] in ["Media", "Files", "Links"]: Rectangle {
                                    width: tab-label.preferred-width + 24px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: index == root.media-tab ? Palette.accent-background.with-alpha(0.18)
                                        : tab-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                    tab-touch := TouchArea {
                                        accessible-role: AccessibleRole.tab;
                                        accessible-label: tab;
                                        accessible-action-default => { self.clicked(); }
                                        mouse-cursor: pointer;
                                        clicked => { root.media-tab = index; }
                                    }
                                    tab-label := Text {
                                        text: tab;
                                        font-weight: index == root.media-tab ? 600 : 400;
                                        color: Palette.foreground;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "Close";
                                    clicked => { root.close-media(); }
                                }
                            }
                            if root.media-busy: HorizontalLayout {
                                alignment: center;
                                Spinner {
                                    indeterminate: true;
                                    width: 20px;
                                    height: 20px;
                                }
                            }
                            property <bool> empty: root.media-tab == 0 ? root.media-tiles.length == 0
                                : root.media-tab == 1 ? root.media-files.length == 0 : root.media-links.length == 0;
                            if !root.media-busy && self.empty: Text {
                                text: root.media-tab == 0 ? "No photos or videos yet." : root.media-tab == 1 ? "No files yet." : "No links yet.";
                                horizontal-alignment: center;
                                color: Palette.foreground.with-alpha(0.6);
                            }
                            if root.media-tab == 0: media-list := ListView {
                                vertical-stretch: 1;
                                // As many tiles across as fit at 110px, stretched to fill the width.
                                property <length> gap: 4px;
                                property <int> columns: max(1, floor((self.visible-width + self.gap) / (110px + self.gap)));
                                property <length> tile: (self.visible-width - (self.columns - 1) * self.gap) / self.columns;
                                for row in floor((root.media-tiles.length + media-list.columns - 1) / media-list.columns): HorizontalLayout {
                                    spacing: media-list.gap;
                                    padding-bottom: media-list.gap;
                                    alignment: start;
                                    for column in media-list.columns: Rectangle {
                                        property <int> at: row * media-list.columns + column;
                                        property <AttachmentItem> tile: root.media-tiles[self.at];
                                        // The grid's last row may not be full.
                                        visible: self.at < root.media-tiles.length;
                                        width: media-list.tile;
                                        height: media-list.tile;
                                        border-radius: 6px;
                                        clip: true;
                                        background: Palette.alternate-background;
                                        init => {
                                            if tile.fetch { root.fetch-attachment(tile.id); }
                                        }
                                        // Pictures on their way, and videos (not downloaded for this); they
                                        // give way to the picture as it fades in (see `AttachmentView`).
                                        if tile.placeholder.width > 0: Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: tile.placeholder;
                                            image-fit: cover;
                                            opacity: 1 - tile-picture.opacity;
                                        }
                                        tile-picture := Image {
                                            width: parent.width;
                                            height: parent.height;
                                            source: tile.picture;
                                            image-fit: cover;
                                            opacity: tile.picture.width > 0 ? 1 : 0;
                                            animate opacity { duration: 200ms * Motion.scale; easing: ease-out; }
                                        }
                                        if tile.video: Rectangle {
                                            width: 36px;
                                            height: 36px;
                                            border-radius: 18px;
                                            background: #0008;
                                            Text {
                                                text: tile.gif ? "GIF" : "▶";
                                                font-size: tile.gif ? 0.75rem : 1rem;
                                                font-weight: 700;
                                                color: white;
                                            }
                                        }
                                        TouchArea {
                                            accessible-role: button;
                                            accessible-label: tile.video ? "Play video" : "Open picture";
                                            accessible-action-default => { self.clicked(); }
                                            mouse-cursor: pointer;
                                            clicked => { root.open-attachment(tile.id); }
                                        }
                                    }
                                }
                            }
                            if root.media-tab == 1: ListView {
                                vertical-stretch: 1;
                                for file in root.media-files: VerticalLayout {
                                    padding: 6px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        Text {
                                            text: file.sender;
                                            font-size: 0.8rem;
                                            font-weight: 600;
                                            horizontal-stretch: 1;
                                            color: Palette.foreground.with-alpha(0.8);
                                        }
                                        Text {
                                            text: file.when;
                                            font-size: 0.8rem;
                                            color: Palette.foreground.with-alpha(0.55);
                                        }
                                    }
                                    AttachmentView {
                                        item: file.attachment;
                                        outgoing: false;
                                        fetch(id) => { root.fetch-attachment(id); }
                                        save(id) => { root.save-attachment(id); }
                                        open(id) => { root.open-attachment(id); }
                                    }
                                }
                            }
                            if root.media-tab == 2: ListView {
                                vertical-stretch: 1;
                                for link in root.media-links: Rectangle {
                                    height: link-column.preferred-height;
                                    border-radius: 6px;
                                    background: link-touch.has-hover ? Palette.foreground.with-alpha(0.06) : transparent;
                                    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                    link-touch := TouchArea {
                                        accessible-role: button;
                                        accessible-label: "Open link " + link.url;
                                        accessible-action-default => { self.clicked(); }
                                        mouse-cursor: pointer;
                                        clicked => { root.open-link(link.url); }
                                    }
                                    link-column := VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        Text {
                                            text: link.url;
                                            overflow: elide;
                                            color: Palette.accent-background;
                                        }
                                        Text {
                                            text: link.sender + " · " + link.when;
                                            font-size: 0.8rem;
                                            color: Palette.foreground.with-alpha(0.6);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }

                    if root.mention-candidates.length > 0: Rectangle {
                        background: Palette.alternate-background;
                        VerticalLayout {
                            padding: 6px;
                            padding-left: 12px;
                            padding-right: 12px;
                            for name[index] in root.mention-candidates: Rectangle {
                                height: 30px;
                                border-radius: 6px;
                                // The first is what Tab or Enter picks.
                                background: mention-touch.has-hover ? Palette.foreground.with-alpha(0.1)
                                    : index == 0 ? Palette.accent-background.with-alpha(0.15) : transparent;
                                animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                mention-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Mention " + name;
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.pick-mention(index);
                                        // Back to writing, after the name.
                                        focus-composer-timer.running = true;
                                    }
                                }
                                Text {
                                    x: 10px;
                                    text: "@" + name;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                            }
                        }
                    }
                    // Slides open and closed: always there, its height following whether it is open.
                    Rectangle {
                        property <bool> open: root.editing;
                        height: self.open ? editing-bar.preferred-height : 0px;
                        animate height { duration: 150ms * Motion.scale; easing: ease-out; }
                        clip: true;
                        visible: self.height > 0px;
                        background: Palette.alternate-background;
                        // At the bottom, so it rises out of the composer.
                        editing-bar := HorizontalLayout {
                            y: parent.height - self.height;
                            height: self.preferred-height;
                            padding-left: 16px;
                            padding-right: 8px;
                            padding-top: 6px;
                            spacing: 8px;
                            Rectangle {
                                width: 3px;
                                border-radius: 1.5px;
                                background: Palette.accent-background;
                            }
                            Text {
                                text: "Editing message";
                                font-size: 0.85rem;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: Palette.foreground;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("@lucide/x.svg");
                                    label: "Stop editing";
                                    tint: Palette.foreground.with-alpha(0.6);
                                    clicked => { root.cancel-edit(); }
                                }
                            }
                        }
                    }
                    // Slides open and closed: always there, its height following whether it is open.
                    reply-slot := Rectangle {
                        property <bool> open: root.reply-author != "" || root.reply-text != "";
                        // What it showed, kept while it closes.
                        property <string> author: root.reply-author;
                        property <string> text: root.reply-text;
                        property <string> shown-author: root.reply-author;
                        property <string> shown-text: root.reply-text;
                        changed author => { if self.open { self.shown-author = self.author; } }
                        changed text => { if self.open { self.shown-text = self.text; } }
                        height: self.open ? reply-bar.preferred-height : 0px;
                        animate height { duration: 150ms * Motion.scale; easing: ease-out; }
                        clip: true;
                        visible: self.height > 0px;
                        background: Palette.alternate-background;
                        // At the bottom, so it rises out of the composer.
                        reply-bar := HorizontalLayout {
                            y: parent.height - self.height;
                            height: self.preferred-height;
                            padding-left: 16px;
                            padding-right: 8px;
                            padding-top: 6px;
                            spacing: 8px;
                            Rectangle {
                                width: 3px;
                                border-radius: 1.5px;
                                background: Palette.accent-background;
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: "Replying to " + reply-slot.shown-author;
                                    font-size: 0.8rem;
                                    font-weight: 600;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: reply-slot.shown-text;
                                    font-size: 0.85rem;
                                    overflow: elide;
                                    color: Palette.foreground.with-alpha(0.7);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: @image-url("@lucide/x.svg");
                                    label: "Stop replying";
                                    tint: Palette.foreground.with-alpha(0.6);
                                    clicked => { root.cancel-reply(); }
                                }
                            }
                        }
                    }
                    // Files waiting to go out with the next message.
                    if root.staged.length > 0: HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        spacing: 6px;
                        alignment: start;
                        for name[index] in root.staged: Rectangle {
                            // Fades in as it appears.
                            opacity: 0;
                            init => { self.opacity = 1; }
                            animate opacity { duration: 150ms * Motion.scale; easing: ease-out; }
                            height: 26px;
                            width: staged-row.preferred-width + 16px;
                            border-radius: 13px;
                            background: Palette.alternate-background;
                            border-width: 1px;
                            border-color: Palette.border;
                            staged-row := HorizontalLayout {
                                x: 8px;
                                width: parent.width - 16px;
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: @image-url("@lucide/paperclip.svg");
                                        width: 14px;
                                    }
                                }
                                Text {
                                    text: name;
                                    font-size: 0.85rem;
                                    vertical-alignment: center;
                                    color: Palette.foreground;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: @image-url("@lucide/x.svg");
                                        label: "Remove " + name;
                                        tint: Palette.foreground.with-alpha(0.6);
                                        width: 20px;
                                        height: 20px;
                                        icon-size: 12px;
                                        clicked => { root.unstage(index); }
                                    }
                                }
                            }
                        }
                    }
                    if root.current.request: request-bar := Rectangle {
                        background: Palette.alternate-background;
                        // Blocking and deleting can't be undone, and these buttons are where the
                        // composer is in other chats: they ask first. What is asked about; accept
                        // (which isn't) while not asking.
                        property <RequestAnswer> confirming: RequestAnswer.accept;
                        property <string> chat: root.selected-id;
                        changed chat => { self.confirming = RequestAnswer.accept; }
                        VerticalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Text {
                                text: request-bar.confirming == RequestAnswer.delete ? "Delete this chat and its messages?"
                                    : request-bar.confirming == RequestAnswer.block ? "Block " + root.current.title + "? They won't be able to message or call you."
                                    : root.current.title + " wants to message you. They won't know you've seen their messages until you accept.";
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                color: Palette.foreground;
                            }
                            if request-bar.confirming == RequestAnswer.accept: HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Button {
                                    text: "Block";
                                    clicked => { request-bar.confirming = RequestAnswer.block; }
                                }
                                Button {
                                    text: "Delete";
                                    clicked => { request-bar.confirming = RequestAnswer.delete; }
                                }
                                Button {
                                    text: "Accept";
                                    primary: true;
                                    clicked => { root.respond(RequestAnswer.accept); }
                                }
                            }
                            if request-bar.confirming != RequestAnswer.accept: HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                Button {
                                    text: "Cancel";
                                    clicked => { request-bar.confirming = RequestAnswer.accept; }
                                }
                                Button {
                                    text: request-bar.confirming == RequestAnswer.delete ? "Delete" : "Block";
                                    primary: true;
                                    clicked => { root.respond(request-bar.confirming); }
                                }
                            }
                        }
                    }
                    if root.current.invited: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Text {
                                text: "You're invited to join this group. Its members see you once you join.";
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: Palette.foreground;
                            }
                            Button {
                                text: "Decline";
                                clicked => { root.answer-invitation(root.current.id, false); }
                            }
                            Button {
                                text: "Accept";
                                primary: true;
                                clicked => { root.answer-invitation(root.current.id, true); }
                            }
                        }
                    }
                    if root.current.requested: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Text {
                                text: "You asked to join this group. An admin has to let you in.";
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: Palette.foreground;
                            }
                            Button {
                                text: "Take request back";
                                clicked => { root.cancel-join-request(); }
                            }
                        }
                    }
                    if root.current.left && !root.current.invited && !root.current.requested: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 14px;
                            Text {
                                text: root.current.subtitle;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                horizontal-stretch: 1;
                                color: Palette.foreground.with-alpha(0.75);
                            }
                        }
                    }
                    if root.current.safety-changed: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Text {
                                text: "Your safety number with " + root.current.title + " changed since you verified it. Compare it again, or continue without.";
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: Palette.foreground;
                            }
                            Button {
                                text: "Show safety number";
                                clicked => { root.open-details(); }
                            }
                            Button {
                                text: "Continue";
                                clicked => { root.confirm-safety-number(root.current.id); }
                            }
                        }
                    }
                    if root.current.blocked: Rectangle {
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;
                            Text {
                                text: "You blocked this chat. You won't see new messages from it.";
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                color: Palette.foreground;
                            }
                            Button {
                                text: "Unblock";
                                clicked => { root.block(root.current.id, false); }
                            }
                        }
                    }
                    // Not for requests, blocked chats, groups left or a changed safety number: they get
                    // their bar above instead.
                    Rectangle {
                        property <bool> hidden: root.current.request || root.current.blocked || root.current.left || root.current.safety-changed;
                        height: self.hidden ? 0px : composer-row.preferred-height;
                        clip: true;
                        // A chat opens ready to write in, wherever it was opened from (the search
                        // field would otherwise keep the focus, and typing there hides the chat).
                        property <string> chat: root.selected-id;
                        function focus-if-writable() {
                            if !self.hidden {
                                focus-composer-timer.running = true;
                            }
                        }
                        init => { self.focus-if-writable(); }
                        changed chat => { self.focus-if-writable(); }
                        // Back to writing once a message was forwarded, or not.
                        property <bool> forwarding: root.forwarding;
                        changed forwarding => {
                            if !self.forwarding { self.focus-if-writable(); }
                        }
                        // And once Esc closed what was in front (which may have had the focus).
                        property <int> escaped: root.escaped;
                        changed escaped => { self.focus-if-writable(); }
                    composer-row := HorizontalLayout {
                        property <length> line: one-line-measure.preferred-height;
                        // The field's height for one line: the send button's, unless the text is
                        // set larger.
                        property <length> one-line-height: max(send-button.height, self.line + 8px);
                        // What is beside the field lines up with its last line, wherever that is.
                        function last-line-padding(height: length) -> length {
                            max(0px, (self.one-line-height - height) / 2)
                        }
                        width: parent.width;
                        padding: 12px;
                        spacing: 6px;
                        alignment: stretch;
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(32px);
                            IconButton {
                                label: "Attach files";
                                icon: @image-url("@lucide/paperclip.svg");
                                clicked => { root.attach(); }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(32px);
                            IconButton {
                                label: "Stickers";
                                icon: @image-url("@lucide/sticker.svg");
                                clicked => {
                                    root.open-stickers();
                                    sticker-picker.show();
                                }
                            }
                            sticker-picker := PopupWindow {
                                x: 0;
                                y: -330px;
                                // A popup's size is its own, not its content's: without one it opens
                                // as a sliver, or not at all.
                                width: 6 * 72px + 16px;
                                height: 320px;
                                close-policy: close-on-click-outside;
                                Rectangle {
                                    // Fades in as it appears.
                                    opacity: 0;
                                    init => { self.opacity = 1; }
                                    animate opacity { duration: 120ms * Motion.scale; easing: ease-out; }
                                    border-radius: 10px;
                                    background: Palette.alternate-background;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #0003;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: start;
                                            for title[index] in root.sticker-packs: Rectangle {
                                                width: pack-title.preferred-width + 16px;
                                                height: 28px;
                                                border-radius: 6px;
                                                background: index == root.sticker-pack ? Palette.accent-background.with-alpha(0.18)
                                                    : pack-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                                                animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                                pack-touch := TouchArea {
                                                    accessible-role: AccessibleRole.tab;
                                                    accessible-label: title;
                                                    accessible-action-default => { self.clicked(); }
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.sticker-pack = index;
                                                        root.sticker-pack-chosen();
                                                    }
                                                }
                                                pack-title := Text {
                                                    text: title;
                                                    font-size: 0.85rem;
                                                    color: Palette.foreground;
                                                }
                                            }
                                        }
                                        if root.stickers-busy: HorizontalLayout {
                                            alignment: center;
                                            Spinner {
                                                indeterminate: true;
                                                width: 20px;
                                                height: 20px;
                                            }
                                        }
                                        if !root.stickers-busy && root.sticker-packs.length == 0: Text {
                                            text: "No sticker packs yet. Install some on your phone; they show up here.";
                                            wrap: word-wrap;
                                            horizontal-alignment: center;
                                            color: Palette.foreground.with-alpha(0.6);
                                        }
                                        sticker-list := ListView {
                                            vertical-stretch: 1;
                                            for row in root.sticker-rows: HorizontalLayout {
                                                alignment: start;
                                                for tile in row.tiles: Rectangle {
                                                    // Six to a row, beside the style's scroll bar.
                                                    width: min(72px, sticker-list.visible-width / 6);
                                                    height: self.width;
                                                    border-radius: 8px;
                                                    background: tile-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                                                    animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                                    tile-touch := TouchArea {
                                                        accessible-role: button;
                                                        accessible-label: "Send sticker " + tile.emoji;
                                                        accessible-action-default => { self.clicked(); }
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.send-sticker(tile.pack, tile.id);
                                                            sticker-picker.close();
                                                        }
                                                    }
                                                    Image {
                                                        width: parent.width - 12px;
                                                        height: self.width;
                                                        source: tile.picture;
                                                        image-fit: contain;
                                                        accessible-role: image;
                                                        accessible-label: tile.emoji;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(32px);
                            IconButton {
                                label: "Emoji";
                                icon: @image-url("@lucide/face-slightly-smiling.svg");
                                clicked => { emoji-picker.show(); }
                            }
                            emoji-picker := PopupWindow {
                                x: 0;
                                y: -190px;
                                // See the sticker picker's.
                                width: 8 * 34px + 12px;
                                height: 4 * 34px + 12px;
                                Rectangle {
                                    // Fades in as it appears.
                                    opacity: 0;
                                    init => { self.opacity = 1; }
                                    animate opacity { duration: 120ms * Motion.scale; easing: ease-out; }
                                    border-radius: 10px;
                                    background: Palette.alternate-background;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: #0003;
                                    for emoji[i] in ["😀", "😂", "🥲", "😊", "😍", "😘", "😎", "🤔",
                                                     "😮", "😢", "😭", "😡", "🙄", "😴", "🤯", "🥳",
                                                     "👍", "👎", "👏", "🙏", "💪", "👋", "🤝", "✌️",
                                                     "❤️", "🔥", "🎉", "✨", "💯", "✅", "❌", "👀"]: Rectangle {
                                        x: 6px + mod(i, 8) * 34px;
                                        y: 6px + floor(i / 8) * 34px;
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 6px;
                                        background: emoji-touch.has-hover ? Palette.foreground.with-alpha(0.1) : transparent;
                                        animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                                        emoji-touch := TouchArea {
                                            accessible-role: button;
                                            accessible-label: "Insert " + emoji;
                                            accessible-action-default => { self.clicked(); }
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.draft = root.draft + emoji;
                                                root.draft-edited(root.draft);
                                                focus-composer-timer.running = true;
                                            }
                                        }
                                        Text { text: emoji; font-size: 1.2rem; }
                                    }
                                }
                            }
                        }
                        // Grows with the draft, up to a few lines, then scrolls. A plain text input
                        // in a field of our own: the native TextEdit keeps room below its text for a
                        // scroll bar, so a line of it sat at the top of a box two lines high. The
                        // draft is measured by an invisible copy, which wraps like the input.
                        composer-field := Rectangle {
                            horizontal-stretch: 1;
                            // A word too long for a line would otherwise make this as wide as the
                            // word, pushing the chat past the window; the input breaks it instead.
                            min-width: 0px;
                            property <length> pad-x: 10px;
                            property <length> pad-y: (composer-row.one-line-height - composer-row.line) / 2;
                            height: clamp(measure.preferred-height, composer-row.line, 150px - 2 * self.pad-y) + 2 * self.pad-y;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: composer.has-focus ? Palette.accent-background : Palette.border;
                            animate border-color { duration: 120ms * Motion.scale; easing: ease-out; }
                            background: Palette.control-background;
                            measure := Text {
                                visible: false;
                                width: composer.width;
                                text: root.draft + " ";
                                wrap: word-wrap;
                            }
                            one-line-measure := Text {
                                visible: false;
                                text: " ";
                            }
                            // Focuses the input, with the caret at the end, once the menu an action
                            // was picked from has closed: closing it gives the focus back to wherever
                            // it was before.
                            focus-composer-timer := Timer {
                                interval: 1ms;
                                running: false;
                                // Or where the caret was, e.g. after the field's own menu.
                                in-out property <bool> to-end: true;
                                triggered => {
                                    self.running = false;
                                    composer.focus();
                                    if self.to-end {
                                        composer.set-selection-offsets(2147483647, 2147483647);
                                    }
                                    self.to-end = true;
                                }
                            }
                            // Text from the clipboard, once Rust found it holds nothing to attach.
                            property <int> paste-text: root.paste-text;
                            changed paste-text => { composer.paste(); }
                            // After the field's menu, which may have been opened from elsewhere.
                            function focus-in-place() {
                                focus-composer-timer.to-end = false;
                                focus-composer-timer.running = true;
                            }
                            // Clicks beside the text, in the field's margins, start writing too.
                            TouchArea {
                                mouse-cursor: text;
                                clicked => { composer.focus(); }
                            }
                            Text {
                                x: parent.pad-x;
                                y: parent.pad-y;
                                width: composer-scroll.width;
                                text: root.draft == "" && composer.preedit-text == "" ? (root.editing ? "Edit message" : "Message") : "";
                                color: Palette.foreground.with-alpha(0.5);
                                overflow: elide;
                                accessible-role: none;
                            }
                            ContextMenuArea {
                                x: parent.pad-x;
                                y: parent.pad-y;
                                width: parent.width - 2 * parent.pad-x;
                                height: parent.height - 2 * parent.pad-y;
                                Menu {
                                    MenuItem {
                                        title: "Cut";
                                        enabled: root.draft != "";
                                        activated => { composer.cut(); composer-field.focus-in-place(); }
                                    }
                                    MenuItem {
                                        title: "Copy";
                                        enabled: root.draft != "";
                                        activated => { composer.copy(); composer-field.focus-in-place(); }
                                    }
                                    MenuItem {
                                        title: "Paste";
                                        activated => {
                                            root.paste();
                                            composer-field.focus-in-place();
                                        }
                                    }
                                    MenuItem {
                                        title: "Select all";
                                        enabled: root.draft != "";
                                        activated => { composer.select-all(); composer-field.focus-in-place(); }
                                    }
                                }
                                // Scrolled by the wheel or by moving the caret; dragging selects.
                                composer-scroll := Flickable {
                                    interactive: false;
                                    content-height: composer.height;
                                    // Shorter text leaves no gap below it.
                                    changed content-height => {
                                        self.content-y = max(self.content-y, self.height - self.content-height);
                                    }
                                    composer := TextInput {
                                        width: composer-scroll.width;
                                        height: max(composer-scroll.height, measure.preferred-height);
                                        text <=> root.draft;
                                        single-line: false;
                                        wrap: word-wrap;
                                        color: Palette.foreground;
                                        selection-background-color: Palette.selection-background;
                                        selection-foreground-color: Palette.selection-foreground;
                                        accessible-placeholder-text: root.editing ? "Edit message" : "Message";
                                        edited => { root.draft-edited(self.text); }
                                        // Where the caret is, for which line it is on.
                                        property <length> caret-y;
                                        // The caret stays in view.
                                        cursor-position-changed(at) => {
                                            self.caret-y = at.y;
                                            TextSelection.clear();
                                            if at.y + composer-scroll.content-y < 0px {
                                                composer-scroll.content-y = -at.y;
                                            } else if at.y + composer-row.line + composer-scroll.content-y > composer-scroll.height {
                                                composer-scroll.content-y = composer-scroll.height - at.y - composer-row.line;
                                            }
                                        }
                                        // Enter sends; Shift+Enter starts a new line.
                                        key-pressed(event) => {
                                            if (event.text == Key.Tab || event.text == Key.Return) && root.mention-candidates.length > 0 {
                                                root.pick-mention(0);
                                                // The name ends the draft: on after it.
                                                self.set-selection-offsets(2147483647, 2147483647);
                                                return accept;
                                            }
                                            if event.text == Key.Return && !event.modifiers.shift {
                                                if root.can-send { root.send(root.draft); }
                                                return accept;
                                            }
                                            if event.modifiers.control && (event.text == "v" || event.text == "V") {
                                                root.paste();
                                                return accept;
                                            }
                                            if event.text == Key.UpArrow && root.draft == "" {
                                                root.edit-last();
                                                // Ready to add to the end, as when typing it.
                                                self.set-selection-offsets(2147483647, 2147483647);
                                                return accept;
                                            }
                                            // ↓ on the last line goes to the end, ↑ on the first to the
                                            // start, as in editors (the input alone stays put); with
                                            // Shift, selecting up to there. `measure` is as tall as the
                                            // draft's lines.
                                            if event.text == Key.DownArrow && !event.modifiers.control && !event.modifiers.alt
                                                && self.caret-y + 1.5 * composer-row.line > measure.preferred-height {
                                                self.set-selection-offsets(event.modifiers.shift ? self.anchor-position-byte-offset : 2147483647, 2147483647);
                                                return accept;
                                            }
                                            if event.text == Key.UpArrow && !event.modifiers.control && !event.modifiers.alt
                                                && self.caret-y < 0.5 * composer-row.line {
                                                self.set-selection-offsets(event.modifiers.shift ? self.anchor-position-byte-offset : 0, 0);
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            padding-bottom: composer-row.last-line-padding(send-button.height);
                            send-button := SendButton {
                                saving: root.editing;
                                enabled: root.can-send;
                                clicked => { root.send(root.draft); composer.focus(); }
                            }
                        }
                    }
                    // Over the composer while messages are picked: what to do with them.
                    selection-bar := Rectangle {
                        opacity: root.selected-count > 0 ? 1 : 0;
                        visible: self.opacity > 0;
                        animate opacity { duration: 120ms * Motion.scale; easing: ease-out; }
                        background: Palette.alternate-background;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 8px;
                            spacing: 4px;
                            Text {
                                text: root.selected-count == 1 ? "1 message selected" : root.selected-count + " messages selected";
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                font-weight: 600;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    label: "Copy selected";
                                    icon: @image-url("@lucide/copy.svg");
                                    clicked => {
                                        root.copy-text(root.selection-text);
                                        root.clear-selection();
                                    }
                                }
                            }
                            if root.can-forward-selection: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    label: "Forward selected";
                                    icon: @image-url("@lucide/forward.svg");
                                    clicked => { root.forward-selection(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                delete-menu := ContextMenuArea {
                                    width: 32px;
                                    height: 32px;
                                    Menu {
                                        MenuItem {
                                            title: "Delete for me";
                                            activated => { root.delete-selection(false); }
                                        }
                                        if root.can-delete-selection-for-everyone: MenuItem {
                                            title: "Delete for everyone";
                                            activated => { root.delete-selection(true); }
                                        }
                                    }
                                    IconButton {
                                        label: "Delete selected";
                                        icon: @image-url("@lucide/trash.svg");
                                        clicked => { delete-menu.show({ x: 0px, y: self.height }); }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    label: "Clear selection";
                                    icon: @image-url("@lucide/x.svg");
                                    clicked => { root.clear-selection(); }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }

    // Files dragged from elsewhere onto the open chat are attached.
    if root.screen == Screen.chats && root.selected-id != "" && !root.settings-open: DropArea {
        can-drop(event) => { return DragAction.copy; }
        dropped(event) => {
            root.files-dropped(event);
            return DragAction.copy;
        }
        if self.has-drag: Rectangle {
            background: Palette.background.with-alpha(0.85);
            // Fades in as it appears.
            opacity: 0;
            init => { self.opacity = 1; }
            animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
            border-width: 2px;
            border-color: Palette.accent-background;
            border-radius: 12px;
            Text {
                text: "Drop to attach";
                font-size: 1.3rem;
                font-weight: 600;
                color: Palette.accent-background;
            }
        }
    }

    // Stories, over everything.
    if root.stories-open: Rectangle {
        background: #101418;
        // Fades in as it appears.
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
        TouchArea {}
        HorizontalLayout {
            // Who has stories, and posting one.
            Rectangle {
                width: root.narrow && root.story.shown ? 0px : min(280px, root.width);
                visible: !(root.narrow && root.story.shown);
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        Text {
                            text: "Stories";
                            font-size: 1.3rem;
                            font-weight: 700;
                            color: white;
                            horizontal-stretch: 1;
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("@lucide/x.svg");
                                label: "Close stories";
                                tint: white;
                                clicked => {
                                    root.close-story();
                                    root.stories-open = false;
                                }
                            }
                        }
                    }
                    if root.story-rings.length == 0: Text {
                        text: "No stories from the last day.";
                        color: #fffa;
                        wrap: word-wrap;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for ring in root.story-rings: Rectangle {
                            height: 56px;
                            border-radius: 8px;
                            background: ring-touch.has-hover ? #ffffff18 : transparent;
                            animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                            ring-touch := TouchArea {
                                mouse-cursor: pointer;
                                accessible-role: button;
                                accessible-label: ring.title + (ring.unviewed ? ", new" : "") + ", " + ring.time;
                                accessible-action-default => { self.clicked(); }
                                clicked => { root.open-story(ring.id); }
                            }
                            HorizontalLayout {
                                padding: 6px;
                                spacing: 10px;
                                // Ringed while there is something new.
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 22px;
                                    border-width: 2px;
                                    border-color: ring.unviewed ? Palette.accent-background.brighter(0.3) : #fff4;
                                    Avatar {
                                        width: 36px;
                                        initials: ring.initials;
                                        tint: ring.color;
                                        picture: ring.avatar;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: ring.title;
                                        color: white;
                                        font-weight: ring.unviewed ? 700 : 400;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: ring.time;
                                        color: #fff9;
                                        font-size: 0.8rem;
                                    }
                                }
                            }
                        }
                    }
                    // Posting, to a group.
                    if root.story-groups.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "New story";
                            color: white;
                            font-weight: 600;
                        }
                        ComboBox {
                            model: root.story-groups;
                            current-index <=> root.story-group;
                        }
                        LineEdit {
                            placeholder-text: "Text";
                            text <=> root.story-text;
                            accepted => { root.post-story-text(); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button {
                                text: "Photo…";
                                clicked => { root.post-story-photo(); }
                            }
                            Button {
                                text: "Post";
                                primary: true;
                                enabled: root.story-text != "";
                                clicked => { root.post-story-text(); }
                            }
                        }
                    }
                }
            }
            // The story shown.
            Rectangle {
                horizontal-stretch: 1;
                if !root.story.shown: Text {
                    text: root.story-rings.length > 0 ? "Pick someone's story." : "";
                    color: #fff8;
                }
                if root.story.shown: VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: root.story.author;
                                color: white;
                                font-weight: 700;
                            }
                            Text {
                                text: root.story.time + " · " + root.story.position;
                                color: #fff9;
                                font-size: 0.8rem;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("@lucide/x.svg");
                                label: "Close story";
                                tint: white;
                                clicked => { root.close-story(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 8px;
                        TouchArea {
                            width: 40px;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Previous story";
                            accessible-action-default => { self.clicked(); }
                            clicked => { root.step-story(-1); }
                            Icon {
                                source: @image-url("@lucide/chevron-left.svg");
                                width: 28px;
                                tint: white;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            if root.story.text-story: Rectangle {
                                width: min(parent.width, parent.height * 9 / 16);
                                height: min(parent.height, parent.width * 16 / 9);
                                border-radius: 12px;
                                background: root.story.background;
                                Text {
                                    width: parent.width - 32px;
                                    text: root.story.text;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    font-size: 1.6rem;
                                    font-weight: 600;
                                    color: root.story.foreground;
                                    accessible-role: text;
                                    accessible-label: self.text;
                                }
                            }
                            if !root.story.text-story: AttachmentView {
                                item: root.story.picture;
                                outgoing: false;
                                fetch(id) => { root.fetch-attachment(id); }
                                open(id) => { root.open-attachment(id); }
                            }
                            // The view stays from one picture story to the next: it fetches only
                            // when made, so the next is asked for here. Not from the change
                            // handler itself: fetching redraws, which mustn't happen while Slint
                            // runs its change handlers.
                            property <string> picture: root.story.text-story ? "" : root.story.picture.id;
                            changed picture => { next-picture.running = true; }
                            next-picture := Timer {
                                interval: 1ms;
                                running: false;
                                triggered => {
                                    self.running = false;
                                    if !root.story.text-story && root.story.picture.fetch {
                                        root.fetch-attachment(root.story.picture.id);
                                    }
                                }
                            }
                        }
                        TouchArea {
                            width: 40px;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: "Next story";
                            accessible-action-default => { self.clicked(); }
                            clicked => { root.step-story(1); }
                            Icon {
                                source: @image-url("@lucide/chevron-right.svg");
                                width: 28px;
                                tint: white;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }
            }
        }
    }

    // Choosing people for a new group, or to add to the open one.
    if root.group-draft-open: Rectangle {
        // Fades in as it opens.
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
        background: #0008;
        TouchArea {
            clicked => { root.close-group-draft(); }
        }
        Rectangle {
            width: min(420px, parent.width - 32px);
            height: min(560px, parent.height - 32px);
            // Grows into place as the dimmed background fades in.
            property <float> grown: 0;
            init => { self.grown = 1; }
            animate grown { duration: 160ms * Motion.scale; easing: ease-out; }
            transform-scale: 0.97 + 0.03 * self.grown;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            border-radius: 12px;
            background: Palette.background;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            TouchArea {}
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.group-draft-new ? "New group" : "Add members";
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                if root.group-draft-new: LineEdit {
                    placeholder-text: "Group name";
                    text <=> root.group-draft-name;
                    init => { self.focus(); }
                    edited => { root.group-draft-edited(); }
                }
                LineEdit {
                    placeholder-text: "Search contacts, or type a phone number";
                    text <=> root.group-draft-filter;
                    edited => { root.group-draft-edited(); }
                }
                if root.group-filter-is-number: Button {
                    text: "Find " + root.group-draft-filter + " on Signal";
                    clicked => { root.find-number(root.group-draft-filter, false); }
                }
                ListView {
                    vertical-stretch: 1;
                    for candidate in root.group-candidates: Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        background: candidate-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                        animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                        candidate-touch := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: checkbox;
                            accessible-label: candidate.title;
                            accessible-checked: candidate.chosen;
                            accessible-action-default => { self.clicked(); }
                            clicked => { root.toggle-candidate(candidate.id); }
                        }
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 10px;
                            Avatar {
                                width: 36px;
                                initials: candidate.initials;
                                tint: candidate.color;
                                picture: candidate.avatar;
                            }
                            Text {
                                text: candidate.title;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                color: Palette.foreground;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    border-radius: 11px;
                                    border-width: 2px;
                                    border-color: candidate.chosen ? Palette.accent-background : Palette.border;
                                    background: candidate.chosen ? Palette.accent-background : transparent;
                                    if candidate.chosen: Text {
                                        text: "✓";
                                        color: white;
                                        font-weight: 700;
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.close-group-draft(); }
                    }
                    Button {
                        text: root.group-draft-new ? "Create" : "Add";
                        primary: true;
                        enabled: root.group-draft-new ? !root.is-blank(root.group-draft-name) : root.group-draft-chosen > 0;
                        clicked => { root.finish-group-draft(); }
                    }
                }
            }
        }
    }

    // Joining a group through its invite link: paste it, see what the group shows of itself,
    // then join or ask to.
    if root.join-open: Rectangle {
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
        background: #0008;
        TouchArea {
            clicked => { root.close-join-group(); }
        }
        Rectangle {
            width: min(440px, parent.width - 32px);
            height: min(join-content.preferred-height, parent.height - 32px);
            clip: true;
            property <float> grown: 0;
            init => { self.grown = 1; }
            animate grown { duration: 160ms * Motion.scale; easing: ease-out; }
            transform-scale: 0.97 + 0.03 * self.grown;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            border-radius: 12px;
            background: Palette.background;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            TouchArea {}
            join-content := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Join a group";
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                HorizontalLayout {
                    spacing: 8px;
                    join-link-field := LineEdit {
                        placeholder-text: "https://signal.group/#…";
                        text <=> root.join-link;
                        enabled: !root.join-busy;
                        init => { self.focus(); }
                        accepted => { root.preview-group-link(self.text); }
                    }
                    Button {
                        text: "Look up";
                        enabled: !root.join-busy && !root.is-blank(root.join-link);
                        clicked => { root.preview-group-link(join-link-field.text); }
                    }
                }
                if root.join-busy: Text {
                    text: "One moment…";
                    font-size: 0.85rem;
                    color: Palette.foreground.with-alpha(0.7);
                }
                if root.join-title != "" && !root.join-busy: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: root.join-title;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    Text {
                        text: root.join-members == 1 ? "1 member" : root.join-members + " members";
                        font-size: 0.85rem;
                        color: Palette.foreground.with-alpha(0.7);
                    }
                    Text {
                        text: root.join-requested ? "You asked to join already. An admin has to let you in."
                            : root.join-approval ? "An admin has to let you in. Asking shows them your name and picture."
                            : "Its members see your name and picture once you join.";
                        wrap: word-wrap;
                        font-size: 0.85rem;
                        color: Palette.foreground.with-alpha(0.7);
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.close-join-group(); }
                    }
                    Button {
                        text: root.join-approval ? "Ask to join" : "Join";
                        primary: true;
                        enabled: root.join-title != "" && !root.join-busy && !root.join-requested;
                        clicked => { root.join-group(); }
                    }
                }
            }
        }
    }

    // Choosing where to forward a message to, over everything else; then confirming it, since
    // it goes out at once.
    if root.forwarding: Rectangle {
        // Fades in as it opens.
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 160ms * Motion.scale; easing: ease-out; }
        background: #0008;
        TouchArea {
            clicked => { root.cancel-forward(); }
        }
        forward-dialog := Rectangle {
            // The chat picked, until confirmed.
            property <string> picked-id;
            property <string> picked-title;
            property <bool> confirming: self.picked-id != "";
            function pick(id: string, title: string) {
                self.picked-id = id;
                self.picked-title = title;
                confirm-keys.focus();
            }
            width: min(420px, parent.width - 32px);
            height: self.confirming ? min(confirm-layout.preferred-height, parent.height - 32px)
                : min(520px, parent.height - 32px);
            animate height { duration: 160ms * Motion.scale; easing: ease-out; }
            clip: true;
            // Grows into place as the dimmed background fades in.
            property <float> grown: 0;
            init => { self.grown = 1; }
            animate grown { duration: 160ms * Motion.scale; easing: ease-out; }
            transform-scale: 0.97 + 0.03 * self.grown;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            border-radius: 12px;
            background: Palette.background;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            // Clicks inside don't close it.
            TouchArea {}
            VerticalLayout {
                visible: !forward-dialog.confirming;
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Forward to…";
                    font-size: 1.1rem;
                    font-weight: 600;
                    color: Palette.foreground;
                }
                forward-search := LineEdit {
                    placeholder-text: "Search";
                    text <=> root.forward-filter;
                    init => { self.focus(); }
                    edited => { root.forward-filter-edited(); }
                    // Enter picks the first chat found.
                    accepted => {
                        if root.forward-targets.length > 0 {
                            forward-dialog.pick(root.forward-targets[0].id, root.forward-targets[0].title);
                        }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for target in root.forward-targets: Rectangle {
                        height: 48px;
                        border-radius: 6px;
                        background: target-touch.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
                        animate background { duration: 120ms * Motion.scale; easing: ease-out; }
                        target-touch := TouchArea {
                            accessible-role: button;
                            accessible-label: "Forward to " + target.title;
                            accessible-action-default => { self.clicked(); }
                            mouse-cursor: pointer;
                            clicked => { forward-dialog.pick(target.id, target.title); }
                        }
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 10px;
                            Avatar {
                                width: 36px;
                                initials: target.initials;
                                tint: target.avatar-color;
                                picture: target.avatar;
                            }
                            Text {
                                text: target.title;
                                vertical-alignment: center;
                                overflow: elide;
                                color: Palette.foreground;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Cancel";
                        clicked => { root.cancel-forward(); }
                    }
                }
            }
            // Enter forwards, as the primary button does.
            confirm-keys := FocusScope {
                enabled: forward-dialog.confirming;
                key-pressed(event) => {
                    if event.text == Key.Return {
                        root.forward-to(forward-dialog.picked-id);
                        return accept;
                    }
                    return reject;
                }
            }
            confirm-layout := VerticalLayout {
                visible: forward-dialog.confirming;
                y: 0;
                height: self.preferred-height;
                alignment: start;
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "Forward to " + forward-dialog.picked-title + "?";
                    font-size: 1.1rem;
                    font-weight: 600;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                // The message, as a quote.
                Rectangle {
                    border-radius: 6px;
                    background: Palette.foreground.with-alpha(0.06);
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: 3px;
                        background: Palette.accent-background;
                    }
                    HorizontalLayout {
                        padding: 10px;
                        padding-left: 13px;
                        Text {
                            text: root.forward-preview;
                            wrap: word-wrap;
                            overflow: elide;
                            max-height: 5 * 1.4rem;
                            color: Palette.foreground.with-alpha(0.8);
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Back";
                        clicked => {
                            forward-dialog.picked-id = "";
                            forward-dialog.picked-title = "";
                            forward-search.focus();
                        }
                    }
                    Button {
                        text: "Forward";
                        primary: true;
                        clicked => { root.forward-to(forward-dialog.picked-id); }
                    }
                }
            }
        }
    }
    }
}
