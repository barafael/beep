import { Motion, Theme } from "theme.slint";
import { DeliveryState, MessageItem } from "types.slint";
import { TextSelection } from "globals.slint";
import { Avatar, Caption, Chip, Icon, IconButton, Popover, Small } from "widgets.slint";
import { AttachmentView } from "attachment.slint";
import { EmojiPicker } from "emoji.slint";

// Quick reactions, as in Signal's own apps: a bar over the bubble, there while the pointer
// rests on the message or on the bar itself; "+" opens every emoji.
// Made only while it shows: it is two dozen items, more than the message under it.
export component ReactionPicker inherits Popover {
    // The pointer came onto it, or left it. Told at once as it comes (the message underneath
    // loses the pointer in the same event, and must not take the bar away meanwhile), so a
    // callback rather than a property watched for changes.
    callback hovered(bool);
    callback picked(string);
    // "+": any other emoji.
    callback more;
    width: layout.preferred-width;
    height: 40px;
    border-radius: self.height / 2;
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.hovered(true);
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.hovered(false);
            }
        }
    }
    layout := HorizontalLayout {
        padding: Theme.space-xs;
        spacing: 2px;
        for emoji in ["❤️", "👍", "👎", "😂", "😮", "😢"]: Rectangle {
            width: Theme.button;
            height: Theme.button;
            border-radius: self.height / 2;
            background: emoji-touch.has-hover ? Theme.pressed : transparent;
            emoji-touch := TouchArea {
                accessible-role: button;
                accessible-label: "React with " + emoji;
                accessible-action-default => { self.clicked(); }
                mouse-cursor: pointer;
                clicked => { root.picked(emoji); }
                // The buttons take the pointer from the bar's own area.
                pointer-event(event) => {
                    if event.kind == PointerEventKind.move {
                        root.hovered(true);
                    }
                }
            }
            Text { text: emoji; font-size: 1rem * Theme.emoji; }
        }
        IconButton {
            icon: @image-url("@lucide/plus.svg");
            label: "More reactions";
            clicked => { root.more(); }
        }
    }
}

// Reply, then the message's menu: beside the bubble on the side facing the middle, shown on
// hover. The menu offers what right-clicking does; `more` says where to open it, in the
// window's coordinates.
component MessageActions inherits HorizontalLayout {
    in property <bool> shown;
    in property <bool> outgoing;
    in property <bool> can-reply;
    callback reply;
    callback more(length, length);
    alignment: center;
    spacing: 2px;
    if root.outgoing: IconButton {
        width: 28px;
        height: 28px;
        icon-size: 16px;
        label: "More";
        icon: @image-url("@lucide/ellipsis.svg");
        shown: root.shown;
        clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
    }
    if root.can-reply: IconButton {
        width: 28px;
        height: 28px;
        icon-size: 16px;
        label: "Reply";
        icon: @image-url("@lucide/reply.svg");
        shown: root.shown;
        clicked => { root.reply(); }
    }
    if !root.outgoing: IconButton {
        width: 28px;
        height: 28px;
        icon-size: 16px;
        label: "More";
        icon: @image-url("@lucide/ellipsis.svg");
        shown: root.shown;
        clicked => { root.more(self.absolute-position.x, self.absolute-position.y + self.height); }
    }
}

export component Bubble inherits Rectangle {
    in property <MessageItem> item;
    in property <length> max-bubble-width;
    // Its row in the list; see `TextSelection`.
    in property <int> index;
    callback fetch-attachment(string);
    callback save-attachment(string);
    callback open-attachment(string);
    callback open-link(string);
    callback reply;
    callback react(string);
    // Sends a message that failed to go out again.
    callback retry;
    callback edit;
    callback delete(bool);
    callback copy-text(string);
    callback reveal;
    callback forward;
    // Picks this message for an action on all picked ones, or unpicks it; `select-through`
    // picks every message from the one last picked.
    callback toggle-select;
    callback select-through;
    // Messages are picked: a click on the row picks this one too, or unpicks it.
    in property <bool> selecting;
    // Ctrl is held: a click on the row picks this message.
    in property <bool> pick-held;

    // Outgoing bubbles use the accent colour: white text reads on any style's accent.
    property <color> ink: item.outgoing ? Theme.bubble-outgoing-text : Theme.bubble-incoming-text;
    property <color> faint: root.ink.with-alpha(Theme.secondary);
    // The row is tinted while the message is picked.
    background: item.selected ? Theme.selected : transparent;
    animate background { duration: Motion.fast; easing: ease-out; }

    // A message that just arrived or was just sent fades in; others, e.g. when a chat opens
    // or is scrolled, are simply there. (Only a fade: moving or scaling the row upsets how
    // the list measures it, and a newly opened chat no longer ends at its newest message.)
    property <float> arrived: item.fresh ? 0 : 1;
    animate arrived { duration: Motion.normal; easing: ease-out; }
    opacity: self.arrived;
    // A search result jumped to lights up, then settles into its highlight, so the eye finds
    // it. (Jumping draws its row anew; one already in view just gets the highlight.) Only that
    // row animates: every row starting a 900ms animation would redraw the list all the while.
    property <bool> flashing;
    property <float> flash: 1;
    // Reactions it had when drawn: only ones that come later fade in. (Very many until then,
    // so none of those it is drawn with does, whichever is set up first.)
    property <int> reactions-at-start: 1000000;
    init => {
        if item.fresh {
            self.arrived = 1;
        }
        if item.highlighted {
            self.flashing = true;
            self.flash = 0;
        }
        self.reactions-at-start = item.reactions.length;
    }
    animate flash { duration: Motion.flash; easing: ease-out; }

    // The pointer is on the message, or on the reaction bar over it (which reaches past the
    // row, and takes the pointer off `hover`; the bar is in a conditional, so it reports).
    property <bool> picker-hovered;
    property <bool> hovered: hover.has-hover || root.picker-hovered;
    property <bool> can-react: !item.deleted && !item.notice && !root.selecting;
    // The reaction bar comes once the pointer has rested on the message a moment (not while
    // it merely crosses the list), and goes when the pointer leaves it and the bar.
    property <bool> picker-shown;
    changed hovered => {
        if !self.hovered {
            self.picker-shown = false;
        }
    }
    // Gone, it can't say the pointer left it.
    changed picker-shown => {
        if !self.picker-shown {
            self.picker-hovered = false;
        }
    }
    Timer {
        interval: 350ms;
        running: root.hovered && root.can-react && !root.picker-shown;
        triggered => { root.picker-shown = true; }
    }

    // What a screen reader says after the text: who, when, how far it got.
    property <string> described: (item.outgoing ? "You" : item.sender) + ", " + item.time
        + (item.edited ? ", edited" : "")
        + (item.delivery == DeliveryState.sending ? ", sending"
            : item.delivery == DeliveryState.failed ? ", not sent"
            : item.delivery == DeliveryState.sent ? ", sent"
            : item.delivery == DeliveryState.delivered ? ", delivered"
            : item.delivery == DeliveryState.read ? ", read" : "")
        + (item.reactions.length == 1 ? ", 1 reaction"
            : item.reactions.length > 1 ? ", " + item.reactions.length + " reactions" : "")
        + (item.expires != "" ? ", disappears in " + item.expires : "");


    // Around the content, not under it: it stays hovered over the text and pictures, which
    // take the pointer themselves (links), so the message's button shows there too.
    hover := TouchArea {
        // The time of a message within a run, which shows it only on the run's last.
        if self.has-hover && !item.last && !item.notice && item.time != "": Tooltip {
            text: @markdown("\{item.time}");
        }
        VerticalLayout {
            if item.first-unread: HorizontalLayout {
                padding-left: Theme.space-m;
                padding-right: Theme.space-m;
                padding-top: 10px;
                spacing: Theme.space-s;
                Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Theme.accent.with-alpha(Theme.tertiary); }
                Small {
                    text: "New messages";
                    font-weight: 600;
                    horizontal-stretch: 0;
                    color: Theme.accent;
                }
                Rectangle { height: 1px; y: (parent.height - 1px) / 2; background: Theme.accent.with-alpha(Theme.tertiary); }
            }
            if item.day != "": HorizontalLayout {
                alignment: center;
                padding-top: 14px;
                padding-bottom: 6px;
                Chip {
                    width: day-label.preferred-width + 20px;
                    height: 22px;
                    day-label := Small {
                        text: item.day;
                        font-weight: 600;
                        color: Theme.text-secondary;
                    }
                }
            }

            if item.notice: HorizontalLayout {
                alignment: center;
                padding-left: Theme.space-xl;
                padding-right: Theme.space-xl;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;
                if item.timer-notice: VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("@lucide/timer.svg");
                        width: Theme.icon-small;
                        tint: Theme.text-tertiary;
                    }
                }
                Small {
                    text: item.text;
                    accessible-role: text;
                    accessible-label: item.text;
                    max-width: root.max-bubble-width;
                    wrap: word-wrap;
                    // As for the body below: never wider than the limit, even for one long word.
                    min-width: 0px;
                    horizontal-alignment: center;
                    color: Theme.text-secondary;
                }
            }
            if !item.notice: HorizontalLayout {
                alignment: item.outgoing ? end : start;
                padding-left: Theme.space-m;
                padding-right: Theme.space-m;
                padding-top: item.first ? 6px : 1px;
                padding-bottom: 1px;
                spacing: Theme.space-xs;

                // The sender's picture, at the end of their run.
                if item.avatar-column: VerticalLayout {
                    alignment: end;
                    width: 28px;
                    if item.last: Avatar {
                        width: 28px;
                        initials: item.sender-initials;
                        tint: item.sender-color;
                        picture: item.sender-avatar;
                    }
                }
                if item.outgoing: MessageActions {
                    outgoing: true;
                    shown: root.hovered;
                    can-reply: !item.deleted;
                    reply => { root.reply(); }
                    more(x, y) => { root.show-menu(x, y); }
                }
                VerticalLayout {
                    spacing: 2px;
                    if item.show-sender: Small {
                        text: item.sender;
                        font-weight: 600;
                        color: item.sender-color;
                    }
                    bubble := Rectangle {
                        max-width: root.max-bubble-width;
                        // Within a run, the corners facing the neighbouring bubbles are tighter.
                        border-top-left-radius: !item.outgoing && !item.first ? Theme.bubble-radius-tight : Theme.bubble-radius;
                        border-bottom-left-radius: !item.outgoing && !item.last ? Theme.bubble-radius-tight : Theme.bubble-radius;
                        border-top-right-radius: item.outgoing && !item.first ? Theme.bubble-radius-tight : Theme.bubble-radius;
                        border-bottom-right-radius: item.outgoing && !item.last ? Theme.bubble-radius-tight : Theme.bubble-radius;
                        background: (item.outgoing ? Theme.bubble-outgoing : Theme.bubble-incoming)
                            .mix(Theme.highlight, item.highlighted && root.flashing ? 1 - 0.5 * root.flash : 1)
                            // A whisper lighter under the pointer: just enough to say which row
                            // the button belongs to, not enough to catch the eye as it passes.
                            .mix(Theme.text, root.hovered ? 0.98 : 1);
                        animate background { duration: Motion.normal; easing: ease-out; }
                        // Paler until it went out.
                        opacity: item.delivery == DeliveryState.sending ? Theme.secondary : 1;
                        animate opacity { duration: Motion.slow; easing: ease-out; }
                        border-width: item.highlighted ? 2px : item.outgoing ? 0 : 1px;
                        border-color: item.highlighted ? Theme.accent.brighter(0.4) : Theme.divider;
                        VerticalLayout {
                            padding-left: Theme.space-m;
                            padding-right: Theme.space-m;
                            padding-top: 7px;
                            padding-bottom: 6px;
                            spacing: 2px;
                            if item.quote-author != "" || item.quote-text != "": Rectangle {
                                border-radius: Theme.radius-s;
                                background: root.ink.with-alpha(Theme.fill);
                                HorizontalLayout {
                                    Rectangle {
                                        width: 3px;
                                        border-radius: self.width / 2;
                                        background: item.outgoing ? root.ink : Theme.accent;
                                    }
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 1px;
                                        Small {
                                            text: item.quote-author;
                                            font-weight: 600;
                                            color: root.ink;
                                        }
                                        Text {
                                            text: item.quote-text;
                                            font-size: 1rem * Theme.body-small;
                                            wrap: word-wrap;
                                            overflow: elide;
                                            max-height: 2.6rem;
                                            color: root.faint;
                                        }
                                    }
                                }
                            }
                            if item.preview-url != "": Rectangle {
                                border-radius: Theme.radius-m;
                                background: root.ink.with-alpha(Theme.fill);
                                preview-touch := TouchArea {
                                    accessible-role: button;
                                    accessible-label: "Open link " + item.preview-url;
                                    accessible-action-default => { self.clicked(); }
                                    mouse-cursor: pointer;
                                    clicked => { root.open-link(item.preview-url); }
                                }
                                VerticalLayout {
                                    padding: Theme.space-s;
                                    spacing: 3px;
                                    if item.has-preview-image: AttachmentView {
                                        item: item.preview-image;
                                        outgoing: item.outgoing;
                                        fetch(id) => { root.fetch-attachment(id); }
                                        open(id) => { root.open-link(item.preview-url); }
                                    }
                                    if item.preview-title != "": Text {
                                        text: item.preview-title;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                        color: root.ink;
                                    }
                                    if item.preview-description != "": Text {
                                        text: item.preview-description;
                                        font-size: 1rem * Theme.body-small;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        max-height: 3.6rem;
                                        color: root.faint;
                                    }
                                    Caption {
                                        text: item.preview-site;
                                        color: root.faint;
                                    }
                                }
                            }
                            for attachment in item.attachments: AttachmentView {
                                // A long message's full text replaces the body; it isn't shown itself.
                                visible: !attachment.hidden;
                                height: attachment.hidden ? 0 : self.preferred-height;
                                item: attachment;
                                outgoing: item.outgoing;
                                fetch(id) => { root.fetch-attachment(id); }
                                save(id) => { root.save-attachment(id); }
                                open(id) => { root.open-attachment(id); }
                            }
                            if item.has-body: StyledText {
                                text: item.body;
                                // A long unbreakable word (a URL) must not widen the bubble past
                                // its limit: the list would then measure the row at that width
                                // and give it too little height, so the next rows draw over it.
                                min-width: 0px;
                                // For screen readers (and finding messages in the UI tests).
                                accessible-role: text;
                                accessible-label: item.deleted ? "This message was deleted." : item.text;
                                accessible-description: root.described;
                                default-color: item.deleted ? root.faint : root.ink;
                                link-color: item.outgoing ? root.ink : Theme.accent;
                                // Spoilers are links that reveal them.
                                link-clicked(link) => {
                                    if link == "spoiler:" {
                                        root.reveal();
                                    } else {
                                        root.open-link(link);
                                    }
                                }
                                // Text can be selected and copied; one message's at a time.
                                text-selectable: !item.deleted;
                                selection-background-color: root.ink.with-alpha(Theme.faint);
                                selection-foreground-color: root.ink;
                                property <int> owner: TextSelection.owner;
                                changed owner => {
                                    if self.owner != root.index {
                                        self.clear-selection();
                                    }
                                }
                                changed has-selection => {
                                    if self.has-selection {
                                        TextSelection.owner = root.index;
                                    } else if TextSelection.owner == root.index {
                                        TextSelection.clear();
                                    }
                                }
                                // Ctrl+C or the menu asks the message holding the selection to
                                // copy it; the element itself reaches the clipboard.
                                property <int> copy-request: TextSelection.copy-request;
                                changed copy-request => {
                                    if TextSelection.owner == root.index && self.has-selection {
                                        self.copy();
                                    }
                                }
                            }
                            // Once per run, on its last message; always if it changed, goes away or
                            // failed to go out.
                            if item.last || item.edited || item.expires != "" || item.delivery == DeliveryState.failed: HorizontalLayout {
                                alignment: end;
                                spacing: Theme.space-xs;
                                if item.expires != "": HorizontalLayout {
                                    spacing: 2px;
                                    accessible-role: text;
                                    accessible-label: "Disappears in " + item.expires;
                                    VerticalLayout {
                                        alignment: center;
                                        Icon {
                                            source: @image-url("@lucide/timer.svg");
                                            width: 11px;
                                            tint: root.faint;
                                        }
                                    }
                                    Caption {
                                        text: item.expires;
                                        vertical-alignment: center;
                                        color: root.faint;
                                    }
                                }
                                if item.edited: Caption {
                                    text: "edited";
                                    font-italic: true;
                                    vertical-alignment: center;
                                    color: root.faint;
                                }
                                if item.last: Small {
                                    text: item.time;
                                    vertical-alignment: center;
                                    color: root.faint;
                                }
                                // ✓ sent, ✓✓ delivered; read: ✓✓ cut out of a filled pill, so it
                                // tells from delivered at a glance.
                                if item.last && (item.delivery == DeliveryState.sent || item.delivery == DeliveryState.delivered || item.delivery == DeliveryState.read): VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 18px;
                                        height: 13px;
                                        border-radius: self.height / 2;
                                        background: item.delivery == DeliveryState.read ? root.ink : transparent;
                                        accessible-role: text;
                                        accessible-label: item.delivery == DeliveryState.sent ? "Sent" : item.delivery == DeliveryState.delivered ? "Delivered" : "Read";
                                        Icon {
                                            source: item.delivery == DeliveryState.sent ? @image-url("@lucide/check.svg") : @image-url("@lucide/check-check.svg");
                                            width: 11px;
                                            tint: item.delivery == DeliveryState.read ? Theme.bubble-outgoing : root.faint;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                                if item.last && item.delivery == DeliveryState.sending: Caption {
                                    text: "Sending…";
                                    font-italic: true;
                                    vertical-alignment: center;
                                    color: root.faint;
                                }
                                // On every bubble that failed, not only a run's last.
                                if item.delivery == DeliveryState.failed: Rectangle {
                                    background: Theme.danger;
                                    border-radius: self.height / 2;
                                    opacity: 0;
                                    init => { self.opacity = 1; }
                                    animate opacity { duration: Motion.slow; easing: ease-out; }
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        spacing: Theme.space-xs;
                                        if item.can-send-again: VerticalLayout {
                                            alignment: center;
                                            Icon {
                                                source: @image-url("@lucide/rotate-cw.svg");
                                                width: 11px;
                                                tint: Theme.on-accent;
                                            }
                                        }
                                        Caption {
                                            // Refused by Signal: sending it again won't help.
                                            text: item.can-send-again ? "Not sent · Retry" : "Not sent";
                                            font-weight: 700;
                                            color: Theme.on-accent;
                                        }
                                    }
                                    if item.can-send-again: TouchArea {
                                        accessible-role: button;
                                        accessible-label: "Send again";
                                        accessible-action-default => { self.clicked(); }
                                        mouse-cursor: pointer;
                                        clicked => { root.retry(); }
                                    }
                                }
                            }
                        }
                        if root.picker-shown && root.can-react: ReactionPicker {
                            x: item.outgoing ? parent.width - self.width : 0;
                            // Over the bubble's edge by a little, so the pointer can move up onto it
                            // without ever leaving both.
                            y: 6px - self.height;
                            hovered(on) => { root.picker-hovered = on; }
                            picked(emoji) => {
                                // Gone with the pointer still on it: it won't say it left.
                                root.picker-hovered = false;
                                root.picker-shown = false;
                                root.react(emoji);
                            }
                            more => {
                                root.picker-hovered = false;
                                root.picker-shown = false;
                                reactions.show();
                            }
                        }
                        // Every emoji, to react with any.
                        reactions := PopupWindow {
                            x: item.outgoing ? parent.width - self.width : 0;
                            y: -self.height - Theme.space-xs;
                            width: picker.width;
                            height: picker.height;
                            close-policy: close-on-click-outside;
                            picker := EmojiPicker {
                                picked(emoji) => {
                                    reactions.close();
                                    root.react(emoji);
                                }
                            }
                        }
                        // Picked: a check at the corner facing the middle.
                        if item.selected: Rectangle {
                            x: item.outgoing ? -8px : parent.width - self.width + 8px;
                            y: -6px;
                            width: 20px;
                            height: 20px;
                            border-radius: self.height / 2;
                            background: Theme.accent;
                            border-width: 2px;
                            border-color: Theme.surface;
                            Icon {
                                source: @image-url("@lucide/check.svg");
                                tint: Theme.on-accent;
                                width: 12px;
                                x: 4px;
                                y: 4px;
                            }
                        }
                    }
                    if item.reactions.length > 0: HorizontalLayout {
                        alignment: item.outgoing ? end : start;
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: Theme.space-xs;
                        for reaction[i] in item.reactions: Chip {
                            active: reaction.mine;
                            opacity: i < root.reactions-at-start ? 1 : 0;
                            init => { self.opacity = 1; }
                            animate opacity { duration: Motion.normal; easing: ease-out; }
                            width: chip.preferred-width + 14px;
                            TouchArea {
                                accessible-role: button;
                                accessible-label: reaction.emoji + " " + reaction.count + (reaction.mine ? ", yours" : "");
                                accessible-action-default => { self.clicked(); }
                                mouse-cursor: pointer;
                                clicked => { root.react(reaction.emoji); }
                            }
                            chip := Text {
                                text: reaction.count > 1 ? reaction.emoji + " " + reaction.count : reaction.emoji;
                                font-size: 1rem * Theme.body-small;
                                color: Theme.text;
                            }
                        }
                    }
                }
                if !item.outgoing: MessageActions {
                    outgoing: false;
                    shown: root.hovered;
                    can-reply: !item.deleted;
                    reply => { root.reply(); }
                    more(x, y) => { root.show-menu(x, y); }
                }
            }
        }
    }

    // While messages are picked, or Ctrl is held, a click anywhere on the row picks this
    // message or unpicks it; with Shift, everything from the one last picked.
    if root.selecting || root.pick-held: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if event.modifiers.shift {
                    root.select-through();
                } else {
                    root.toggle-select();
                }
            }
        }
    }

    // Opens the message's menu at this place in the window (the "More" button's corner).
    function show-menu(x: length, y: length) {
        menu.show({ x: x - menu.absolute-position.x, y: y - menu.absolute-position.y });
    }

    // On top: it takes only right clicks.
    menu := ContextMenuArea {
        Menu {
            if !item.notice: MenuItem {
                title: item.selected ? "Unselect" : "Select";
                activated => { root.toggle-select(); }
            }
            if !item.deleted && !item.notice: MenuItem {
                title: "Reply";
                activated => { root.reply(); }
            }
            if !item.deleted && !item.notice: MenuItem {
                title: "React…";
                activated => { root.picker-shown = true; }
            }
            if TextSelection.owner == root.index: MenuItem {
                title: "Copy selection";
                activated => { TextSelection.copy(); }
            }
            if item.text != "": MenuItem {
                title: "Copy text";
                activated => { root.copy-text(item.text); }
            }
            if item.can-forward: MenuItem {
                title: "Forward…";
                activated => { root.forward(); }
            }
            if item.can-edit: MenuItem {
                title: "Edit";
                activated => { root.edit(); }
            }
            if !item.deleted && !item.notice: MenuSeparator {}
            if !item.notice: MenuItem {
                title: "Delete for me";
                activated => { root.delete(false); }
            }
            if item.can-edit: MenuItem {
                title: "Delete for everyone";
                activated => { root.delete(true); }
            }
        }
    }
}
