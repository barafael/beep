# The Linux build environment, for development and for the release builds alike: Debian 12, so
# what is built here runs on Debian 12, Ubuntu 23.04, Fedora 38 and anything newer (glibc
# 2.36, Qt 6.4). The CI and release jobs run install-deps.sh in the same image.
FROM docker.io/library/rust:1-bookworm

COPY install-deps.sh /usr/local/bin/
RUN install-deps.sh

RUN rustup component add clippy rustfmt

ENV QMAKE=/usr/lib/qt6/bin/qmake
