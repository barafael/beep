 fn log() {
+    // SCRATCH PROBE (investigation only): glibc's allocator split next to RssAnon.
+    let m = unsafe { mallinfo2() };
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let field = |key: &str| -> u64 {
+        status
+            .lines()
+            .find(|l| l.starts_with(key))
+            .and_then(|l| l.split_whitespace().nth(1))
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    };
     match private_bytes() {
-        Some(bytes) => tracing::info!("mem: private {:.1} MiB", bytes as f64 / MIB),
+        Some(bytes) => tracing::info!(
+            "mem: private {:.1} MiB; malloc arena {:.1} in-use {:.1} free {:.1} mmapped {:.1} (MiB), free-chunks {}, rss-anon-kb {} vm-data-kb {} threads {}",
