+            m.arena as f64 / MIB,
+            m.uordblks as f64 / MIB,
+            m.fordblks as f64 / MIB,
+            m.hblkhd as f64 / MIB,
+            m.ordblks,
+            field("RssAnon:"),
+            field("VmData:"),
+            field("Threads:"),
+        ),
         None => tracing::debug!("mem: unknown on this system"),
     }
 }
